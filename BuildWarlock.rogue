# To run this build file, install Rogue from github.com/brombres/Rogue then cd
# to this folder and type "rogo" at the command line, or "rogo help" for a list
# of supported commands.

$define SDL_BRANCH "release-3.2.x"

$requireRogue "2.34.3"

uses Codec/Zip
uses Utility/CURL
uses Utility/GitRepo
uses Utility/VersionNumber

#$ LIBRARIES(macOS) = sox
#$ LIBRARIES(Linux) = sox

#$ LINK_LIBS            = true
   # Link the following in when compiling this Build.rogue

#$ LIBRARIES(macOS)   = libjpeg
#$ LIBRARIES(macOS)   = libpng
#$ LIBRARIES(macOS)   = zlib(flags:-lz)

#$ LIBRARIES(Linux)   = libjpeg(install:libjpeg-dev)
#$ LIBRARIES(Linux)   = libpng(install:libpng-dev)

#$ LIBRARIES(Windows) = brombres/windowsmedialibs
#$ CC_LINK(macOS)     = -I /System/Libraries/Frameworks -framework Foundation -framework AppKit
#$ CC_LINK(Windows)   = /link /LTCG

uses Graphics
uses Graphics/BitmapIO
uses Utility/GitIgnorePatcher

on_exit( Build=>save_config )

augment Build
  PROPERTIES
    config = JSON.load( config_file ) || @{} : Variant

    shader_name_pairs =
    @[
      ["-vs","-fs"],
      ["vs-","fs-"],
      ["_vs","_fs"],
      ["vs_","fs_"],
      ["-vert","-frag"],
      ["vert-","frag-"],
      ["_vert","_frag"],
      ["vert_","frag_"]
    ]

  METHODS
    method init [insert]
      if (not config//rogue_source_folder) config//rogue_source_folder = ""
      configure_project_id

    method config_file->File
      return File( "Config.json" )

    method save_config
      local config_string = config->JSON( &formatted )

      localize config_file
      if (not config_file.exists or String(config_file) != config_string)
        config_file.save( config_string )
      endIf
endAugment

routine rogo_clean( platform=null:String )
  local list = String[]

  if (String.exists(platform))
    if (platform != "all")
      list.add( Build.resolve_platform( forEach in platform.split(' ') ) )
    endIf
  endIf

  if (list.is_empty)
    verbose_delete( File("Build") )
    list.add( "Android" )
  endIf

  forEach (_platform in list)
    verbose_delete( File( "Build/$"(_platform) ) )
    verbose_delete( output_assets_folder( _platform ) )
    verbose_delete( output_source_folder( _platform ) )
  endForEach
endRoutine

routine verbose_delete( file:File )
  if (file.exists)
    print_cmd "Delete $"(file)
    file.delete
  endIf
endRoutine

routine rogo_assets( platform=null:String )
  platform = Build.resolve_platform( platform )

  rogo_deps( platform )
  compile_assets( platform )
endRoutine

routine output_assets_folder( platform=null:String )->File
  platform = Build.resolve_platform( platform )
  if (platform == "Android") return File( "Platforms/Android/app/src/main/assets/Assets" )
  else                       return File( "Build/$/Assets"(platform) )
endRoutine

routine output_cache_folder( platform=null:String )->File
  platform = Build.resolve_platform( platform )
  return File( "Build/$/Cache"(platform) )
endRoutine

routine output_source_folder( platform=null:String )->File
  platform = Build.resolve_platform( platform )
  if (platform == "Android") return File( "Platforms/Android/app/src/main/cpp/Rogue" )
  else                       return File( "Build/$/Source"(platform) )
endRoutine

routine rogo_shaders( platform=null:String )
  platform = Build.resolve_platform( platform )

  local dest = output_assets_folder(platform)/"Shaders"
  ensure_folder( dest )

  local shaderc : String
  local platform_flags : String
  which (platform)
    case "Android"
      shaderc = "Libraries/bgfx/.build/osx-arm64/bin/shadercRelease"
      platform_flags = "--platform android --profile 300_es -O3"
    case "iOS"
      shaderc = "Libraries/bgfx/.build/osx-arm64/bin/shadercRelease"
      platform_flags = "--platform ios --profile metal -O3"
    case "macOS"
      shaderc = "Libraries/bgfx/.build/osx-arm64/bin/shadercRelease"
      platform_flags = "--platform osx --profile metal -O3"
    others
      println "[SHADERS] No shader build process is defined for platform '$'."(platform)
      return
  endWhich

  local varying_defs = File( "Assets/Shaders/varying.def.sc" )
  if (not varying_defs.exists)
    varying_defs = File( "Libraries/Warlock/Libraries/Shaders/varying.def.sc" )
  endIf

  platform_flags .= appending( "-i Libraries/bgfx/src" )
  platform_flags .= appending( "-i Libraries/Warlock/Libraries/Shaders" )
  platform_flags .= appending( "--varyingdef $"(varying_defs.esc) )

  local vs_cmd = "$ --type vertex"(shaderc).appending( platform_flags )
  local fs_cmd = "$ --type fragment"(shaderc).appending( platform_flags )

  local files = Files( ".", "Libraries/Warlock/Libraries/Shaders/*" )
  files.add( "Assets/Shaders/*" )

  local pairs = organize_shader_pairs( files->String[] )

  local header_shown = false
  forEach (pair in pairs)
    local src_vs = File( pair//vs )
    local src_fs = File( pair//fs )
    local dest_vs = (dest / src_vs.filename).with_extension( ".bin" )
    local dest_fs = (dest / src_fs.filename).with_extension( ".bin" )

    if (src_vs.is_newer_than(dest_vs) or varying_defs.is_newer_than(dest_vs))
      header_shown = banner( "Compiling shaders", &skip=header_shown )
      execute vs_cmd.appending( "-f $ -o $"(src_vs.esc,dest_vs.esc) )
    endIf

    if (src_fs.is_newer_than(dest_fs) or varying_defs.is_newer_than(dest_fs))
      header_shown = banner( "Compiling shaders", &skip=header_shown )
      execute fs_cmd.appending( "-f $ -o $"(src_fs.esc,dest_fs.esc) )
    endIf
  endForEach
endRoutine

routine rogo_update_asset_manifest( platform:String )
  platform = Build.resolve_platform( platform )

  local output_assets_folder = output_assets_folder( platform ).[create_folder].parent

  output_assets_folder.create_folder
  local manifest_file = output_assets_folder/"Assets/AssetManifest.txt"
  if (not manifest_file.exists) manifest_file.save( "Placeholder" )

  local files = Files( output_assets_folder, "Assets/**", &include_folders )
  local manifest = files.relative_filepaths.[insert("Assets"),add("")].join( "\n" )
  if (manifest != String(manifest_file))
    print_cmd "Writing $"(manifest_file)
    manifest_file.save( manifest )
  endIf
endRoutine

routine organize_shader_pairs( filepaths:String[] )->Variant
  local result = @[]

  while (filepaths.count)
    local vs = find_shader( filepaths, 0 )
    if (vs)
      local fs : String
      local vs_lc = vs.to_lowercase
      forEach (pair in Build.shader_name_pairs)
        fs = find_shader( filepaths, vs_lc, pair.first, pair.last )
        if (fs)
          result.add( @{vs,fs} )
          escapeForEach
        endIf
      endForEach
    else
      local fs = find_shader( filepaths, 1 )
      if (fs)
        println "[WARNING] Fragment shader '$' has no corresponding vertex shader - skipping."(fs)
      else
        filepaths.clear
      endIf
    endIf
  endWhile

  return result
endRoutine

routine find_shader( filepaths:String[], pair_index:Int )->String
  forEach (pair in Build.shader_name_pairs)
    local result = filepaths.remove_first( $.contains(pair[pair_index],&ignore_case) )
    if (result) return result
  endForEach
  return null
endRoutine

routine find_shader( filepaths:String[], filepath:String, replace_old:String, replace_new:String )->String
  local look_for = filepath.replacing( replace_old, replace_new )
  if local match = filepaths.remove_first( $.equals(look_for,&ignore_case) )
    return match
  else
    return null
  endIf
endRoutine

routine configure_project_id
  if (not Build.config//project_id)
    Build.config//project_id = @{}

    local xcode_id = Console.input( "Enter Xcode Bundle ID (default com.developer.warlockapp): " )
    if (not String.exists(xcode_id)) xcode_id = "com.developer.warlockapp"
    Build.config//project_id//xcode = xcode_id

    local android_id = Console.input( "Enter Android Package ID (default $): "(xcode_id) )
    if (not String.exists(android_id)) android_id = xcode_id
    Build.config//project_id//android = android_id
  endIf

endRoutine

routine project_id( platform:String )->String
  return Build.config//project_id[platform]
endRoutine

routine rogo_deps( platform:String ) [append]
  # SYNTAX: rogo deps [platform] [update|rebuild|reinstall] [<libs>]*
  # Where <libs> is any combination of: [bgfx bimg bx miniaudio sdl spine stb tess2]
  local args = System.command_line_arguments.cloned

  if (platform) args.remove( platform.to_lowercase )
  else          platform  = Build.resolve_platform( args )

  local rebuild   = args.remove( "rebuild" )
  local update    = args.remove( "update" )
  local reinstall = args.remove( "reinstall" )
  deps( platform, args, &=update, &=rebuild, &=reinstall )
endRoutine

routine deps( platform:String, args:String[], &update, &rebuild, &reinstall )
  if (Files(".","BuildWarlock.rogue").count == 1)
    banner "ERROR: Rogo should not be run directly in the Warlock library folder."
    System.exit 1
  endIf

  update_gitignore

  check_platform_xcode
  check_platform_android
  check_rogue_starter
  #update_platforms( platform, args, &=update, &=rebuild, &=reinstall )

  ensure_folder( File("Assets/Audio") )
  ensure_folder( File("Assets/Data") )
  ensure_folder( File("Assets/Fonts") )

  ensure_folder( output_assets_folder(platform) )
  ensure_folder( output_source_folder(platform) )
  ensure_folder( File("Source") )

  create_default_asset_config

  local libs = @{}
  local select_all = false
  local all_libs = ["bgfx","bimg","bx","miniaudio","sdl","spine","stb","tess2"]
  loop 2
    forEach (lib in all_libs)
      if (select_all or args.contains(lib)) libs[lib] = true
    endForEach
    if (libs.count) escapeLoop

    if (reinstall)
      throw Error( "'reinstall' must specify specific libraries (one or more of [$])."(all_libs.join(' ')) )
    endIf

    select_all = true
  endLoop

  ensure_folder( File("Libraries") )

  -------- Libraries/bx --------
  if (libs//bx)
    local folder = File("Libraries/bx")
    local repo = GitRepo( "https://github.com/bkaradzic/bx.git", folder )

    if (reinstall and repo.exists)
      print_cmd "Reinstall bx"
      print_cmd "Delete $"(repo.folder)
      repo.folder.delete
    endIf

    if (not repo.exists)
      banner "Cloning BX repo"
      repo.clone( &verbose )

    elseIf (update)
      if (repo.has_remote_changes)
        banner "Updating BX repo"
        repo.pull( &verbose )
      endIf
    endIf
  endIf

  -------- Libraries/bimg --------
  if (libs//bimg)
    local folder = File("Libraries/bimg")
    local repo = GitRepo( "https://github.com/bkaradzic/bimg.git", folder )

    if (reinstall and repo.exists)
      print_cmd "Reinstall bimg"
      print_cmd "Delete $"(repo.folder)
      repo.folder.delete
    endIf

    if (not repo.exists)
      banner "Cloning BIMG repo"
      repo.clone( &verbose )

    elseIf (update)
      if (repo.has_remote_changes)
        banner "Updating BIMG repo"
        repo.pull( &verbose )
      endIf
    endIf
  endIf

  -------- Libraries/bgfx --------
  if (libs//bgfx)
    local folder = File("Libraries/bgfx")
    local repo = GitRepo( "https://github.com/bkaradzic/bgfx.git", folder )

    local needs_rebuild = rebuild

    if (reinstall and repo.exists)
      print_cmd "Reinstall bgfx"
      print_cmd "Delete $"(repo.folder)
      repo.folder.delete
    endIf

    if (not repo.exists)
      banner "Cloning BGFX repo"
      repo.clone( &verbose )
      needs_rebuild = true

    elseIf (update)
      if (repo.has_remote_changes)
        banner "Updating BGFX repo"
        repo.pull( &verbose )
        needs_rebuild = true
      endIf
    endIf

    if (platform != System.os)
      if (not rebuild or not .is_bgfx_built(System.os))
        .build_bgfx( System.os, &rebuild=needs_rebuild )
      endIf
    endIf

     .build_bgfx( platform, &rebuild=needs_rebuild )
  endIf

  -------- Libraries/SDL --------
  if (libs//sdl)
    local folder = File("Libraries/SDL")
    local repo = GitRepo( "https://github.com/libsdl-org/SDL.git", folder )

    if (reinstall and repo.exists)
      print_cmd "Reinstall sdl"
      print_cmd "Delete $"(repo.folder)
      repo.folder.delete
    endIf

    if (not repo.exists)
      banner "Cloning SDL repo"
      repo.clone( SDL_BRANCH, &verbose )

    elseIf (update)
      if (repo.branch != SDL_BRANCH) repo.checkout( SDL_BRANCH, &verbose )

      if (repo.has_remote_changes)
        banner "Updating SDL repo"
        repo.pull( &verbose )
      endIf
    endIf

    if (platform == "Android")
      .check_android_sdl_lib( &=update )
    endIf
  endIf

  -------- Libraries/spine --------
  if (libs//spine)
    local folder = File("Libraries/spine-runtimes")
    local repo = GitRepo( "https://github.com/EsotericSoftware/spine-runtimes.git", folder )

    if (reinstall and repo.exists)
      print_cmd "Reinstall spine"
      print_cmd "Delete $"(repo.folder)
      repo.folder.delete
    endIf

    if (not repo.exists)
      banner "Cloning spine repo"
      repo.clone( &verbose )

    elseIf (update)
      if (repo.has_remote_changes)
        banner "Updating spine repo"
        repo.pull( &verbose )
      endIf
    endIf
  endIf

  -------- Libraries/stb --------
  if (libs//stb)
    local folder = File("Libraries/stb")
    local repo = GitRepo( "https://github.com/nothings/stb.git", folder )

    if (reinstall and repo.exists)
      print_cmd "Reinstall stb"
      print_cmd "Delete $"(repo.folder)
      repo.folder.delete
    endIf

    if (not repo.exists)
      banner "Cloning stb repo"
      repo.clone( &verbose )

    elseIf (update)
      if (repo.has_remote_changes)
        banner "Updating stb repo"
        repo.pull( &verbose )
      endIf
    endIf
  endIf

  -------- Libraries/libtess2 --------
  if (libs//tess2)
    local folder = File("Libraries/libtess2")
    local repo = GitRepo( "https://github.com/memononen/libtess2.git", folder )

    if (reinstall and repo.exists)
      print_cmd "Reinstall tess2"
      print_cmd "Delete $"(repo.folder)
      repo.folder.delete
    endIf

    if (not repo.exists)
      banner "Cloning libtess2 repo"
      repo.clone( &verbose )

    elseIf (update)
      if (repo.has_remote_changes)
        banner "Updating libtess2 repo"
        repo.pull( &verbose )
      endIf
    endIf
  endIf

  -------- Libraries/miniaudio --------
  if (libs//miniaudio)
    local folder = File("Libraries/miniaudio")
    local repo = GitRepo( "https://github.com/mackron/miniaudio.git", folder )

    if (reinstall and repo.exists)
      print_cmd "Reinstall miniaudio"
      print_cmd "Delete $"(repo.folder)
      repo.folder.delete
    endIf

    if (not repo.exists)
      banner "Cloning miniaudio repo"
      repo.clone( &verbose )

    elseIf (update)
      if (repo.has_remote_changes)
        banner "Updating miniaudio repo"
        repo.pull( &verbose )
      endIf
    endIf
  endIf

endRoutine

#{
routine .check_android_configuration
  local sdk = System.env//ANDROID_SDK_ROOT
  if (not String.exists(sdk))
    throw Error( "ERROR: Necessary system environment variable ANDROID_SDK_ROOT is undefined. Ensure the Android SDK is installed and add a line such as the following to your shell profile:\n\nexport ANDROID_SDK_ROOT=~/Library/Android/sdk" )
  endIf

  if (not String.exists(System.env//ANDROID_NDK_ROOT))
    local files = File( sdk / "ndk" ).listing

    local latest : String
    if (files.count)
      latest = files.first
      forEach (filepath in files from 1)
        if (VersionNumber(File(filepath).filename) > File(latest).filename)
          latest = filepath
        endIf
      endForEach

      latest .= replacing( System.env//HOME, "~" )
    else
      latest = sdk / "ndk/27.0.12077973"
    endIf

    throw Error( "ERROR: Necessary system environment variable ANDROID_NDK_ROOT is undefined. Ensure the Android NDK is installed and add a line such as the following to your shell profile:\n\nexport ANDROID_NDK_ROOT=$"(latest) )
  endIf
endRoutine
}#

routine .is_bgfx_built( platform:String )->Logical
  local folder : String
  local files = [
    "libbgfxDebug.a", "libbxDebug.a", "libbimgDebug.a", "libbimg_decodeDebug.a",
    "libbgfxRelease.a", "libbxRelease.a", "libbimgRelease.a", "libbimg_decodeRelease.a"
  ]

  if (platform == "Android")
    folder = "Libraries/bgfx/.build/android-arm64/bin"
  elseIf (platform == "iOS")
    folder = "Libraries/bgfx/.build/ios-arm64/bin"
  elseIf (platform == "macOS")
    folder = "Libraries/bgfx/.build/osx-arm64/bin"
    files.add( "shadercDebug" )
    files.add( "shadercRelease" )
  else
    trace
    throw Error( "TODO: determine .is_bgfx_built for $"(platform) )
  endIf

  return .confirm_all_files_present( folder, files )
endRoutine

routine .confirm_all_files_present( folder:String, files:String[] )->Logical
  local existing_files = Files( folder )
  existing_files.add( forEach in files )
  return existing_files.count == files.count
endRoutine

routine .build_bgfx( platform:String, &rebuild )
  local make_folder, make_target : String

  if (platform == "iOS")
    make_folder = "Libraries/bgfx/.build/ios-arm64"
    make_target = "ios-arm64 CFLAGS=-DBGFX_CONFIG_MULTITHREADED=0"
  elseIf (platform == "macOS")
    make_folder = "Libraries/bgfx/.build/osx-arm64"
    make_target = "osx-arm64 CFLAGS=-DBGFX_CONFIG_MULTITHREADED=0"
  elseIf (platform == "Android")
    make_folder = "Libraries/bgfx/.build/android-arm64"
    make_target = "android-arm64 CFLAGS=-DBGFX_CONFIG_MULTITHREADED=0"
  else
    trace
    throw Error( "[INTERNAL] TODO: build BGFX for $."(platform) )
  endIf

  if (not File(make_folder).exists or not .is_bgfx_built(platform)) rebuild = true

  if (rebuild)
    # https://bkaradzic.github.io/bgfx/build.html
    banner "Building BGFX library for $"(platform)

    local base_name = File( make_folder ).filename
    local existing_files = Files( File("."/make_folder).parent, base_name+"*", &include_folders )
    existing_files.add( "projects/*$*"(base_name), &include_folders )

    if (existing_files.count)
      print_cmd( "Delete existing build products" )
      existing_files.delete( &verbose )
    endIf

    if (platform == "Android")
      .configure_bgfx_android  # Android build files need patching
    endIf

    #execute "cd Libraries/bgfx && ../bx/tools/bin/darwin/genie --with-tools --gcc=osx-x64 gmake"
    local cmd = "cd Libraries/bgfx && make $"(make_target)
    if (platform == "iOS")
      cmd = ''export SDKROOT="$(xcrun --sdk iphoneos --show-sdk-path)" && '' + cmd
    endIf

    execute cmd
  endIf

  if (platform == "Android") .sync_bgfx_android_libs
endRoutine

routine .configure_bgfx_android
  local android_makefile = File( "Libraries/bgfx/.build/projects/gmake-android-arm64/bgfx-shared-lib.make" )
  if (android_makefile.exists) return

  execute @|cd Libraries/bgfx && ../bx/tools/bin/darwin/genie --gcc=android-arm64 --with-shared-lib gmake

  print_cmd "Patching BGFX Android makefile '-dynamiclib' -> '-shared'."
  local content = String( android_makefile )
  content .= replacing( " -dynamiclib ", " -shared " )
  android_makefile.save( content )
endRoutine

routine .sync_bgfx_android_libs
  local files = Files( "Libraries/bgfx/.build/android-arm64/bin" )
  files.add( "libbgfxRelease.a" )
  files.add( "libbxRelease.a" )
  files.add( "libbimgRelease.a" )
  files.add( "libbimg_decodeRelease.a" )
  #libbgfx-shared-libRelease.so  ?

  local targets = [ "arm64-v8a" ]
  forEach (target in targets)
    local folder = File( "Platforms/Android/app/src/main/cpp/libs" / target )
    folder.create_folder

    forEach (filepath in files)
      local dest = folder / (File(filepath).filename.before_last( "Release.a" ) + ".a")
      if (File(filepath).is_different_than(dest))
        print_cmd "Copy $\n    -> $"(filepath,dest)
        File( filepath ).copy_to( dest )
      endIf
    endForEach
  endForEach
endRoutine

routine .check_android_sdl_lib( &update )
  local libs_folder = File( "Platforms/Android/app/libs" )
  local files = Files( libs_folder, "SDL3*.aar" )
  if (files.count and not update) return

  local sdl_releases_url = "https://github.com/libsdl-org/SDL/releases/"
  print_cmd "Checking for latest SDL3 release at " + sdl_releases_url

  local html = CURL( sdl_releases_url ).fetch_string

  local latest_url : String
  local latest_version : VersionNumber

  forEach (line in LineReader(html))
    if (line.contains("android.zip"))
      if local url = line.extract_string( "*<a href=?$android.zip*" )
        url += "android.zip"
        if (latest_url)
          if local v = url.extract_string( "*/release-$/*" )
            local version = VersionNumber( v )
            if (version > latest_version)
              latest_url = url
              latest_version = version
            endIf
          endIf
        else
          if local v = url.extract_string( "*/release-$/*" )
            latest_url = url
            latest_version = VersionNumber( v )
          endIf
        endIf

        #<a href="/libsdl-org/SDL/releases/download/release-3.2.26/SDL3-devel-3.2.26-android.zip" rel="nofollow" data-turbo="false" data-view-component="true" class="Truncate">
      endIf
    endIf
  endForEach

  contingent
    necessary (latest_url and latest_version.version.begins_with("3."))

    local zip_url = "https://github.com" + latest_url
    print_cmd "Downloading " + zip_url
    local zip_bytes = CURL( "https://github.com"/latest_url ).fetch_bytes
    necessary (zip_bytes)

    local local_zip_file = File( ".rogo/sdl3-android.zip" )
    local_zip_file.save( zip_bytes )

    local zip = Zip( local_zip_file )
    local aar_list = zip.find( "*.aar" )
    necessary (aar_list.count == 1)

    local aar = aar_list.first
    print_cmd "Extracting $/$"(libs_folder,aar.name)
    aar.extract( libs_folder / File(aar.name) )
  unsatisfied
    throw Error(
      "Unable to automatically download the latest SDL3 library for Android. Visit https://github.com/libsdl-org/SDL/releases/ , download the latest SDL3-devel-3.x.x-android.zip, and copy the contained SDL-3.x.x.aar to $"(libs_folder)
    )
  endContingent
endRoutine

routine update_gitignore
  local patcher = GitIgnorePatcher( File(".gitignore") )

  patcher.add( "Warlock", ["/Assets/Staging","/Libraries"] )
  patcher.add( "Rogo", [".rogo","Local.rogo","BuildLocal.rogue","/Build"] )
  patcher.add( "Mac", ".DS_Store" )
  patcher.add( "Vim", ["*.swo","*.swp","*~"] )
  patcher.add( "Xcode", "xcuserdata" )

  patcher.save( &verbose )
endRoutine

routine update_platforms( platform:String, args:String[], &update, &rebuild, &reinstall )
  #if (platform == "iOS" or platform == "macOS") check_platform_xcode
  #if (platform == "Android") .check_android_deps
endRoutine

routine check_platform_xcode
  local default_files      = Files( "Libraries/Warlock/Platforms/Xcode/**" )
  local overwritable_files = Files( "Libraries/Warlock/Platforms/Xcode" )

  reclassify_file( "MiniAudio/miniaudio.m", default_files, overwritable_files )
  reclassify_file( "Utilities/*",           default_files, overwritable_files )
  reclassify_file( "Warlock/SDL*.m",        default_files, overwritable_files )

  local dest = File( "Platforms/Xcode" )
  dest.create_folder

  local header_shown = false
  forEach (filepath in default_files)
    local relative_filepath = default_files.relative_filepath( filepath )
    local from_file = File( filepath )
    local to_file   = File( "Platforms/Xcode"/relative_filepath )
    header_shown = copy_file( from_file, to_file, "Platforms/Xcode/", &=header_shown, &if_missing )
  endForEach

  forEach (filepath in overwritable_files)
    local relative_filepath = overwritable_files.relative_filepath( filepath )
    local from_file = File( filepath )
    local to_file   = File( "Platforms/Xcode"/relative_filepath )
    header_shown = copy_file( from_file, to_file, "Platforms/Xcode/", &=header_shown )
  endForEach

  if (header_shown) println

  if (System.is_macos)
    if (not File("Platforms/Xcode/Pods").exists)
      execute "cd Platforms/Xcode && pod install"
    endIf
  endIf
endRoutine

routine check_platform_android
  local default_files      = Files( "Libraries/Warlock/Platforms/Android/**" )
  local overwritable_files = Files( "Libraries/Warlock/Platforms/Android" )

  reclassify_file( "app/src/main/cpp/**", default_files, overwritable_files )
  reclassify_file( "app/src/main/java/com/developer/warlockapp/JSONData.java", default_files, overwritable_files )
  reclassify_file( "app/src/main/java/com/developer/warlockapp/Message*.java", default_files, overwritable_files )
  reclassify_file( "gradle**",             default_files, overwritable_files )

  local dest = File( "Platforms/Android" )
  dest.create_folder

  local header_shown = false
  forEach (filepath in default_files)
    local relative_filepath = default_files.relative_filepath( filepath )
    local from_file = File( filepath )
    local to_file   = File( "Platforms/Android"/relative_filepath )
    header_shown = copy_file( from_file, to_file, "Platforms/Android/", &=header_shown, &if_missing )
  endForEach

  forEach (filepath in overwritable_files)
    local relative_filepath = overwritable_files.relative_filepath( filepath )
    local from_file = File( filepath )
    local to_file   = File( "Platforms/Android"/relative_filepath )
    header_shown = copy_file( from_file, to_file, "Platforms/Android/", &=header_shown )
  endForEach

  if (header_shown) println
endRoutine

routine check_rogue_starter
  local from_file = File( "Libraries/Warlock/Source/Main.rogue" )
  local to_file   = File( "Source/Main.rogue" )

  if (to_file.exists) return

  local header_shown = copy_file( from_file, to_file, "Source/", &if_missing )
  if (header_shown) println
endRoutine

routine copy_file( from_file:File, to_file:File, base_folder:String, &header_shown, &if_missing )->Logical
  if (if_missing)
    if (to_file.exists) return header_shown
  else
    if (not from_file.is_different_than(to_file)) return header_shown
  endIf

  local replace_project_id = false

  local platform : String
  if (to_file.filepath.contains("Android"))
    platform = "android"
    replace_project_id = true
  elseIf (to_file.filepath.contains("Xcode"))
    platform = "xcode"
    replace_project_id = true
  endIf

  localize project_id( platform )
  local package_path = project_id.replacing( '.', '/' )
  local placeholder_id   = "com.developer.warlockapp"
  local placeholder_path = "com/developer/warlockapp"

  local mesg : String

  if (replace_project_id and to_file->String.contains(placeholder_path))
    local adjusted_file = File( to_file->String.replacing(placeholder_path,package_path) )
    mesg = "  $ -> $"(to_file->String.after_first(base_folder),adjusted_file->String.after_first(base_folder))
    to_file = adjusted_file
  else
    mesg = "  $" (to_file->String.after_first(base_folder))
  endIf

  to_file.parent.create_folder

  local content = String( from_file )
  if (replace_project_id and content.contains(placeholder_id))
    content .= replacing( placeholder_id, project_id )
  endIf

  if (not to_file.exists or String(to_file) != content)
    if (not header_shown)
      header_shown = true
      println "Copying project template Libraries/Warlock/$ -> $"(base_folder,base_folder)
    endIf

    if (mesg) println mesg

    to_file.save( content )
  endIf

  return header_shown
endRoutine

routine reclassify_file( pattern:FilePattern, from_files:Files, to_files:Files )
  forEach (filepath in from_files step -1)
    local relative_filepath = from_files.relative_filepath( filepath )
    if (File(relative_filepath).matches(pattern))
      from_files.remove( filepath )
      to_files.add( relative_filepath )
    endIf
  endForEach
endRoutine

routine create_default_asset_config
  local file = File( "Assets/AssetConfig.asc" )
  if (file.exists) return

  print_cmd( "Create $"(file) )
  local default = "# AssetConfig.asc\n"

  file.save( default )
endRoutine

routine rogo_debug
  rogo_build_debug
  #rogo_run
endRoutine

routine rogo_build( &rebuild )
  build( System.os, &=rebuild )
endRoutine

routine rogo_rebuild
  rogo_build( &rebuild )
endRoutine

routine rogo_android
  # SYNTAX: rogo android [rebuild|release]
  build( "Android" )
  # Skip the Gradle build when invoked from Android Studio's Rogo task (IDE=true);
  # otherwise this would recurse into a second concurrent build.
  if (not String.exists(System.env//IDE))
    execute "cd Platforms/Android && sh gradlew :app:assembleDebug"
  endIf
endRoutine

routine rogo_android_open
  execute @|open -a "Android Studio" Platforms/Android
endRoutine

routine rogo_and
  # SYNTAX: rogo and [rebuild|release]
  rogo_android
endRoutine

routine rogo_and_open
  rogo_android_open
endRoutine

routine rogo_ios
  # SYNTAX: rogo ios [rebuild|release]
  build( "iOS" )
  # Skip xcodebuild when invoked from Xcode's "Compile Rogue" build phase (IDE=true);
  # otherwise this would recurse into a second concurrent build and lock build.db.
  if (not String.exists(System.env//IDE))
    execute @|xcodebuild -workspace Platforms/Xcode/Warlock.xcworkspace -scheme Warlock-iOS build
  endIf
endRoutine

routine rogo_ios_open
  open_xcode( "Platforms/Xcode" )
endRoutine

routine rogo_macos
  # SYNTAX: rogo macos [rebuild|release]
  build( "macOS" )
  # Skip xcodebuild when invoked from Xcode's "Compile Rogue" build phase (IDE=true);
  # otherwise this would recurse into a second concurrent build and lock build.db.
  if (not String.exists(System.env//IDE))
    execute @|xcodebuild -workspace Platforms/Xcode/Warlock.xcworkspace -scheme Warlock-macOS build
  endIf
endRoutine

routine rogo_macos_open
  open_xcode( "Platforms/Xcode" )
endRoutine

routine rogo_build_debug( &rebuild )
  build( System.os, &debug, &=rebuild )
endRoutine

routine build( platform:String, &debug, &rebuild )
  local args = System.command_line_arguments
  if (not debug)   debug = args.contains("debug")
  if (not rebuild) rebuild = args.contains("rebuild")

  deps( platform, System.command_line_arguments )
  compile_rogue( platform, &=debug, &=rebuild )
  compile_assets( platform )
endRoutine

routine compile_rogue( platform:String, &debug, &rebuild )
  local files = Files( ".", "Libraries/Warlock/Libraries/Rogue/**.rogue" )
  files.add( "Source/**.rogue" )

  local output_source_folder = output_source_folder( platform ).[create_folder]

  local is_apple = (platform == "macOS" or platform == "iOS")
  local source_filename = "RogueProgram-$.$"(platform,which{ is_apple:"mm" || "cpp" })

  block rogue_source_folder = Build.config//rogue_source_folder
    if (String.exists(rogue_source_folder))
      local rogue_source = File( rogue_source_folder )
      if (rogue_source.exists)
        System.run( "cd $ && rogo libs"(rogue_source.esc) )

        local stdlib = Files( rogue_source/"Source/Libraries", "**.rogue" )
        if (stdlib.any_newer_than(output_source_folder/source_filename)) rebuild = true
      endIf
    endIf
  endBlock

  if (rebuild or files.any_newer_than(output_source_folder/source_filename))
    block cmd = "roguec Source/Main.rogue"
      local platform_specific = "Source/Platform-$.rogue"(platform)
      if (File(platform_specific).exists)
        cmd .= appending( platform_specific )
      else
        println "Note: if you create $ it will be automatically included with $ builds."(platform_specific,platform)
      endIf
      cmd .= appending( "Warlock" )
      cmd .= appending( "Warlock/Framework/SDL" )
      cmd .= appending( "Warlock/Graphics/BGFX" )

      #cmd .= appending( "Warlock/Platform/$.rogue"(platform) )
      if (debug) cmd .= appending( "--debug" )

      local libs = String[]
      libs.add( "Libraries/Warlock/Libraries/Rogue" )
      cmd .= appending( "--libraries=$"(libs.join(',')) )

      local targets = String[]
      targets.add( "C++,Warlock,$"(platform) )
      if (is_apple) targets.add( "ObjC" )
      targets.add( "SDL" )
      targets.add( "bgfx" )
      cmd .= appending( "--target=$"(targets.join(',')) )
      cmd .= appending( "--gc=manual" )
      cmd .= appending( "--output=$/RogueProgram-$"(output_source_folder.esc,platform) )
      execute cmd
    endBlock
  endIf
endRoutine

routine compile_assets( platform:String )
  contingent
    local path = "Libraries/Warlock/Libraries/Rogue/AssetCompiler"
    necessary (0 == System.run("(cd $ && rogo build)"(path)))
    necessary (0 == System.run("$/Build/AssetCompiler-$ $" (path,System.os,platform)))
  unsatisfied
    System.exit 1
  endContingent

  rogo_shaders( platform )
  rogo_update_asset_manifest( platform )
endRoutine

routine open_xcode( folder:String )
  local listing = File( folder ).listing( "*.xcworkspace" )
  if (listing.is_empty) listing = File( folder ).listing( "*.xcodeproj" )
  if (listing.count)
    execute ''open "$"'' (forEach in listing)
  else
    throw Error( "No .xcodeproj or .xcworkspace folders found." )
  endIf
endRoutine

routine rogo_xcode_deep_clean
  println "🧹 Removing DerivedData..."
  execute "rm -rf ~/Library/Developer/Xcode/DerivedData"

  println "🧹 Cleaning Pods..."
  execute "cd Platforms/Xcode && pod deintegrate && pod install"

  println "🧹 Cleaning Xcode build folder..."
  execute "cd Platforms/Xcode && xcodebuild clean -workspace Warlock.xcworkspace -scheme Warlock-iOS -configuration Debug"
  execute "cd Platforms/Xcode && xcodebuild clean -workspace Warlock.xcworkspace -scheme Warlock-macOS -configuration Debug"

  println "✅ Environment reset complete. 'rogo macos/ios open' and rebuild."
endRoutine
