library Warlock

class Vertex( position:XYZ, color:Color, uv=XY(0,0):XY, normal=XYZ(0,0,1):XYZ ) [compound]
  METHODS
    method avg( other:Vertex )->Vertex
      return Vertex(
        (position + other.position) / 2,
        (color->XYZW + other.color->XYZW) / 2,
        (uv + other.uv) / 2
      )

endClass
