library Warlock

class Texture
  PROPERTIES
    size       : XY
    uv         : Box      # UV bounds within 'source' (0..1); position is top-left.
    source     : Texture  # if non-null, the original texture this is a subset of.
    filepath   : String
    is_managed : Logical  # Was retained by an AssetLoadingState

  GLOBAL METHODS
    method is_cached( file:File )->Logical
      return AssetManager.textures[file]?

    method create( bitmap:Bitmap, info:TextureInfo )->Texture
      local scale = info.scale_factor
      if (scale > 1) bitmap = bitmap.resized( bitmap.size / scale )
      local texture = Texture().[ set(bitmap,info) ]
      if (texture.size != bitmap.size)
        # Texture size was expanded to power of 2; return a subset texture.
        return Texture( texture, Box(bitmap.size) )
      else
        return texture
      endIf

    method create( info:TextureInfo, texels:Color[], image_size:XY, texture_size=null:XY? )->Texture
      # 'texels' is assumed to already be sized for info.scale_factor (e.g.,
      # ImageDecodeJob applies the scale before filling the buffer); only the
      # logical sizes need to be scaled here.
      local file = File( info.filepath )
      if local cached = AssetManager.textures[file]
        return cached.object
      endIf

      Log.println "Loading " + file
      if (not texture_size) texture_size = image_size
      local size = texture_size.value

      local scale = info.scale_factor
      if (scale > 1)
        image_size /= scale
        size /= scale
      endIf

      info.size = size
      local texture = Texture().[ set(texels,info) ]
      if (size != image_size)
        # Texture size was expanded to power of 2; return a subset texture.
        texture = Texture( texture, Box(image_size) )
      endIf

      AssetManager.textures[file] = WeakReference<<Texture>>( texture )
      texture.filepath = info.filepath

      return texture

    method create( info:TextureInfo )->Texture
      local file = File( info.filepath )
      if local cached = AssetManager.textures[file]
        return cached.object
      endIf

      if (not file.exists)
        println "File not found: " + file
        return Texture()
      endIf

      Log.println "Loading " + file
      local texture = Texture( Bitmap(file), info )
      AssetManager.textures[file] = WeakReference<<Texture>>( texture )
      texture.filepath = info.filepath
      return texture

  METHODS
    method init
      # Internal use.

    method init( existing:Texture, subset=null:Box? )
      # subset: pixel bounds within 'existing', or proportional bounds (0..1) if
      #         position < 1 and size <= 1.
      if local bounds = subset
        if (bounds.position.x < 1 and bounds.position.y < 1 and bounds.size.x <= 1 and bounds.size.y <= 1)
          # Convert proportional bounds into pixel bounds
          subset = bounds * existing.size
        endIf
      else
        subset = Box( existing.size )
      endIf

      source = existing.source
      size = subset.value.size

      local source_size = source.size
      local existing_position = existing.uv.position * source_size
      uv = Box( existing_position + subset.value.position, size ) / source_size

    method polygon_mesh( polygon:XY[], mesh=Mesh():Mesh )->Mesh
      # polygon should contain normalized positions between (0,0) and (1,1).
      if (polygon.is_empty)
        println "[Warlock] Texture.polygon_mesh() tessellation failed - polygon vertex list is empty."
        return null
      endIf

      if (Tessellator.tessellate(polygon))
        local i0 = mesh.indices.count
        local uv1 = uv.position
        local uv_delta = uv.size
        forEach (xy in Tessellator.vertex_positions)
          mesh.add( Vertex(xy, Color.WHITE, xy*uv_delta+uv1) )
        endForEach
        forEach (t in Tessellator.triangle_indices)
          mesh.add( t.a+i0, t.b+i0, t.c+i0 )
        endForEach
      else
        Log.println "[Warlock] Texture.polygon_mesh() tessellation failed"
        Log.println polygon
        return null
      endIf

      return mesh

    method recycle
      if (filepath) AssetManager.textures.remove( filepath )
      on_cleanup

    method split( columns:Int, rows:Int )->Texture[]
      local result = Texture[]( columns * rows )
      local sz = size / XY(columns,rows)
      forEach (j in 0..<rows)
        forEach (i in 0..<columns)
          result.add( subset( Box( XY(i,j)*sz, sz ) ) )
        endForEach
      endForEach
      return result

    method source->Texture
      if (@source) return @source
      return this

    method subset( bounds:Box )->Texture
      # Bounds should be in texel (pixel) coordinates
      return Texture( this, bounds )

    method unload
      on_cleanup

endClass
