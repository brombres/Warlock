library Warlock

class Renderer [singleton]
  PROPERTIES
    is_initialized : Logical
    frame          : Int
    data           = Mesh(6144)
    primitive_type = PrimitiveType.TRIANGLES : PrimitiveType
    first_vertex   : Int
    first_index    : Int
    textures       = Texture[]
    uv2            = Box(0,0,1,1) : Box  # UV bounds of texture stage 1; copied into Vertex.uv2
    render_mode    = RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY : RenderMode

    render_queue   = RendererBatch[]

    display_id     : Int
    swap_index     : Int

    first_untransformed_vertex : Int

  METHODS
    method init
      Framework.configure

    method activate_display_graphics_context( display:Display )
      print_error

    method activate_window_graphics_context( window:Window )
      print_error

    method apply_object_transform
      local vertex_count = data.vertices.count
      if (first_untransformed_vertex == vertex_count) return

      local transform = Display.transform
      local vertices = data.vertices
      local should_update_normals = render_mode.should_update_normals
      local rotation = Display.rotation

      forEach (i in first_untransformed_vertex..<vertex_count)
        # TODO: optimize with native C code and a matrix library utilizing SIMD instructions.
        local v = vertices[i]
        v.position = (transform * v.position)->XYZ
        if (should_update_normals) v.normal = (rotation * v.normal)->XYZ
        vertices[i] = v
      endForEach

      first_untransformed_vertex = vertex_count

    method clear_textures
      if (textures.is_empty) return
      flush
      textures.clear

    method configure_render_target( render_target:RenderTarget )
      print_error

    method configure_render_target_image( image:RenderTargetImage )
      print_error

    method configure_window( window:Window )
      print_error

    method draw( line:Line, color:Color, render_mode=RenderMode.ALPHA_COLOR, thickness=1.0:Real )
      draw( Line<<XYZ>>(line.a,line.b), color, render_mode, thickness )

    method draw( line:Line<<XYZ>>, color:Color, render_mode=RenderMode.ALPHA_COLOR, thickness=1.0:Real )
      if (thickness == 1.0)
        clear_textures
        draw_lines
        local i0 = data.vertices.count - first_vertex
        data.add Vertex( line.a, color )
        data.add Vertex( line.b, color )
        data.add( i0, i0+1 )
      else
        trace "thickness != 1 is not yet supported"
      endIf

    method draw_lines
      primitive_type = PrimitiveType.LINES

    method draw_points
      primitive_type = PrimitiveType.POINTS

    method draw_triangles
      primitive_type = PrimitiveType.TRIANGLES

    method draw( box:Box, color:Color, render_mode=RenderMode.ALPHA_COLOR, subdivisions=XY(0,0):XY )
      clear_textures
      draw_triangles
      if (subdivisions.sum == 0)
        local i0 = data.vertices.count - first_vertex
        local a = box.position
        local b = box.top_right
        local c = box.bottom_right
        local d = box.bottom_left
        data.add Vertex( a, color )
        data.add Vertex( b, color )
        data.add Vertex( c, color )
        data.add Vertex( d, color )
        data.add( i0, i0+1, i0+2 )
        data.add( i0, i0+2, i0+3 )
      else
        .generate_quad(
          Vertex( box.position, color ),
          Vertex( box.top_right, color ),
          Vertex( box.bottom_right, color ),
          Vertex( box.bottom_left, color ),
          subdivisions
        )
      endIf

    method draw( box:Box, colors:Quad<<Color>>,
        render_mode=RenderMode.ALPHA_COLOR, subdivisions=XY(0,0):XY )
      clear_textures
      draw_triangles
      if (subdivisions.sum == 0)
        local i0 = data.vertices.count - first_vertex
        local a = box.position
        local b = box.top_right
        local c = box.bottom_right
        local d = box.bottom_left
        data.add Vertex( a, colors.a )
        data.add Vertex( b, colors.b )
        data.add Vertex( c, colors.c )
        data.add Vertex( d, colors.d )
        data.add( i0, i0+1, i0+2 )
        data.add( i0, i0+2, i0+3 )
      else
        .generate_quad(
          Vertex( box.position, colors.a ),
          Vertex( box.top_right, colors.b ),
          Vertex( box.bottom_right, colors.c ),
          Vertex( box.bottom_left, colors.d ),
          subdivisions
        )
      endIf

    method draw( box:Box, texture:Texture, color:Color,
        render_mode=RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY, subdivisions=XY(0,0):XY, &h_flip, &v_flip )
      # Draws a textured box as an image, where the texture corners are mapped to the
      # display position of the box corners.
      local colors = Quad<<Color>>( color, color, color, color )
      draw( box, texture, colors, render_mode, subdivisions, &=h_flip, &=v_flip )

    method draw( box:Box, texture:Texture, colors:Quad<<Color>>,
        render_mode=RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY, subdivisions=XY(0,0):XY, &h_flip, &v_flip )
      # Draws a textured box as an image, where the texture corners are mapped to the
      # display position of the box corners.
      set_texture( texture )
      draw_triangles

      local uv  = .texture_corners( texture.uv, h_flip, v_flip )
      local uv2 = .texture_corners( this.uv2, h_flip, v_flip )

      if (subdivisions.sum == 0)
        local i0 = data.vertices.count - first_vertex
        local a = box.position
        local b = box.top_right
        local c = box.bottom_right
        local d = box.bottom_left

        data.add Vertex( a, colors.a, uv.a, uv2.a )
        data.add Vertex( b, colors.b, uv.b, uv2.b )
        data.add Vertex( c, colors.c, uv.c, uv2.c )
        data.add Vertex( d, colors.d, uv.d, uv2.d )
        data.add( i0, i0+1, i0+2 )
        data.add( i0, i0+2, i0+3 )
      else
        .generate_quad(
          Vertex( box.position,     colors.a, uv.a, uv2.a ),
          Vertex( box.top_right,    colors.b, uv.b, uv2.b ),
          Vertex( box.bottom_right, colors.c, uv.c, uv2.c ),
          Vertex( box.bottom_left,  colors.d, uv.d, uv2.d ),
          subdivisions
        )
      endIf

    method draw( box:Box, texture_bounds:Box, texture:Texture, color=Color.WHITE:Color,
        render_mode=RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY, subdivisions=XY(0,0):XY, &h_flip, &v_flip )
      draw(
        box, texture_bounds, texture,
        Quad<<Color>>(color,color,color,color),
        render_mode, subdivisions, &=h_flip, &=v_flip
      )

    method draw( box:Box, texture_bounds:Box, texture:Texture, colors:Quad<<Color>>,
        render_mode=RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY, subdivisions=XY(0,0):XY, &h_flip, &v_flip )
      # Draws a textured box as a texture fill, where the specified texture corners (in pixels)
      # are mapped to the display position of the box corners.
      set_texture( texture )
      draw_triangles

      local proportional_bounds = texture_bounds / texture.size
      local uv  = .texture_corners( .subset(texture.uv,proportional_bounds), h_flip, v_flip )
      local uv2 = .texture_corners( .subset(this.uv2,proportional_bounds), h_flip, v_flip )

      if (subdivisions.sum == 0)
        local i0 = data.vertices.count - first_vertex
        local a = box.position
        local b = box.top_right
        local c = box.bottom_right
        local d = box.bottom_left
        data.add Vertex( a, colors.a, uv.a, uv2.a )
        data.add Vertex( b, colors.b, uv.b, uv2.b )
        data.add Vertex( c, colors.c, uv.c, uv2.c )
        data.add Vertex( d, colors.d, uv.d, uv2.d )
        data.add( i0, i0+1, i0+2 )
        data.add( i0, i0+2, i0+3 )
      else
        .generate_quad(
          Vertex( box.position,     colors.a, uv.a, uv2.a ),
          Vertex( box.top_right,    colors.b, uv.b, uv2.b ),
          Vertex( box.bottom_right, colors.c, uv.c, uv2.c ),
          Vertex( box.bottom_left,  colors.d, uv.d, uv2.d ),
          subdivisions
        )
      endIf

    method draw( mesh:Mesh, render_mode=RenderMode.ALPHA_COLOR )
      clear_textures
      draw_triangles
      data.add( mesh, first_vertex )

    method draw( mesh:Mesh, texture:Texture, render_mode=RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY )
      set_texture( texture )
      draw_triangles
      data.add( mesh, first_vertex )

    method draw( quad:Quad, color:Color,
        render_mode=RenderMode.ALPHA_COLOR, subdivisions=XY(0,0):XY )
      draw( quad, Quad<<Color>>(color,color,color,color), render_mode, subdivisions )

    method draw( quad:Quad, colors:Quad<<Color>>,
        render_mode=RenderMode.ALPHA_COLOR, subdivisions=XY(0,0):XY )
      clear_textures
      draw_triangles
      if (subdivisions.sum == 0)
        local i0 = data.vertices.count - first_vertex
        data.add Vertex( quad.a, colors.a )
        data.add Vertex( quad.b, colors.b )
        data.add Vertex( quad.c, colors.c )
        data.add Vertex( quad.d, colors.d )
        data.add( i0, i0+1, i0+2 )
        data.add( i0, i0+2, i0+3 )
      else
        .generate_quad(
          Vertex( quad.a, colors.a ),
          Vertex( quad.b, colors.b ),
          Vertex( quad.c, colors.c ),
          Vertex( quad.d, colors.d ),
          subdivisions
        )
      endIf

    method draw( quad:Quad, texture:Texture, color:Color,
        render_mode=RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY, subdivisions=XY(0,0):XY, &h_flip, &v_flip )
      local colors = Quad<<Color>>( color, color, color, color )
      draw( quad, texture, colors, render_mode, subdivisions, &=h_flip, &=v_flip )

    method draw( quad:Quad, texture:Texture, colors:Quad<<Color>>,
        render_mode=RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY, subdivisions=XY(0,0):XY, &h_flip, &v_flip )
      set_texture( texture )
      draw_triangles

      local uv  = .texture_corners( texture.uv, h_flip, v_flip )
      local uv2 = .texture_corners( this.uv2, h_flip, v_flip )

      if (subdivisions.sum == 0)
        local i0 = data.vertices.count - first_vertex
        data.add Vertex( quad.a, colors.a, uv.a, uv2.a )
        data.add Vertex( quad.b, colors.b, uv.b, uv2.b )
        data.add Vertex( quad.c, colors.c, uv.c, uv2.c )
        data.add Vertex( quad.d, colors.d, uv.d, uv2.d )
        data.add( i0, i0+1, i0+2 )
        data.add( i0, i0+2, i0+3 )
      else
        .generate_quad(
          Vertex( quad.a, colors.a, uv.a, uv2.a ),
          Vertex( quad.b, colors.b, uv.b, uv2.b ),
          Vertex( quad.c, colors.c, uv.c, uv2.c ),
          Vertex( quad.d, colors.d, uv.d, uv2.d ),
          subdivisions
        )
      endIf

    method .subset( uv:Box, proportional_bounds:Box )->Box
      # Returns the portion of UV bounds 'uv' covered by 'proportional_bounds' (0..1).
      return Box( uv.position + proportional_bounds.position*uv.size, proportional_bounds.size*uv.size )

    method .texture_corners( uv:Box, h_flip:Logical, v_flip:Logical )->Quad
      # Returns tl/tr/br/bl texture coordinates for 'uv', flipped as specified.
      local a = uv.top_left
      local b = uv.top_right
      local c = uv.bottom_right
      local d = uv.bottom_left

      if (h_flip)
        swapValues( a, b )
        swapValues( c, d )
      endIf

      if (v_flip)
        swapValues( a, d )
        swapValues( b, c )
      endIf

      return Quad( a, b, c, d )

    method .generate_quad( tl:Vertex, tr:Vertex, br:Vertex, bl:Vertex, subdivisions:XY )
      if (subdivisions.x > 0)
        local tc = tl.average(tr)
        local bc = bl.average(br)
        .generate_quad( tl, tc, bc, bl, subdivisions-XY(1,0) )
        .generate_quad( tc, tr, br, bc, subdivisions-XY(1,0) )

      elseIf (subdivisions.y > 0)
        local cl = tl.average(bl)
        local cr = tr.average(br)
        .generate_quad( tl, tr, cr, cl, subdivisions-XY(0,1) )
        .generate_quad( cl, cr, br, bl, subdivisions-XY(0,1) )

      else
        local i0 = data.vertices.count - first_vertex
        data.add tl
        data.add tr
        data.add br
        data.add bl
        data.add( i0, i0+1, i0+2 )
        data.add( i0, i0+2, i0+3 )

      endIf

    method draw( triangle:Triangle, color:Color, render_mode=RenderMode.ALPHA_COLOR )
      clear_textures
      draw_triangles
      local i0 = data.vertices.count - first_vertex
      data.add Vertex( triangle.a, color )
      data.add Vertex( triangle.b, color )
      data.add Vertex( triangle.c, color )
      data.add( i0, i0+1, i0+2 )

    method draw( triangle:Triangle, texture:Texture, color:Color, render_mode=RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY )
      set_texture( texture )
      draw_triangles
      local i0 = data.vertices.count - first_vertex
      data.add Vertex( triangle.a, color, texture.uv.top_left,     uv2.top_left )
      data.add Vertex( triangle.b, color, texture.uv.top_right,    uv2.top_right )
      data.add Vertex( triangle.c, color, texture.uv.bottom_right, uv2.bottom_right )
      data.add( i0, i0+1, i0+2 )

    method flush
      local index_count = data.indices.count
      if (index_count == first_index) return

      apply_object_transform

      local vertex_count = data.vertices.count

      local batch_texture  : Texture
      local batch_textures : Texture[]

      which (textures.count)
        case 0: noAction
        case 1: batch_texture = textures[0]
        others: batch_textures = RecyclePool<<Texture[]>>.on_use.[ add(textures) ]
      endWhich

      render_queue.add(
        RendererBatch(
          display_id,
          primitive_type,
          first_vertex,
          vertex_count - first_vertex,
          first_index,
          index_count - first_index,
          Display.view_projection,
          batch_texture,
          batch_textures,
          Display.clip,
          render_mode
        )
      )

      first_vertex = vertex_count
      first_index  = index_count

    method handle_app_resume( window:Window )
      noAction

    method is_open_gl->Logical
      # Returns 'true' if the active backend has a bottom-left texture origin
      # (OpenGL / OpenGL ES / WebGL). Renderer-specific subclasses override
      # this (e.g. BGFX.rogue queries bgfx::getCaps()->originBottomLeft).
      return $target("Android") or $target("Web")

    method on_begin_render( render_target:RenderTarget )
      display_id = render_target.id
      draw_triangles
      render_mode = RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY
      clear_textures

    method on_begin_render( window:Window )
      ++swap_index
      if (swap_index > 2) swap_index = 0
      reset
      display_id = window.id

    method on_end_render( render_target:RenderTarget )
      flush

    method on_end_render( window:Window )
      flush
      ++frame

    method on_window_resized( window:Window )
      noAction

    method print_error
      println "No Renderer is configured. Include BGFX to use the BGFX renderer."

    method reset
      data.clear
      draw_triangles
      first_vertex = 0
      first_index = 0
      first_untransformed_vertex = 0
      clear_textures
      render_mode = RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY

    method set_clip( clip:Box? )
      print_error

    method set_display_id( new_display_id:Int )
      if (display_id == new_display_id) return
      flush
      @display_id = new_display_id

    method set_primitive_type( new_type:PrimitiveType )
      if (primitive_type == new_type) return
      flush
      @primitive_type = new_type

    method set_render_mode( new_render_mode:RenderMode )
      if (render_mode is new_render_mode) return
      flush
      @render_mode = new_render_mode

    method set_texture( new_texture:Texture )
      if (new_texture.source) new_texture .= source
      if (textures.count == 1 and textures[0] is new_texture) return
      flush
      textures.expand_to_include( 0 )
      textures[0] = new_texture

    method set_texture( stage:Int, new_texture:Texture )
      if (stage == 1) uv2 = new_texture.uv  # before resolving to .source
      if (new_texture.source) new_texture .= source
      if (textures.count > stage and textures[stage] is new_texture) return
      flush
      textures.expand_to_include( stage )
      textures[stage] = new_texture

    method update_display_order( window:Window )
      noAction

    method uses_homogeneous_depth->Logical
      return true

endClass
