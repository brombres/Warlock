uses Graphics

augment Graphics::Bitmap
  METHODS
    method resize_to( other:Bitmap ) [replace]
      local was_premultiplied = is_premultiplied_alpha
      if (not is_premultiplied_alpha) premultiply_alpha

      other.is_premultiplied_alpha = true

      native
      @|Warlock_resize_image(
       |  $this->pixels->as_bytes,
       |  (int)$this->width, (int)$this->height,
       |  $other->pixels->as_bytes,
       |  (int)$other->width, (int)$other->height
       |);

      if (not was_premultiplied)
        # Preserve the contract of Graphics::Bitmap.resize_to(): a straight-alpha
        # source yields a straight-alpha result. Leaving 'other' premultiplied
        # while callers (e.g. Texture.set) premultiply again darkens translucency.
        unmultiply_alpha
        other.unmultiply_alpha
      endIf

endAugment
