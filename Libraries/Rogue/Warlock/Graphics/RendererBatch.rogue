library Warlock

class RendererBatch(
  display_id:Int,
  primitive_type:PrimitiveType,
  first_vertex:Int,
  vertex_count:Int,
  first_index:Int,
  index_count:Int,
  view_projection:Matrix,
  texture:Texture,   # stage 0 only
  textures:Texture[], # multi-stage texture
  clip:Box?,
  render_mode:RenderMode
) [compound]
endClass
