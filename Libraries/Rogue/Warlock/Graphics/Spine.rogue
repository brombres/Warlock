library Warlock

class SpineSprite : Image
  PROPERTIES
    animation : SpineAnimation

  METHODS
    method init( skeleton_name:String, atlas=null:SpineAtlas )
      init( SpineAnimation(skeleton_name,atlas) )

    method init( definition:SpineDefinition )
      init( SpineAnimation(definition) )

    method init( animation )
      reset_size( XY(1.0,1.0) )

    method .draw_entity [override]
      # Spine doesn't work well with very small scales such as 0.001 so we don't
      # scale down the spine animation directly. Instead we'll scale down the Spine
      # drawing by a factor of 1,000.
      Display.push_transform( Matrix.translate(animation.offset+XY(0.5)) )
      Display.push_transform( Matrix.scale(1.0/1000.0) )
      animation.draw( XY(0,0), color )
      Display.pop_transform
      Display.pop_transform

    method on_update
      animation.update( Display.dt )
endClass

class Spine [essential singleton]
  GLOBAL METHODS
    # The following methods are marked [essential] because they are called directly from C++.
    method data_filepath( name:String )->String [essential]
      if local file = Warlock.find_data_file( name )
        return file.filepath
      else
        println "ERROR reading Spine data: " + name
        return name
      endIf

    method load_atlas_image( name:String )->Image [essential]
      local result = Spine.atlas_images[name]
      if (result) return result

      local img = Image(name)
      Spine.atlas_images[name] = img
      return img

  PROPERTIES
    atlas_images  = [String:Image]
    atlases       = [String:SpineAtlas]
    default_atlas : SpineAtlas
    definitions   = [String:SpineDefinition]

  NATIVE
    nativeHeader
    @|#include <spine/spine.h>
     |
     |// Helpers defined in Spine's nativeCode, forward-declared here so other
     |// Warlock Spine classes can call them regardless of emission order.
     |spine::TextureLoader*  Warlock_spine_texture_loader();
     |spine::RenderCommand*  Warlock_spine_render( spine::Skeleton* skeleton );

    nativeCode
    @|// spine-cpp requires the engine to provide a TextureLoader (atlas page
     |// textures) and a SpineExtension (file I/O + allocation). These replace the
     |// old spine-c _spAtlasPage_createTexture / _spUtil_readFile callbacks.
     |namespace
     |{
     |  class WarlockTextureLoader : public spine::TextureLoader
     |  {
     |  public:
     |    void load( spine::AtlasPage &page, const spine::String &path ) override
     |    {
     |      printf( "Load Spine texture: %s\n", path.buffer() );
     |      RogueWarlockImage* img = (RogueWarlockImage*)
     |        RogueWarlockSpine__load_atlas_image__RogueString( RogueString_create(path.buffer()) );
     |      page.texture = img;
     |      // Don't set page.width/height: that would corrupt the UV coordinates.
     |      // Instead ensure the atlas dimensions are powers of two.
     |    }
     |
     |    void unload( void *texture ) override
     |    {
     |      // The Image is owned/cached by Spine.atlas_images; nothing to do here.
     |    }
     |  };
     |
     |  class WarlockSpineExtension : public spine::DefaultSpineExtension
     |  {
     |  protected:
     |    char* _readFile( const spine::String &path, int *length ) override
     |    {
     |      // Resolve the logical asset name to a real filepath via Warlock, then
     |      // read it with the default (stdio) implementation.
     |      RogueString* resolved =
     |        RogueWarlockSpine__data_filepath__RogueString( RogueString_create(path.buffer()) );
     |      printf( "Loading Spine data: %s\n", path.buffer() );
     |      return spine::DefaultSpineExtension::_readFile(
     |        spine::String((const char*)resolved->data->as_utf8), length );
     |    }
     |  };
     |}
     |
     |spine::TextureLoader* Warlock_spine_texture_loader()
     |{
     |  static WarlockTextureLoader loader;
     |  return &loader;
     |}
     |
     |spine::RenderCommand* Warlock_spine_render( spine::Skeleton* skeleton )
     |{
     |  static spine::SkeletonRenderer* renderer = nullptr;
     |  if ( !renderer ) renderer = new spine::SkeletonRenderer();
     |  return renderer->render( *skeleton );
     |}
     |
     |spine::SpineExtension* spine::getDefaultExtension()
     |{
     |  return new WarlockSpineExtension();
     |}
endClass

class SpineAtlas
  # Multiple skeletons may use the same atlas.
  PROPERTIES
    name  : String
    error : Logical
    #scale : Real

    native "spine::Atlas* atlas;"

  GLOBAL METHODS
    method create( name:String )->SpineAtlas
      if (not name.ends_with(".atlas", &ignore_case)) name += ".atlas"
      if (not Warlock.find_data_file(name) and Warlock.find_data_file(name+".txt"))
        name += ".txt"
      endIf

      if local atlas = Spine.atlases[name]
        return atlas
      endIf

      local atlas = SpineAtlas( name, &new_instance )
      Spine.atlases[name] = atlas
      Spine.default_atlas = atlas  # most recent atlas created becomes default
      return atlas

  METHODS
    method init( name, new_instance:Logical )
      native @|$this->atlas = new spine::Atlas( $name->data->as_utf8, Warlock_spine_texture_loader() );
      if (native("$this->atlas->getPages().size() == 0")->Logical)
        error = true
        println "ERROR loading Spine atlas " + name
      endIf

    method on_cleanup
      native @|if ($this->atlas) delete $this->atlas;
              |$this->atlas = 0;
endClass

class SpineDefinition
  PROPERTIES
    name   : String
    error  : String
    atlas  : SpineAtlas
    size   : XY
    offset : XY
    scale  = 1.0
    animation_names : String[]

    native "spine::SkeletonData*       skeleton_data;"
    native "spine::AnimationStateData* animation_state_definition;"

  GLOBAL METHODS
    method create( skeleton_name:String, atlas=null:SpineAtlas )->SpineDefinition
      if local def = Spine.definitions[skeleton_name]
        return def
      endIf

      local def = SpineDefinition( skeleton_name, atlas, &new_instance )
      Spine.definitions[skeleton_name] = def
      return def

  METHODS
    method init( name, atlas, new_instance:Logical ) [essential]
      if (not atlas)
        atlas = Spine.default_atlas
        if (not atlas)
          error = ''Error creating SpineDefinition("$") - no atlas specified and no default atlas exists. Send a SpineAtlas as the second argument or assign one to 'Spine.default_atlas'.''(name)
          println error
          return
        endIf
      endIf

      if (atlas.error)
        error = "Error loading Spine skeleton: " + name
        println error
        return
      endIf

      local skeleton_name = name
      local is_binary = false
      local is_json = false
      contingent
        local skeleton_name_lc = skeleton_name.to_lowercase
        is_binary = skeleton_name_lc.ends_with(".skel")
        sufficient (is_binary)
        is_json = skeleton_name_lc.ends_with(".json")
        sufficient (is_json)

        if (Warlock.find_data_file(skeleton_name+".skel"))
          is_binary = true
          skeleton_name += ".skel"
        elseIf (Warlock.find_data_file(skeleton_name+".json"))
          is_json = true
          skeleton_name += ".json"
        endIf

        if (Warlock.find_data_file(skeleton_name))
          error = "Spine skeleton data file must end with '.skel' or '.json'."
        else
          error = "Cannot find data file '$.skel' or '$.json'."(skeleton_name,skeleton_name)
        endIf
        println error
        return
      endContingent

      local w, h : Real

      if (is_json)
        native
        @|spine::SkeletonJson json_reader( *($this->atlas->atlas) );
         |$this->skeleton_data = json_reader.readSkeletonDataFile( $skeleton_name->data->as_utf8 );
         |if ($this->skeleton_data)
         |{
         |  $w = $this->skeleton_data->getWidth();
         |  $h = $this->skeleton_data->getHeight();
         |}
         |else
         |{
         |  printf( "[ERROR] Error loading Spine skeleton %s\n", $skeleton_name->data->as_utf8 );
         |  if (!json_reader.getError().isEmpty()) printf( "[ERROR] %s\n", json_reader.getError().buffer() );
         |}
      else
        local bytes = Byte[]( Warlock.find_data_file(skeleton_name).value )
        native
        @|spine::SkeletonBinary binary_reader( *($this->atlas->atlas) );
         |$this->skeleton_data = binary_reader.readSkeletonData(
         |  (const unsigned char*)$bytes->as_utf8,
         |  (int)$bytes->count
         |);
         |if ($this->skeleton_data)
         |{
         |  $w = $this->skeleton_data->getWidth();
         |  $h = $this->skeleton_data->getHeight();
         |}
         |else
         |{
         |  printf( "[ERROR] Error loading Spine skeleton %s\n", $skeleton_name->data->as_utf8 );
         |  if (!binary_reader.getError().isEmpty()) printf( "[ERROR] %s\n", binary_reader.getError().buffer() );
         |}
      endIf

      size = XY(w,h)

      if (native("!$this->skeleton_data")->Logical)
        error = "ERROR loading Spine skeleton " + skeleton_name
        println error

      else
        native @|$this->animation_state_definition = new spine::AnimationStateData( *($this->skeleton_data) );
        set_default_mix_time

      endIf

    method animation->SpineAnimation
      return SpineAnimation( this )

    method animation_names->String[]
      if (@animation_names) return @animation_names

      if (error) return String[]
      native @|spine::SkeletonData* skeleton = $this->skeleton_data;
      local n = native( "(RogueInt32) skeleton->getAnimations().size()" )->Int32
      local result = String[]( n )
      forEach (i in 0..<n)
        result.add( native("RogueString_create(skeleton->getAnimations()[$i]->getName().buffer())")->String )
      endForEach

      @animation_names = result
      return result

    method set_default_mix_time( seconds=0.5:Real )->this
      native @|if ($this->animation_state_definition)
              |{
              |  $this->animation_state_definition->setDefaultMix( (float) $seconds );
              |}
      return this

    method set_mix_times( times:Variant )->this
      # times
      #   @[["from_state","to_state",seconds],[...]]
      native @|if ( !$this->animation_state_definition ) return $this;

      forEach (entry in times)
        local from_state = entry[0]->String
        local to_state   = entry[1]->String
        local seconds    = entry[2]->Real
        if (from_state == "" or to_state == "")
          println "ERROR setting Spine mix time " + entry
          println ''Expected ["from_state","to_state",seconds]''
        else
          native @|$this->animation_state_definition->setMix( spine::String($from_state->data->as_utf8), spine::String($to_state->data->as_utf8), (float)$seconds );
        endIf
      endForEach
      return this

    method set_mix_times( default:Real, times:Variant )->this
      # times
      #   @[["from_state","to_state",seconds],[...]]
      set_default_mix_time( default )
      return set_mix_times( times )

    method on_cleanup
      native @|if ($this->animation_state_definition) delete $this->animation_state_definition;
              |if ($this->skeleton_data) delete $this->skeleton_data;
              |$this->skeleton_data = 0;
              |$this->animation_state_definition = 0;
endClass

enum SpineAnimationEventType [essential]
  COMPLETE
  DISPOSE
  END
  EVENT
  INTERRUPT
  START
endEnum

class SpineAnimationEvent( type:SpineAnimationEventType, state:String, track:Int32, play_id:Int64 ) [compound]
  PROPERTIES
    native "spine::TrackEntry* entry;"
    native "spine::Event*      event;"

  METHODS
    method is_complete->Logical
      return type == SpineAnimationEventType.COMPLETE

    method is_dispose->Logical
      return type == SpineAnimationEventType.DISPOSE

    method is_end->Logical
      return type == SpineAnimationEventType.END

    method is_interrupt->Logical
      return type == SpineAnimationEventType.INTERRUPT

    method is_start->Logical
      return type == SpineAnimationEventType.START

    method is_user_event->Logical
      return type == SpineAnimationEventType.EVENT

    method is_user_event( name:String )->Logical
      if (type != SpineAnimationEventType.EVENT) return false
      local result : Logical
      native @|$result = (0 == strcmp($this.event->getData().getName().buffer(), $name->data->as_utf8));
      return result

    method operator==( other:SpineAnimationEvent )->Logical
      if (type  != other.type)  return false
      if (state != other.state) return false
      if (track != other.track) return false
      return true

    method to->String
      return "$ state:$ track:$ play_id:$" (type,state,track,play_id)

    method user_event_name->String
      local result : String
      native @|$result = RogueString_create( $this.event->getData().getName().buffer() );
      # TODO: implement getters for event->intValue, event->floatValue, event->stringValue
      return result
endClass


class SpineAnimation
  GLOBAL PROPERTIES
    mesh_builder = Mesh()
    animation_lookup = Table<<Int64,WeakReference<<SpineAnimation>>>>()

  GLOBAL METHODS
    method create( skeleton_name:String, atlas=null:SpineAtlas )->SpineAnimation
      return SpineAnimation( SpineDefinition(skeleton_name,atlas) )

    method dispatch( animation_id:Int64, e:SpineAnimationEvent ) [essential]
      local animation_ref = animation_lookup[ animation_id ]
      if (animation_ref) animation_ref.object.handle( e )

  NATIVE
    nativeCode
    @|void SpineAnimation_listener( spine::AnimationState* state, spine::EventType type, spine::TrackEntry* entry, spine::Event* event, void* userData )
     |{
     |   RogueWarlockSpineAnimationEvent rogue_event;
     |   rogue_event.entry = entry;
     |   rogue_event.event = event;
     |   switch (type)
     |   {
     |     case spine::EventType_Complete:
     |       rogue_event.type = RogueWarlockSpineAnimationEventType(0);
     |       break;
     |     case spine::EventType_Dispose:
     |       rogue_event.type = RogueWarlockSpineAnimationEventType(1);
     |       break;
     |     case spine::EventType_End:
     |       rogue_event.type = RogueWarlockSpineAnimationEventType(2);
     |       break;
     |     case spine::EventType_Event:
     |       rogue_event.type = RogueWarlockSpineAnimationEventType(3);
     |       break;
     |     case spine::EventType_Interrupt:
     |       rogue_event.type = RogueWarlockSpineAnimationEventType(4);
     |       break;
     |     case spine::EventType_Start:
     |       rogue_event.type = RogueWarlockSpineAnimationEventType(5);
     |       break;
     |     default:
     |       printf( "SpineAnimation_listener unknown event status: %i\n", type );
     |       return;
     |   }
     |
     |   rogue_event.state = RogueString_create( entry->getAnimation().getName().buffer() );
     |   rogue_event.track = entry->getTrackIndex();
     |   rogue_event.play_id = (RogueInt64)(intptr_t)entry;
     |   RogueWarlockSpineAnimation__dispatch__RogueInt64_WarlockSpineAnimationEvent(
     |     (RogueInt64)(intptr_t)state, rogue_event
     |   );
     |}

  PROPERTIES
    name       : String
    definition : SpineDefinition

    position   : XY
    offset     : XY
    scale      : Real
    h_flip     : Logical
    v_flip     : Logical

    color      = Color.WHITE : Color

    animation_event_handler : Function(SpineAnimationEvent)
    active_states = Table<<Int64,SpineAnimationEvent>>()
    error      : Logical
    native "spine::Skeleton*       skeleton;"
    native "spine::AnimationState* animation_state;"

  METHODS
    method init( definition )
      error = definition.error
      if (not error)
        scale  = definition.scale
        offset = definition.offset
        native @|$this->skeleton = new spine::Skeleton( *($this->definition->skeleton_data) );
                |$this->animation_state = new spine::AnimationState( *($this->definition->animation_state_definition) );
                |$this->animation_state->setListener( SpineAnimation_listener, NULL );
        animation_lookup[ object_id ] = WeakReference<<SpineAnimation>>( this )
      endIf


    method attachment( slot_name:String, attachment_name:String )->SpineAttachment?
      local pointer : Int64
      native @|spine::Attachment* attachment = $this->skeleton->getAttachment(
              |  spine::String($slot_name->data->as_utf8),
              |  spine::String($attachment_name->data->as_utf8)
              |);
              |$pointer = (RogueInt64)(intptr_t)attachment;
      if (pointer) return SpineAttachment( this, slot_name, pointer )
      else         return null

    method clear( track=null:Int32? )
      if (track)
        block track = track.value
          native @|$this->animation_state->clearTrack( $track );
        endBlock
      else
        native @|$this->animation_state->clearTracks();
      endIf

    method animation_names->String[]
      return definition.animation_names

    method draw( @position, tint=Color.WHITE:Color )
      draw( tint )

    method draw( tint=Color.WHITE:Color )
      if (error) return

      # Pose the skeleton, then let spine-cpp's SkeletonRenderer batch it into a
      # linked list of RenderCommands (positions/uvs/colors/indices per texture).
      native @|spine::Skeleton* skeleton = $this->skeleton;
              |skeleton->setPosition( (float)$position.x, (float)$position.y );
              |skeleton->setScaleX( $h_flip ? -(float)$scale : (float)$scale );
              |skeleton->setScaleY( $v_flip ? (float)$scale : -(float)$scale );
              |$this->animation_state->apply( *skeleton );
              |skeleton->updateWorldTransform( spine::Physics_Update );

      local command = native( "(RogueInt64)(intptr_t) Warlock_spine_render( $this->skeleton )" )->Int64

      while (command)
        local num_vertices = native( "((spine::RenderCommand*)(intptr_t)$command)->numVertices" )->Int32
        local num_indices  = native( "((spine::RenderCommand*)(intptr_t)$command)->numIndices" )->Int32
        local blend_mode   = native( "(RogueInt32)((spine::RenderCommand*)(intptr_t)$command)->blendMode" )->Int32

        if (blend_mode == 1)  # spine::BlendMode_Additive
          Renderer.render_mode = RenderMode.ALPHA_TEXTURE_ADD
        else                  # Normal / Multiply / Screen
          Renderer.render_mode = RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY
        endIf

        local img : Image
        native @|$img = (RogueWarlockImage*)(intptr_t) ((spine::RenderCommand*)(intptr_t)$command)->texture;

        if (img)
          img.load
          local texture = img.texture
          if (texture)
            mesh_builder.clear

            forEach (v in 0..<num_vertices)
              local color : Color
              native @|spine::RenderCommand* c = (spine::RenderCommand*)(intptr_t)$command;
                      |uint32_t sc = c->colors[ $v ];
                      |RogueInt32 cr = (RogueInt32)((sc >> 24) & 0xFF);
                      |RogueInt32 cg = (RogueInt32)((sc >> 16) & 0xFF);
                      |RogueInt32 cb = (RogueInt32)((sc >>  8) & 0xFF);
                      |RogueInt32 ca = (RogueInt32)( sc        & 0xFF);
                      |$color.argb = (ca<<24) | (cr<<16) | (cg<<8) | cb;
              local pos = XY( native("c->positions[$v*2]")->Real, native("c->positions[$v*2+1]")->Real )
              local uv  = XY( native("c->uvs[$v*2]")->Real, native("c->uvs[$v*2+1]")->Real )
              mesh_builder.add( Vertex(pos, color * this.color * tint, uv) )
            endForEach

            local t = 0
            while (t + 2 < num_indices)
              local i0 = native("(RogueInt32)((spine::RenderCommand*)(intptr_t)$command)->indices[$t]")->Int32
              local i1 = native("(RogueInt32)((spine::RenderCommand*)(intptr_t)$command)->indices[$t+1]")->Int32
              local i2 = native("(RogueInt32)((spine::RenderCommand*)(intptr_t)$command)->indices[$t+2]")->Int32
              mesh_builder.add( i0, i1, i2 )
              t += 3
            endWhile

            mesh_builder.draw( texture, &shader=Renderer.shader )
          endIf
        endIf

        command = native( "(RogueInt64)(intptr_t) ((spine::RenderCommand*)(intptr_t)$command)->next" )->Int64
      endWhile

    method handle( e:SpineAnimationEvent )
      # START: creates new entry that can accept COMPLETE, INTERRUPT, DISPOSE
      # COMPLETE counts as not playing; can accept INTERRUPT or DISPOSE
      if (e.is_start)
        active_states[e.play_id] = e
      elseIf (not e.is_user_event)
        active_states.remove( e.play_id )
      endIf
      on( e )
      if (animation_event_handler) animation_event_handler( e )


    method is_playing( state=null:String )->Logical
      if (state is null) return active_states.count > 0

      forEach (e in active_states)
        if (e.state == state) return true
      endForEach
      return false

    method object_id->Int64 [override]
      local result = native( "(RogueInt64)(intptr_t) $this->animation_state" )->Int64
      return result

    method on( e:SpineAnimationEvent )
      noAction

    method on_event( animation_event_handler )
      noAction

    method on_cleanup
      native @|if ($this->skeleton)        delete $this->skeleton;
              |if ($this->animation_state) delete $this->animation_state;
              |$this->skeleton = 0;
              |$this->animation_state = 0;

    method play( state_name:String, &looping, track=0:Int32, time_scale=1.0:Real )
      if (not animation_names.contains(state_name))
        println "No such animation state $::$" (definition.name,state_name)
        println animation_names
        return
      endIf

      if (error) return

      native...
       @|spine::TrackEntry* track_entry = &$this->animation_state->setAnimation( $track,
        |    spine::String($state_name->data->as_utf8), $looping );
        |if ($time_scale != 1.0)
        |{
        |  if ($time_scale < 0)
        |  {
        |    track_entry->setReverse( true );
        |    $time_scale = -$time_scale;
        |  }
        |  track_entry->setTimeScale((float)$time_scale);
        |}

    method add( state_name:String, &looping, track=0:Int32, delay=0:Real, time_scale=1.0:Real )
      # delay
      #   0 waits for the previous animation to finish.
      #  >0 interrupts the previous animation after that many seconds.
      if (not animation_names.contains(state_name))
        println "No such animation state $::$" (definition.name,state_name)
        println animation_names
        return
      endIf

      if (error) return
      native @|spine::TrackEntry* track_entry = &$this->animation_state->addAnimation( $track,
              |    spine::String($state_name->data->as_utf8), $looping, (float)$delay );
              |if ($time_scale != 1.0)
              |{
              |  if ($time_scale < 0)
              |  {
              |    track_entry->setReverse( true );
              |    $time_scale = -$time_scale;
              |  }
              |  track_entry->setTimeScale((float)$time_scale);
              |}

    method reset( track=null:Int32? )
      if (track)
        block track = track.value
          native @|$this->animation_state->clearTrack( $track );
        endBlock
      else
        native @|$this->animation_state->clearTracks();
      endIf

    method update( dt:Real )
      if (error) return
      native @|$this->animation_state->update( (float)$dt );

endClass

class SpineAttachment( animation:SpineAnimation, slot_name:String ) [compound]
  GLOBAL METHODS
    method create( animation:SpineAnimation, slot_name:String, attachment:Int64 )->SpineAttachment
      local result = SpineAttachment( animation, slot_name )
      native @|$result.attachment = (spine::Attachment*)(intptr_t)$attachment;
      return result

  PROPERTIES
    native "spine::Attachment* attachment;"

  METHODS
    method is_point->Logical
      local result = native( "($this.attachment->getRTTI().isExactly( spine::PointAttachment::rtti ))" )->Logical
      return result

    method operator==( other:SpineAttachment )->Logical
      return native( "0 == memcmp( $this.attachment, $other.attachment, sizeof(spine::Attachment*) )" )->Logical

    method to->SpinePointAttachment
      local result = SpinePointAttachment( animation, slot_name )
      native @|$result.attachment = (spine::PointAttachment*) $this.attachment;
      return result
endClass

class SpinePointAttachment( animation:SpineAnimation, slot_name:String ) [compound]
  PROPERTIES
    native "spine::PointAttachment* attachment;"

  METHODS
    method operator==( other:SpinePointAttachment )->Logical
      return native( "0 == memcmp( $this.attachment, $other.attachment, sizeof(spine::PointAttachment*) )" )->Logical

    method position->XY
      local result : XY
      native @|spine::Slot* slot = $this.animation->skeleton->findSlot( spine::String($slot_name->data->as_utf8) );
              |float x = $this.attachment->getX();
              |float y = $this.attachment->getY();
              |$this.attachment->computeWorldPosition( slot->getBone().getAppliedPose(), x, y );
              |$result.x = x;
              |$result.y = y;
      return result

endClass
