library Warlock

class RenderMode
  GLOBAL PROPERTIES
    # These are initialized in BGFX after shaders have been created.
    ALPHA_COLOR                        : RenderMode
    ALPHA_COLOR_ADD                    : RenderMode
    ALPHA_TEXTURE_COLOR_MULTIPLY       : RenderMode
    ALPHA_TEXTURE_COLOR_ADD            : RenderMode
    ALPHA_TEXTURE_MAX_LOD              : RenderMode
    ALPHA_TEXTURE_ADD                  : RenderMode
    ALPHA_TEXTURE_SCREEN               : RenderMode
    ALPHA_TEXTURE_COLOR_FILL           : RenderMode
    LIT_TEXTURE_COLOR_MULTIPLY         : RenderMode
    LIT_TEXTURE_COLOR_MULTIPLY_WRITE_Z : RenderMode
    LIT_TEXTURE_COLOR_ADD              : RenderMode
    LIT_TEXTURE_COLOR_ADD_WRITE_Z      : RenderMode

  PROPERTIES
    shader            : Shader
    source_blend      = BlendMode.ONE                  : BlendMode
    destination_blend = BlendMode.INVERSE_SOURCE_ALPHA : BlendMode
    culling_mode      = CullingMode.NONE : CullingMode
    depth_test        = DepthTest.DISABLED : DepthTest
    write_z           : Logical
    should_update_normals : Logical

  METHODS
    method init

    method init( existing:RenderMode )
      shader                = existing.shader
      source_blend          = existing.source_blend
      destination_blend     = existing.destination_blend
      culling_mode          = existing.culling_mode
      depth_test            = existing.depth_test
      write_z               = existing.write_z
      should_update_normals = existing.should_update_normals

    method apply
      noAction  # augmented by specialized Renderer, e.g. BGFX augments to call apply_bgfx

    method cloned->ThisType [propagated]
      return ThisType( this )

    method uniforms->ShaderUniforms
      return shader.uniforms
endClass

class RenderModeAlphaColor : RenderMode [singleton]
  PROPERTIES
    shader = Shader.ALPHA_COLOR : Shader

endClass


class RenderModeAlphaColorAdd : RenderMode [singleton]
  PROPERTIES
    shader            = Shader.ALPHA_COLOR : Shader
    source_blend      = BlendMode.ONE      : BlendMode
    destination_blend = BlendMode.ONE      : BlendMode

endClass


class RenderModeAlphaTextureColorMultiply : RenderMode [singleton]
  PROPERTIES
    shader = Shader.ALPHA_TEXTURE_COLOR_MULTIPLY : Shader
endClass

class RenderModeAlphaTextureColorAdd : RenderMode [singleton]
  PROPERTIES
    shader = Shader.ALPHA_TEXTURE_COLOR_ADD : Shader
endClass

class RenderModeAlphaTextureMaxLOD : RenderMode [singleton]
  PROPERTIES
    shader = Shader.ALPHA_TEXTURE_MAX_LOD : Shader
endClass


class RenderModeAlphaTextureAdd : RenderMode [singleton]
  PROPERTIES
    shader            = Shader.ALPHA_TEXTURE_COLOR_MULTIPLY : Shader
    source_blend      = BlendMode.ONE : BlendMode
    destination_blend = BlendMode.ONE : BlendMode
endClass

class RenderModeAlphaTextureScreen : RenderMode [singleton]
  PROPERTIES
    shader            = Shader.ALPHA_TEXTURE_COLOR_MULTIPLY           : Shader
    source_blend      = BlendMode.ONE                  : BlendMode
    destination_blend = BlendMode.INVERSE_SOURCE_COLOR : BlendMode
endClass

class RenderModeAlphaTextureColorFill : RenderMode [singleton]
  PROPERTIES
    shader = Shader.ALPHA_TEXTURE_COLOR_FILL : Shader
endClass


class RenderModeLitTextureColorMultiply : RenderMode [singleton]
  PROPERTIES
    shader                = Shader.LIT_TEXTURE_COLOR_MULTIPLY : Shader
    should_update_normals = true
    culling_mode          = CullingMode.CCW : CullingMode
    depth_test            = DepthTest.LE    : DepthTest
endClass

class RenderModeLitTextureColorMultiplyWriteZ : RenderMode [singleton]
  PROPERTIES
    shader                = Shader.LIT_TEXTURE_COLOR_MULTIPLY : Shader
    should_update_normals = true
    culling_mode          = CullingMode.CCW : CullingMode
    depth_test            = DepthTest.LE    : DepthTest
    write_z               = true
endClass

class RenderModeLitTextureColorAdd : RenderMode [singleton]
  PROPERTIES
    shader                = Shader.LIT_TEXTURE_COLOR_ADD : Shader
    should_update_normals = true
    culling_mode          = CullingMode.CCW : CullingMode
    depth_test            = DepthTest.LE    : DepthTest
endClass

class RenderModeLitTextureColorAddWriteZ : RenderMode [singleton]
  PROPERTIES
    shader                = Shader.LIT_TEXTURE_COLOR_ADD : Shader
    should_update_normals = true
    culling_mode          = CullingMode.CCW : CullingMode
    depth_test            = DepthTest.LE    : DepthTest
    write_z               = true
endClass
