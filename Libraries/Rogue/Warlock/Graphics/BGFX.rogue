library Warlock

nativeHeader @|#include <bgfx/bgfx.h>
nativeHeader @|#include <bgfx/platform.h>

BGFX

class BGFX : Renderer [singleton]
  PROPERTIES
    vertex_data = BGFXVertex[][]
    index_data  = Int32[][]

    native @|bgfx::DynamicVertexBufferHandle bgfx_vertex_buffer;
    native @|bgfx::DynamicIndexBufferHandle  bgfx_index_buffer;
    native @|bgfx::UniformHandle bgfx_uniform_texColor;

    auto_clear_while_resizing : Logical

    previous_native_window_handle : Int64

  METHODS
    method init
      Renderer = this
      prior.init

    method activate_display_graphics_context( display:Display ) [override]
      native
      @|uint16_t w = static_cast<uint16_t>( $display->pixel_size.x );
       |uint16_t h = static_cast<uint16_t>( $display->pixel_size.y );
       |bgfx::setViewRect( $display->id, 0, 0, w, h );
       |bgfx::setViewMode( $display->id, bgfx::ViewMode::Sequential );

    method activate_window_graphics_context( window:Window ) [override]
      activate_display_graphics_context( window )

      native
      @|bgfx::PlatformData pd;
       |#if defined(ROGUE_TARGET_APPLE)
       |  pd.nwh = SDL_Metal_GetLayer( $window->native_metal_view );
       |#else
       |  #error Must implement Native Window Handle retrieval in BGFX.configure_bgfx() for current platform.
       |#endif
       |bgfx::setPlatformData( pd );

    method configure_bgfx( window:Window )
      if (is_initialized) return

      loop (3)
        vertex_data.add( BGFXVertex[](6144) )
        index_data.add( Int32[](6144/2) )
      endLoop

      native
      @|uint16_t w = static_cast<uint16_t>( $window->pixel_size.x );
       |uint16_t h = static_cast<uint16_t>( $window->pixel_size.y );
       |
       |bgfx::Init init;
       |init.type = bgfx::RendererType::Count;
       |init.resolution.width = w;
       |init.resolution.height = h;
       |init.resolution.reset = BGFX_RESET_VSYNC;
       |init.debug = false;
       |
       |bgfx::PlatformData platform_data{};
       |#if defined(ROGUE_TARGET_APPLE)
       |    $window->native_metal_view = SDL_Metal_CreateView( $window->sdl_window );
       |    platform_data.nwh = SDL_Metal_GetLayer( $window->native_metal_view );
       |    $this->previous_native_window_handle = (RogueInt64) platform_data.nwh;
       |#else
       |  #error Must implement Native Window Handle retrieval in BGFX.configure_bgfx() for current platform.
       |#endif
       |init.platformData = platform_data;
       |

      if (not native("bgfx::init(init)")->Logical)
        println "[Warlock] Failed to initialize BGFX."
        return
      endIf

      native
      @|bgfx::VertexLayout vertex_layout;
       |vertex_layout.begin()
       |  .add(bgfx::Attrib::Position,  3, bgfx::AttribType::Float )
       |  .add(bgfx::Attrib::Color0,    4, bgfx::AttribType::Uint8, true)
       |  .add(bgfx::Attrib::TexCoord0, 2, bgfx::AttribType::Float )
       |  .add(bgfx::Attrib::Normal,    3, bgfx::AttribType::Float )
       |.end();
       |
       |$this->bgfx_vertex_buffer = bgfx::createDynamicVertexBuffer( 6144, vertex_layout, BGFX_BUFFER_ALLOW_RESIZE );
       |$this->bgfx_index_buffer  = bgfx::createDynamicIndexBuffer( 6144, BGFX_BUFFER_ALLOW_RESIZE );

      native @|$this->bgfx_uniform_texColor = bgfx::createUniform( "s_texColor", bgfx::UniformType::Sampler );

      Shader.ALPHA_COLOR                  = Shader( "AlphaColor" )
      Shader.ALPHA_TEXTURE_COLOR_MULTIPLY = Shader( "AlphaTextureColorMultiply" )
      Shader.ALPHA_TEXTURE_COLOR_ADD      = Shader( "AlphaTextureColorAdd" )
      Shader.ALPHA_TEXTURE_MAX_LOD        = Shader( "AlphaTextureMaxLOD" )
      Shader.ALPHA_TEXTURE_COLOR_FILL     = Shader( "AlphaTextureColorFill" )
      Shader.LIT_TEXTURE_COLOR_MULTIPLY   = Shader( "LitTextureColorMultiply" )
      Shader.LIT_TEXTURE_COLOR_ADD        = Shader( "LitTextureColorAdd" )

      RenderMode.ALPHA_COLOR              = RenderModeAlphaColor
      RenderMode.ALPHA_COLOR_ADD          = RenderModeAlphaColorAdd
      RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY = RenderModeAlphaTextureColorMultiply
      RenderMode.ALPHA_TEXTURE_COLOR_ADD      = RenderModeAlphaTextureColorAdd
      RenderMode.ALPHA_TEXTURE_MAX_LOD    = RenderModeAlphaTextureMaxLOD
      RenderMode.ALPHA_TEXTURE_ADD        = RenderModeAlphaTextureAdd
      RenderMode.ALPHA_TEXTURE_SCREEN     = RenderModeAlphaTextureScreen
      RenderMode.ALPHA_TEXTURE_COLOR_FILL = RenderModeAlphaTextureColorFill
      RenderMode.LIT_TEXTURE_COLOR_MULTIPLY         = RenderModeLitTextureColorMultiply
      RenderMode.LIT_TEXTURE_COLOR_MULTIPLY_WRITE_Z = RenderModeLitTextureColorMultiplyWriteZ
      RenderMode.LIT_TEXTURE_COLOR_ADD         = RenderModeLitTextureColorAdd
      RenderMode.LIT_TEXTURE_COLOR_ADD_WRITE_Z = RenderModeLitTextureColorAddWriteZ

      is_initialized = true

    method configure_render_target( render_target:RenderTarget )
      local image   = render_target.image
      local texture = image.texture

      native
      @|bgfx::setViewFrameBuffer( $render_target->id, $image->bgfx_frame_buffer );
       |
       |bgfx::setViewRect(
       |  $render_target->id,
       |  0, 0,
       |  static_cast<uint16_t>($texture->size.x),
       |  static_cast<uint16_t>($texture->size.y)
       |);
       |
       |bgfx::setViewClear( $render_target->id, BGFX_CLEAR_COLOR|BGFX_CLEAR_DEPTH, 0xffffffff, 1.0f, 0 );
       |
       |bgfx::touch( $render_target->id );

    method configure_render_target_image( image:RenderTargetImage )
      local color_texture = image.color_texture
      local depth_texture = image.depth_texture

      native
      @|bgfx::TextureHandle textures[2] = { $color_texture->bgfx_texture, $depth_texture->bgfx_texture };
       |$image->bgfx_frame_buffer = bgfx::createFrameBuffer( 2, textures, false );

    method configure_window( window:Window )
      configure_bgfx( window )
      activate_window_graphics_context( window )

      native @|bgfx::touch( $window->id );

    method on_begin_render( render_target:RenderTarget ) [override]
      prior.on_begin_render( render_target )

      if local render_target_image = render_target.image
        native @|bgfx::setViewFrameBuffer( $render_target->id, $render_target_image->bgfx_frame_buffer );
      endIf

      activate_display_graphics_context( render_target )

    method on_begin_render( window:Window )
      prior.on_begin_render( window )
      activate_window_graphics_context( window )

    method on_end_render( render_target:RenderTarget ) [override]
      prior.on_end_render( render_target )
      block
        local clear_flags = 0
        local clear_color = render_target.clear_color.rgba
        native @|$clear_flags |= BGFX_CLEAR_DEPTH | BGFX_CLEAR_COLOR;

        if (not render_target.should_clear_color) clear_color = 0->Int32

        native
        @|bgfx::touch( $display_id );
         |bgfx::setViewClear( $display_id, (uint16_t)$clear_flags, (uint32_t)$clear_color );
      endBlock

    method on_end_render( window:Window ) [override]
      prior.on_end_render( window )

      block
        local clear_flags = 0
        native @|$clear_flags |= BGFX_CLEAR_DEPTH;
        if (Display.should_clear_color or auto_clear_while_resizing)
          if (Display.should_clear_color or render_queue.count) auto_clear_while_resizing = false
          native @|$clear_flags |= BGFX_CLEAR_COLOR;
        endIf

        local clear_color = Display.clear_color.rgba

        native @|bgfx::setViewClear( $display_id, (uint16_t)$clear_flags, (uint32_t)$clear_color );
      endBlock

      if (render_queue.is_empty)
        native @|bgfx::touch( $display_id );
                |bgfx::frame();
        return
      endIf

      local vertex_data = this.vertex_data[swap_index]
      local index_data = this.index_data[swap_index]
      vertex_data.reserve( data.vertices.count )
      index_data.reserve( (data.indices.count+1)/2 )

      native
      @|{
       |  RogueWarlockVertex*      src_data = (RogueWarlockVertex*)($data->vertices->data);
       |  RogueWarlockBGFXVertex* dest_data = (RogueWarlockBGFXVertex*)($vertex_data->data);
       |  for (int i=(int)$data->vertices->count; --i>=0; )
       |  {
       |    dest_data->x  = (float) src_data->position.x;
       |    dest_data->y  = (float) src_data->position.y;
       |    dest_data->z  = (float) src_data->position.z;
       |    dest_data->u  = (float) src_data->uv.x;
       |    dest_data->v  = (float) src_data->uv.y;
       |    dest_data->nx = (float) src_data->normal.x;
       |    dest_data->ny = (float) src_data->normal.y;
       |    dest_data->nz = (float) src_data->normal.z;
       |
       |    // Swap red and blue while premultiplying R,G,B by A.
       |    int argb = (int)src_data->color.argb;
       |    int a = (argb >> 24) & 255;
       |    int r = (((argb >> 16) & 255) * a) / 255;
       |    int g = (((argb >> 8) & 255) * a) / 255;
       |    int b = ((argb & 255) * a) / 255;
       |    dest_data->abgr = (uint32_t)((a << 24) | (b << 16) | (g << 8) | r);
       |    ++src_data;
       |    ++dest_data;
       |  }
       |}
       |
       |bgfx::update(
       |  $this->bgfx_vertex_buffer, 0,
       |  bgfx::makeRef( $vertex_data->data, (uint32_t)($data->vertices->count * sizeof(RogueWarlockBGFXVertex)) )
       |);
       |
       |{
       |  RogueInt*  src_data = $data->indices->as_ints;
       |  uint16_t* dest_data = ((uint16_t*)($index_data->as_ints));
       |  for (int i=(int)$data->indices->count; --i>=0; )
       |  {
       |    *(dest_data++) = (uint16_t) *(src_data++);
       |  }
       |}
       |
       |bgfx::update(
       |  $this->bgfx_index_buffer, 0,
       |  bgfx::makeRef( $index_data->data, (uint32_t)($data->indices->count * sizeof(uint16_t)) )
       |);

      forEach (batch in render_queue)
        set_clip( batch.clip )

        local render_mode = batch.render_mode

        local view_projection = batch.view_projection->Matrix32
        native @|bgfx::setTransform( reinterpret_cast<float*>( &$view_projection ) );

        local shader = render_mode.shader
        #shader.uniforms//u_x = y

        local bgfx_state_flags = 0
        native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_WRITE_RGB | BGFX_STATE_WRITE_A);
        bgfx_state_flags |= render_mode.blend_flags

        if (render_mode.write_z)
          native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_WRITE_Z);
        endIf

        which (render_mode.culling_mode)
          case CullingMode.CW
            native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_CULL_CW);
          case CullingMode.CCW
            native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_CULL_CCW);
        endWhich

        which (render_mode.depth_test)
          case DepthTest.NE
            native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_DEPTH_TEST_NOTEQUAL);
          case DepthTest.LT
            native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_DEPTH_TEST_LESS);
          case DepthTest.LE
            native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_DEPTH_TEST_LEQUAL);
          case DepthTest.EQ
            native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_DEPTH_TEST_EQUAL);
          case DepthTest.GE
            native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_DEPTH_TEST_GEQUAL);
          case DepthTest.GT
            native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_DEPTH_TEST_GREATER);
          others
            native @|$bgfx_state_flags |= (RogueInt)(BGFX_STATE_DEPTH_TEST_ALWAYS);
        endWhich

        which (batch.primitive_type)
          case PrimitiveType.LINES:     native @|$bgfx_state_flags |= (RogueInt)BGFX_STATE_PT_LINES;
          case PrimitiveType.POINTS:    native @|$bgfx_state_flags |= (RogueInt)BGFX_STATE_PT_POINTS;
        endWhich

        native
        @|bgfx::setVertexBuffer( 0, $this->bgfx_vertex_buffer, (uint32_t)$batch.first_vertex, (uint32_t)$batch.vertex_count );
         |bgfx::setIndexBuffer( $this->bgfx_index_buffer, (uint32_t)$batch.first_index, (uint32_t)$batch.index_count );

        if (batch.texture)
          native @|bgfx::setTexture( 0, $this->bgfx_uniform_texColor, $batch.texture->bgfx_texture );
        elseIf (batch.textures)
          forEach (texture at i in batch.textures)
            if (texture)
              native @|bgfx::setTexture( $i, $this->bgfx_uniform_texColor, $texture->bgfx_texture );
            endIf
          endForEach
        endIf

        shader.apply_uniforms
        native
        @|bgfx::setState( (uint64_t)$bgfx_state_flags );
         |bgfx::submit( $batch.display_id, $shader->program->bgfx_program );

        if (batch.textures) RecyclePool<<Texture[]>>.on_end_use( batch.textures.[clear] )

      endForEach
      render_queue.clear

      set_clip( null )

      native @|bgfx::frame();

      data.clear
      first_index = 0
      first_vertex = 0

    method on_window_resized( window:Window ) [override]
      if (is_initialized)
        local size = window.pixel_size
        activate_window_graphics_context( window )

        native
        @|bgfx::reset( $size.x, $size.y, BGFX_RESET_VSYNC );

        native
        @|bgfx::setViewRect(
         |  $window->id,
         |  0, 0,
         |  static_cast<uint16_t>($size.x),
         |  static_cast<uint16_t>($size.y)
         |);

      endIf

    method set_clip( clip:Box? ) [override]
      if local pixel_clip = clip
        if (pixel_clip.size.x == 0)
          pixel_clip = Box( Display.pixel_size, 1, 1 )
        endIf

        native
        @|bgfx::setScissor(
         |  (uint16_t)$pixel_clip.position.x,
         |  (uint16_t)$pixel_clip.position.y,
         |  (uint16_t)$pixel_clip.size.x,
         |  (uint16_t)$pixel_clip.size.y
         |);
      else
        native @|bgfx::setScissor();
      endIf

    method update_display_order( window:Window ) [override]
      if (window.current_display_id != window.native_display_id)
        # Window moved to different display
        window.current_display_id = window.native_display_id
        auto_clear_while_resizing = true
      endIf

    method uses_homogeneous_depth->Logical [override]
      # Returns 'true' if Z device coordinates are [-1,1] (homogeneous).
      # Returns 'false' if Z device coordinates are [0,1] (normalized).
      return native( "bgfx::getCaps()->homogeneousDepth" )->Logical

endClass

class BGFXVertex( x:Real32, y:Real32, z:Real32, abgr:Int32, u:Real32, v:Real32,
                  nx:Real32, ny:Real32, nz:Real32 ) [compound]
  # Position, Color, UV, Normal
endClass

augment ShaderProgram
  PROPERTIES
    filename  : String
    is_loaded : Logical

    native @|bgfx::ProgramHandle bgfx_program;
    native @|bgfx::UniformHandle bgfx_uniforms[8];

  METHODS
    method init
      noAction

    method init( vertex_shader:Byte[], fragment_shader:Byte[] )
      init

      native
      @|$this->bgfx_program = bgfx::createProgram(
       |  bgfx::createShader( bgfx::copy($vertex_shader->as_bytes, (uint32_t)$vertex_shader->count) ),
       |  bgfx::createShader( bgfx::copy($fragment_shader->as_bytes, (uint32_t)$fragment_shader->count) ),
       |  true  // have BGFX destroy shaders
       |);

    method init_object [append]
      native
      @|for (int i=8; --i>=0; )
       |{
       |  $this->bgfx_uniforms[i] = BGFX_INVALID_HANDLE;
       |}

    method on_cleanup
      native
      @|for (int i=8; --i>=0; )
       |{
       |  bgfx::destroy( $this->bgfx_uniforms[i] );
       |  $this->bgfx_uniforms[i] = BGFX_INVALID_HANDLE;
       |}
       |
       |bgfx::destroy( $this->bgfx_program );
       |$this->bgfx_program = BGFX_INVALID_HANDLE;

    method apply_uniforms
      load

      local uniforms = @uniforms
      if (not uniforms or uniforms.is_empty) return

      if (uniforms.count > 8) println "Warlock Shader exceeds maximum of 8 uniforms."

      local i = 0
      forEach (value at name in uniforms)
        if (not native("bgfx::isValid($this->bgfx_uniforms[$i])")->Logical)
          native
          @|$this->bgfx_uniforms[$i] = bgfx::createUniform( $name->data->as_utf8, bgfx::UniformType::Vec4 );
        endIf

        native
        @|float data[4] = { (float)$value.x, (float)$value.y, (float)$value.z, (float)$value.w };
         |bgfx::setUniform( $this->bgfx_uniforms[$i], data );

        ++i
        if (i == 8) escapeForEach
      endForEach

    method load->this
      if (is_loaded) return this
      is_loaded = true

      native @|$this->bgfx_program = BGFX_INVALID_HANDLE;

      if local shaders_path = Warlock.find_asset( "Assets/Shaders" )
        local listing = File(shaders_path).listing( "*$*"(filename) )
        if (listing.count > 2)
          local min_count = 0
          min_count .= or_larger( (forEach in listing).count )
          listing.discard( $.count > min_count )
        endIf

        contingent
          sufficient (listing.count <= 2)

          local refined = listing.keeping( $.contains("$-"(filename)) )
          if (refined.count) listing = refined
          sufficient (listing.count <= 2)

          refined = listing.keeping( $.contains("$_"(filename)) )
          if (refined.count) listing = refined
          sufficient (listing.count <= 2)

          refined = listing.keeping( $.contains("-$"(filename)) )
          if (refined.count) listing = refined
          sufficient (listing.count <= 2)

          refined = listing.keeping( $.contains("_$"(filename)) )
          if (refined.count) listing = refined
        endContingent

        if (listing.count == 2)
          local fs = listing.first
          local vs = listing.last
          if (fs.contains("vs",&ignore_case)) swapValues( fs, vs )
          init( Warlock.load_asset_bytes(vs), Warlock.load_asset_bytes(fs) )
          if (not exists)
            println "[Warlock] Error loading BGFX shader: $"(filename)
          endIf
          return this
        elseIf (listing.count > 2)
          local filenames = listing.modified( File($).filename ).join(",")
          println "Multiple shaders matching '$': [$]"(filename,filenames)
        else
          println "Shader not found: " + filename
        endIf
      else
        println "Shader not found: " + filename
      endIf

      return this

    method exists->Logical
      return native("bgfx::isValid($this->bgfx_program)")->Logical

endAugment

augment Texture
  PROPERTIES
    native @|bgfx::TextureHandle bgfx_texture;

  METHODS
    method init_object [append]
      native @|$this->bgfx_texture = BGFX_INVALID_HANDLE;

  METHODS
    method set( bitmap:Bitmap, &mipmaps=true, &wrap )
      filepath = bitmap.filepath

      local mipmap = bitmap.cloned
      mipmap.expand_to_power_of_2
      mipmap.premultiply_alpha
      mipmap.swap_red_and_blue
      local size = mipmap.size

      local texels : Color[]

      if (mipmaps)
        local mip_w = mipmap.width
        local mip_h = mipmap.height
        local mipmap_pixel_count = 1   # final 1x1
        while (mip_w > 1 or mip_h > 1)
          mipmap_pixel_count += mip_w * mip_h
          if (mip_w > 1) mip_w :>>>:= 1
          if (mip_h > 1) mip_h :>>>:= 1
        endWhile

        texels = Color[]( mipmap_pixel_count )
        texels.add( mipmap.pixels )
        mip_w = mipmap.width
        mip_h = mipmap.height
        while (mip_w > 1 or mip_h > 1)
          if (mip_w > 1) mip_w :>>>:= 1
          if (mip_h > 1) mip_h :>>>:= 1
          mipmap.resize( mip_w, mip_h )
          texels.add( mipmap.pixels )
        endWhile
      else
        texels = bitmap.pixels
      endIf

      set( texels, size, &=mipmaps, &=wrap )

    method set( texels:Color[], size:XY, &mipmaps, &wrap )
      this.size = size
      uv = Quad( XY(0,0), XY(1,0), XY(1,1), XY(0,1) )

      native
      @|uint32_t sampler_flags = BGFX_SAMPLER_MIN_ANISOTROPIC | BGFX_SAMPLER_MAG_ANISOTROPIC;
       |if ( !$wrap ) sampler_flags |= BGFX_SAMPLER_UVW_CLAMP;
       |
       |$this->bgfx_texture = bgfx::createTexture2D(
       |  static_cast<uint16_t>($size.x), static_cast<uint16_t>($size.y),
       |  $mipmaps,
       |  1,
       |  bgfx::TextureFormat::RGBA8,
       |  sampler_flags,
       |  bgfx::copy( $texels->as_bytes, (uint32_t) ($texels->count*4) )
       |);

    method on_cleanup
      native
      @|bgfx::destroy( $this->bgfx_texture );
       |$this->bgfx_texture = BGFX_INVALID_HANDLE;

    method exists->Logical
      if (source) return source.exists
      return native( "bgfx::isValid($this->bgfx_texture)" )->Logical

endAugment

augment RenderTargetImage
  PROPERTIES
    native @|bgfx::FrameBufferHandle bgfx_frame_buffer;

  METHODS
    method init_object [append]
      native @|$this->bgfx_frame_buffer = BGFX_INVALID_HANDLE;

    method on_cleanup
      native
      @|bgfx::destroy( $this->bgfx_frame_buffer );
       |$this->bgfx_frame_buffer = BGFX_INVALID_HANDLE;

    method exists->Logical
      if (not prior.exists) return false
      return native( "bgfx::isValid($this->bgfx_frame_buffer)" )->Logical

endAugment

augment RenderTargetTexture
  METHODS
    method init( size:XY, type:GlobalID )->RenderTargetTexture
      # Type should be RenderTargetTexture.COLOR or RenderTargetTexture.DEPTH.
      local w = size.x->Int
      local h = size.y->Int
      this.size = XY( w, h )
      uv = Quad( XY(0,0), XY(1,0), XY(1,1), XY(0,1) )

      native @|bgfx::TextureFormat::Enum format;
      which (type)
        case <COLOR>: native @|format = bgfx::TextureFormat::RGBA8;
        case <DEPTH>: native @|format = bgfx::TextureFormat::D24S8;
        others
          println "Unsupported RenderTargetTexture type: $."(type)
          native @|format = bgfx::TextureFormat::RGBA8;
      endWhich

      native
      @|$this->bgfx_texture = bgfx::createTexture2D(
       |  static_cast<uint16_t>($w), static_cast<uint16_t>($h),
       |  false,  // no mip-maps
       |  1,
       |  format,
       |  BGFX_TEXTURE_RT | BGFX_SAMPLER_MIN_ANISOTROPIC | BGFX_SAMPLER_MAG_ANISOTROPIC
       |);

      # Mipmap generation - mipmaps not available until next frame
      # BGFX_TEXTURE_BLIT_DST | BGFX_TEXTURE_MIP_AUTOGEN
      # bgfx::generateMipMaps(myTextureHandle);

endAugment


augment Display
  METHODS
endAugment


augment Window
  METHODS
endAugment


augment RenderMode
  METHODS
    method apply
      apply_bgfx

    method apply_bgfx

    method blend_flags->Int
      local flags = 0
      local src = 0
      local dest = 0

      which (source_blend)
        case ONE
          native @|$src = (RogueInt) BGFX_STATE_BLEND_ONE;
        case ZERO
          native @|$src = (RogueInt) BGFX_STATE_BLEND_ZERO;
        case SOURCE_ALPHA
          native @|$src = (RogueInt) BGFX_STATE_BLEND_SRC_ALPHA;
        case INVERSE_SOURCE_ALPHA
          native @|$src = (RogueInt) BGFX_STATE_BLEND_INV_SRC_ALPHA;
        case INVERSE_SOURCE_COLOR
          native @|$src = (RogueInt) BGFX_STATE_BLEND_INV_SRC_COLOR;
        others
          println "[BGFX] RenderMode.blend_flags unhandled blend mode $."(source_blend)
      endWhich

      which (destination_blend)
        case ONE
          native @|$dest = (RogueInt) BGFX_STATE_BLEND_ONE;
        case ZERO
          native @|$dest = (RogueInt) BGFX_STATE_BLEND_ZERO;
        case SOURCE_ALPHA
          native @|$dest = (RogueInt) BGFX_STATE_BLEND_SRC_ALPHA;
        case INVERSE_SOURCE_ALPHA
          native @|$dest = (RogueInt) BGFX_STATE_BLEND_INV_SRC_ALPHA;
        case INVERSE_SOURCE_COLOR
          native @|$dest = (RogueInt) BGFX_STATE_BLEND_INV_SRC_COLOR;
        others
          println "[BGFX] RenderMode.blend_flags unhandled blend mode $."(destination_blend)
      endWhich

      native @|$flags = (RogueInt) BGFX_STATE_BLEND_FUNC(
              |  (uint64_t)$src,
              |  (uint64_t)$dest
              |);

      return flags
endAugment
