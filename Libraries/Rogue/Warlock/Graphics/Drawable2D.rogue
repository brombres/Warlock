library Warlock

class Drawable2D : Entity2D
  PROPERTIES
    color       = Color.WHITE : Color
    colors      : Quad<<Color>>?
    render_mode : RenderMode

  METHODS
    method init_clone( existing:Drawable2D )
      prior.init_clone( existing )
      color  = existing.color
      render_mode = existing.render_mode

    method set_color( @color )
      colors = null

    method set_render_mode( @render_mode )
endClass
