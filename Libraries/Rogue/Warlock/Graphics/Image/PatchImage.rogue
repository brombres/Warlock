library Warlock

class PatchImage : Image
  PROPERTIES
    border_scale     = 1.0
    patch_count      : Int
    patches          : Image[]
    .truncate_top    : Logical
    .truncate_left   : Logical
    .truncate_bottom : Logical
    .truncate_right  : Logical

  METHODS
    method init( asset_name:String, split=null:XY? )
      prior.init

      patches = Image[]( asset_name ).[ anchor=Anchor.TOP_LEFT ]
      patch_count = patches.count

      if (not split) split = patches.first.asset.image_patch_split
      if (split.value.product == 0)
        which (patch_count)
          case 3: split = XY(3,1)
          others: split = XY(3,3)
        endWhich
      endIf
      local patch_split = split.value.floor

      if (patch_count != 3 and patch_count < 8 and patch_count > 9)
        println ''PatchImage("$") expects asset to be an image list of 3, 8, or 9 images.''(asset_name)
        patches = null
        return
      endIf

      if (patch_split != XY(3,3) and patch_split != XY(3,1) and patch_split != XY(1,3))
        println ''PatchImage("$") expects split to be (3,3), (3,1), or (1,3) but ($,$) was specified.''(asset_name,patch_split.x->Int,patch_split.y->Int)
        patches = null
        return
      endIf

      if (patch_split == XY(1,3))
        if (not .ensure_patch_count(asset_name,3,patch_split)) return
        local a = patches[0]
        local b = patches[1]
        local c = patches[2]
        patches.dim( 9 )
        patches[0] = a
        patches[3] = b
        patches[6] = c
      elseIf (patch_split == XY(3,1))
        if (not .ensure_patch_count(asset_name,3,patch_split)) return
        patches.expand_to_count( 9 )
      elseIf (patch_count == 8)
        patches.insert( null->(as Image), 4 )
      endIf

    method init( patches, &h, &v )
      if (patches.count == 8) patches = patches.cloned
      patches.anchor = Anchor.TOP_LEFT

      patch_count = patches.count

      if (patches.count == 3)
        if (v)
          local a = patches[0]
          local b = patches[1]
          local c = patches[2]
          patches.dim( 9 )
          patches[0] = a
          patches[3] = b
          patches[6] = c
        else
          patches.expand_to_count( 9 )
        endIf
      elseIf (patch_count == 8)
        patches.insert( null->(as Image), 4 )
      elseIf (patch_count != 9)
        println ''PatchImage expects an image list of 3, 8, or 9 images (supplied list has $).'' ...
          ("# image".pluralized(patches.count))
        patches = null
      endIf

    method .ensure_patch_count( asset_name:String, n:Int, patch_split:XY )->Logical
      if (patches.count == n) return true
      println ''PatchImage("$") requires a list of $ for a split of ($,$).''
        (asset_name, "# image".pluralized(n), patch_split.x->Int, patch_split.y->Int)
      patches = null
      return false

    method draw( position:XY )
      if (not patches) return
      temporarily natural_size=size, scale=1.0
        prior.draw( position )
      endTemporarily

    method draw( bounds:Box )
      if (not patches) return
      temporarily natural_size=bounds.size, scale=1.0
        prior.draw( bounds )
      endTemporarily

    method .draw_entity [override]
      local size = display_bounds.size

      local w_col_1 = patches[0]?.size.x * border_scale
      local w_col_3 = patches[2]?.size.x * border_scale
      local h_row_1 = patches[0]?.size.y * border_scale
      local h_row_3 = patches[6]?.size.y * border_scale

      if (w_col_1 + w_col_3 > size.x or h_row_1 + h_row_3 > size.y)
        local scale = (size.x / (w_col_1+w_col_3)).or_smaller( size.y / (h_row_1+h_row_3) )
        w_col_1 *= scale
        w_col_3 *= scale
        h_row_1 *= scale
        h_row_3 *= scale
      endIf

      local w_col_2 = size.x - (w_col_1 + w_col_3)
      local h_row_2 = size.y - (h_row_1 + h_row_3)

      local x0 = display_bounds.position.x
      local x1 = x0 + w_col_1
      local x2 = x0 + w_col_1 + w_col_2
      local x3 = x0
      local x4 = x0 + w_col_1
      local x5 = x2
      local x6 = x0
      local x7 = x0 + w_col_1
      local x8 = x2

      local w0 = w_col_1
      local w1 = w_col_2
      local w2 = w_col_3
      local w3 = w_col_1
      local w4 = w_col_2
      local w5 = w_col_3
      local w6 = w_col_1
      local w7 = w_col_2
      local w8 = w_col_3

      local y0 = display_bounds.position.y
      local y1 = y0
      local y2 = y0
      local y3 = y0 + h_row_1
      local y4 = y0 + h_row_1
      local y5 = y0 + h_row_1
      local y6 = y0 + h_row_1 + h_row_2
      local y7 = y6
      local y8 = y6

      local h0 = h_row_1
      local h1 = h_row_1
      local h2 = h_row_1
      local h3 = h_row_2
      local h4 = h_row_2
      local h5 = h_row_2
      local h6 = h_row_3
      local h7 = h_row_3
      local h8 = h_row_3

      if (.truncate_top)
        y3 = y0
        y4 = y1
        y5 = y2
        h3 += h0
        h4 += h1
        h5 += h2
        h0 = 0
        h1 = 0
        h2 = 0
      endIf

      if (.truncate_left)
        x1 = x0
        x4 = x3
        x7 = x6
        w1 += w0
        w4 += w3
        w7 += w6
        w0 = 0
        w3 = 0
        w6 = 0
      endIf

      if (.truncate_bottom)
        h3 += h6
        h4 += h7
        h5 += h8
        h6 = 0
        h7 = 0
        h8 = 0
      endIf

      if (.truncate_right)
        w1 += w2
        w4 += w5
        w7 += w8
        w2 = 0
        w5 = 0
        w8 = 0
      endIf

      if (h1)
        if (w0) patches[0]?.draw( Box(x0,y0,w0,h0) )
        patches[1]?.draw( Box(x1,y1,w1,h1) )
        if (w2) patches[2]?.draw( Box(x2,y2,w2,h2) )
      endIf

      if (w3) patches[3]?.draw( Box(x3,y3,w3,h3) )
      patches[4]?.draw( Box(x4,y4,w4,h4) )
      if (w5) patches[5]?.draw( Box(x5,y5,w5,h5) )

      if (h7)
        if (w6) patches[6]?.draw( Box(x6,y6,w6,h6) )
        patches[7]?.draw( Box(x7,y7,w7,h7) )
        if (w8) patches[8]?.draw( Box(x8,y8,w8,h8) )
      endIf

    method set_color( color:Color )
      @color = color
      if (patches)
        (forEach as Image in patches).color = color
      endIf

    method set_colors( colors:Quad<<Color>> )
      @colors = colors
      if (patches)
        (forEach as Image in patches).colors = colors
      endIf

    method set_opacity( opacity:Real )
      @opacity = opacity
      if (patches)
        (forEach as Image in patches).opacity = opacity
      endIf

    method set_render_mode( render_mode:RenderMode )
      @render_mode = render_mode
      if (patches)
        (forEach as Image in patches).render_mode = render_mode
      endIf

    method set_truncate_top( setting:Logical )
      .truncate_top = setting

    method set_truncate_left( setting:Logical )
      .truncate_left = setting

    method set_truncate_bottom( setting:Logical )
      .truncate_bottom = setting

    method set_truncate_right( setting:Logical )
      .truncate_right = setting

    method stretchtiled( stretch_limit=1.0:Real )
      stretchtiled_edges
      stretchtiled_middle

    method stretchtiled_edges( stretch_limit=1.0:Real, &h, &v )
      if (h == v)
        h = true
        v = true
      endIf

      if (h)
        if local p1 = patches[1]->(as Image)
          if (p1 not instanceOf StretchtiledImage)
            patches[1] = StretchtiledImage( p1 )
          endIf
          patches[1]->(as StretchtiledImage).[ horizontal_tiling_only(stretch_limit) ]
        endIf

        if local p7 = patches[7]->(as Image)
          if (p7 not instanceOf StretchtiledImage)
            patches[7] = StretchtiledImage( p7 )
          endIf
          patches[7]->(as StretchtiledImage).[ horizontal_tiling_only(stretch_limit) ]
        endIf
      endIf

      if (v)
        if local p3 = patches[3]->(as Image)
          if (p3 not instanceOf StretchtiledImage)
            patches[3] = StretchtiledImage( p3 )
          endIf
          patches[3]->(as StretchtiledImage).[ vertical_tiling_only(stretch_limit) ]
        endIf

        if local p5 = patches[5]->(as Image)
          if (p5 not instanceOf StretchtiledImage)
            patches[5] = StretchtiledImage( p5 )
          endIf
          patches[5]->(as StretchtiledImage).[ vertical_tiling_only(stretch_limit) ]
        endIf

      endIf

    method stretchtiled_middle( stretch_limit=1.0:Real, &h, &v )
      if local p4 = patches[4]->(as Image)
        if (p4 not instanceOf StretchtiledImage) patches[4] = StretchtiledImage( p4 )
        local image = patches[4]->(as StretchtiledImage)
        if (h xor v)
          if (h) image.horizontal_tiling_only( stretch_limit )
          else   image.vertical_tiling_only( stretch_limit )
        else
          image.stretch_limit = stretch_limit
        endIf
      else
        if (patch_count == 3)
          if (patches[1])     stretchtiled_edges( stretch_limit, &h )
          elseIf (patches[3]) stretchtiled_edges( stretch_limit, &v )
        endIf
      endIf

    method truncate_top
      .truncate_top = true

    method truncate_left
      .truncate_left = true

    method truncate_bottom
      .truncate_bottom = true

    method truncate_right
      .truncate_right = true

    method unload
      (forEach as Image in patches).unload

endClass
