library Warlock

class ImageInfo( texture_index:Int, bounds:Box, wrap:Logical ) [compound]
  METHODS
    method bitmap->Bitmap
      if local filepath = Warlock.find_asset( AssetManager.texture_filepaths[texture_index] )
        return Bitmap( filepath )
      else
        return Bitmap( 1, 1, Color.WHITE ).[ error="[Warlock] ImageInfo file not found." ]
      endIf

    method texture( &mipmaps=true )->Texture
      local relative_filepath = AssetManager.texture_filepaths[texture_index]
      if local texture_filepath = Warlock.find_asset( relative_filepath )
        local info = AssetManager.texture_info[ relative_filepath ]
        info.filepath = texture_filepath.filepath
        info.mipmaps = mipmaps
        info.wrap    = wrap
        return Texture( Texture(info), bounds )
      else
        return Texture()
      endIf
endClass
