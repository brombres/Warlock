library Warlock

class Image : Drawable2D
  GLOBAL METHODS
    method create( name:String )->Image
      return TextureImage( name )

  PROPERTIES
    asset        : AssetInfo
    opacity      = 1.0
    subdivisions = XY(0,0)  # for shader effects - XY(4,0) would draw a mesh composed of 16x1 quads

  METHODS
    method init( size=XY(1,1):XY, color=Color(0) )
      reset_size( size )

    method init( existing:Image )
      prior.init( existing )
      asset        = existing.asset
      opacity      = existing.opacity
      subdivisions = existing.subdivisions

    method fill( color=null:Color? )
      if (not color) color = this.color

      Renderer.draw(
        Box(nominal_size),
        color.value,
        render_mode||RenderMode.ALPHA_COLOR,
        subdivisions
      )

    method load
      # Ensures image is fully loaded.
      noAction

    method set_opacity( @opacity )

    method texture->Texture
      return null

endClass

augment Image[]
  METHODS
    method init( asset_name:String )
      local asset = AssetManager.find_image( asset_name )
      if (asset)
        reserve( asset.image_count )
        forEach (i in 0..<asset.image_count)
          add( TextureImage(asset, i) )
        endForEach
      else
        println "No such image collection: " + asset_name
      endIf

    method anchor_top_left
      (forEach as Image in this).anchor_top_left

    method anchor_top
      (forEach as Image in this).anchor_top

    method anchor_top_right
      (forEach as Image in this).anchor_top_right

    method anchor_left
      (forEach as Image in this).anchor_left

    method anchor_center
      (forEach as Image in this).anchor_center

    method anchor_right
      (forEach as Image in this).anchor_right

    method anchor_bottom_left
      (forEach as Image in this).anchor_bottom_left

    method anchor_bottom
      (forEach as Image in this).anchor_bottom

    method anchor_bottom_right
      (forEach as Image in this).anchor_bottom_right

    method crop( proportional_subset:Box )
      (forEach as TextureImage in this).crop( proportional_subset )

    method reset_size( size:XY )
      (forEach as Image in this).reset_size( size )

    method set_anchor( anchor:Anchor )
      (forEach as Image in this).anchor = anchor

    method set_color( color:Color )
      (forEach as Image in this).color = color

    method set_colors( colors:Quad<<Color>> )
      (forEach as Image in this).colors = colors

    method set_nominal_size( nominal_size:XY )
      (forEach as Image in this).nominal_size = nominal_size

    method set_opacity( opacity:Real )
      (forEach as Image in this).opacity = opacity

    method set_position( position:XY )
      (forEach as Image in this).position = position

    method set_scale( scale:Real )
      (forEach as Image in this).scale = scale

    method set_scale( scale:XY )
      (forEach as Image in this).scale = scale

    method set_render_mode( render_mode:RenderMode )
      (forEach as Image in this).render_mode = render_mode

    method set_size( size:XY )
      (forEach as Image in this).size = size

    method set_size( size:XY, scale:XY )
      (forEach as Image in this).set_size( size, scale )

    method set_subdivisions( subdivisions:XY )
      (forEach as Image in this).subdivisions = subdivisions

endAugment
