library Warlock

class TextureImage : Image
  PROPERTIES
    texture          : Texture
    original_texture : Texture
    image_index      : Int

  METHODS
    method init( texture )
      natural_size = texture.size
      scale = 1.0

    method init( asset, image_index )
      natural_size = asset.images[image_index].bounds.size
      scale = 1.0

    method init( asset_name:String )
      local asset = AssetManager.find_image( asset_name )
      if (asset)
        init( asset, 0 )
      else
        println "No such image: " + asset_name
      endIf

    method init_clone( existing:TextureImage )
      prior.init_clone( existing )
      texture     = existing.texture
      image_index = existing.image_index

    method crop( proportional_subset:Box )
      if (not original_texture)
        original_texture = texture
        texture = Texture( original_texture )
      endIf

      texture.init( original_texture, proportional_subset )

    method load [override]
      # Ensures image is fully loaded.
      texture  # will load if necessary

    method recycle
      if (@texture) @texture.recycle
      texture = null
      original_texture = null

    method reset_crop
      if (original_texture)
        texture.init( original_texture )
        # else texture is already original texture
      endIf
      natural_size = texture.size
      scale = 1.0

    method texture->Texture [override]
      if (not @texture and asset)
        texture = asset.images[image_index].texture( &mipmaps )
        # actually loads texture if necessary
      endIf
      return @texture

    method .draw_entity [override]
      local color  : Color
      local colors : Quad<<Color>>

      if (this.colors)
        colors = Quad<<Color>>(
          this.colors.value.a.with_opacity( opacity ),
          this.colors.value.b.with_opacity( opacity ),
          this.colors.value.c.with_opacity( opacity ),
          this.colors.value.d.with_opacity( opacity )
        )
      else
        color = this.color.with_opacity( opacity )
      endIf

      if (texture)
        local h_flip = attributes.h_flip
        local v_flip = attributes.v_flip
        if (.v_flip_texture) v_flip = not v_flip
        local render_mode = render_mode || RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY
        if (this.colors)
          Renderer.draw( display_bounds, texture, colors, render_mode, &=subdivisions, &=h_flip, &=v_flip )
        else
          Renderer.draw( display_bounds, texture, color, render_mode, &=subdivisions, &=h_flip, &=v_flip )
        endIf
      else
        if (this.colors)
          Renderer.draw( display_bounds, colors, render_mode||RenderMode.ALPHA_COLOR, &=subdivisions )
        else
          Renderer.draw( display_bounds, color, render_mode||RenderMode.ALPHA_COLOR, &=subdivisions )
        endIf
        Renderer.draw( display_bounds, color, render_mode||RenderMode.ALPHA_COLOR, &=subdivisions )
      endIf

    method .v_flip_texture->Logical
      return false

endClass
