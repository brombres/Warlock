library Warlock

class TextureMeshImage : TextureImage
  PROPERTIES
    mesh        : Mesh
    render_mode = RenderMode.LIT_TEXTURE_COLOR_MULTIPLY : RenderMode

  METHODS
    method init( texture, mesh )
      prior.init( texture )
      reset_size( XY(1,1) )

    method init( texture, polygon:XY[] )
      init( texture, texture.polygon_mesh(polygon) )

    method init_clone( existing:TextureMeshImage )
      prior.init_clone( existing )
      mesh = existing.mesh

    method .draw_entity [override]
      mesh.draw( texture, render_mode || RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY )
endClass
