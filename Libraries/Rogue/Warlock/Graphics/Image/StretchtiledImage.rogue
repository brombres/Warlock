library Warlock

class StretchtiledImage : Image
  PROPERTIES
    color         = Color.WHITE
    image         : Image
    stretch_limit = XY(1.0,1.0)

  METHODS
    method init( image )

    method init( texture:Texture )
      image = TextureImage( texture )

    method init( asset_name:String )
      image = TextureImage( asset_name )

    method init_clone( existing:StretchtiledImage )
      prior.init_clone( existing )
      image          = existing.image
      stretch_limit  = existing.stretch_limit

    method horizontal_tiling_only( stretch_limit=1.0:Real )
      this.stretch_limit = XY( stretch_limit.clamped_low(1.0), 0 )

    method load [override]
      image.load

    method set_color( color:Color )
      @color = color
      if (image) image.color = color

    method set_colors( colors:Quad<<Color>> )
      @colors = colors
      if (image) image.colors = colors

    method set_opacity( opacity:Real )
      @opacity = opacity
      if (image) image.opacity = opacity

    method set_render_mode( render_mode:RenderMode )
      @render_mode = render_mode
      if (image) image.render_mode = render_mode

    method set_stretch_limit( @stretch_limit )

    method set_stretch_limit( stretch_limit:Real )
      set_stretch_limit( XY(stretch_limit,stretch_limit) )

    method texture->Texture [override]
      return image.texture

    method vertical_tiling_only( stretch_limit=1.0:Real )
      this.stretch_limit = XY( 0, stretch_limit.clamped_low(1.0) )

    method .draw_entity [override]
      local bounds = Box( nominal_size )
      local h_flip = attributes.h_flip
      local v_flip = attributes.v_flip
      local render_mode = render_mode || RenderMode.ALPHA_TEXTURE
      localize size
      local nominal_size = image.nominal_size.scaled_to_fit( size )
      local tile_count = (size / nominal_size).floor
      if (stretch_limit.x)
        if (tile_count.x * nominal_size.x * stretch_limit.x < size.x) ++tile_count.x
      else
        tile_count.x = 1
      endIf
      if (stretch_limit.y)
        if (tile_count.y * nominal_size.y * stretch_limit.y < size.y) ++tile_count.y
      else
        tile_count.y = 1
      endIf
      forEach (j in 0..<tile_count.y->Int)
        forEach (i in 0..<tile_count.x->Int)
          image.draw( bounds.cell( XY(i,j), tile_count ) )
        endForEach
      endForEach

endClass
