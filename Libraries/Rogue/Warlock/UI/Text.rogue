library UI
uses Warlock

augment UI::Text
  PROPERTIES
    app_data_key  : VariantEntry
    cur_value     : Variant
    text_format   : TextFormat?

  METHODS
    method init( app_data_key )
      value = String()
      on_update_app_data

    method init( app_data_id:GlobalID )
      # e.g. <AppData.health>
      init( Warlock::AppDataValue(app_data_id) )

    method init( format:String, app_data_key:VariantEntry )
      # format - Value is inserted at '@' placeholder. '@' can be '@(<marker-format>)'.
      text_format = TextFormat( format )
      init( app_data_key )

    method init( format:String, app_data_id:GlobalID )
      # format - Value is inserted at '@' placeholder. '@' can be '@(<marker-format>)'.
      # e.g. <AppData.health>
      text_format = TextFormat( format )
      init( app_data_id )

    method app_data_needs_update->Logical
      if (app_data_key)
        local new_value = app_data_key->Variant
        return (new_value != cur_value)
      endIf
      return false

    method on_begin_layout_internal [insert]
      on_update_app_data

    method on_update [override]
      if (app_data_needs_update)
        on_update_app_data
        request_layout
      endIf
      prior.on_update

    method on_update_app_data
      if (app_data_key)
        cur_value = app_data_key->Variant
        value.clear
        if (text_format) text_format.value.print( cur_value, value )
        else             value.print( cur_value )
      endIf

endAugment


class TextFormat( format:String, marker:TextFormatMarker ) [compound]
  GLOBAL METHODS
    method create( format:String )->TextFormat
      if local format_i1 = format.locate( "@(" )
        if local format_i2 = format.locate( ")", format_i1+2 )
          local marker = TextFormatMarker( format.from(format_i1+2,format_i2-1) )
          format = format.leftmost( format_i1 ) + "@" + format.from( format_i2+1 )
          return TextFormat( format, marker )
        endIf
      endIf

      return TextFormat( format, null )

  METHODS
    method print( value:Variant, builder:String )
      if local marker_i = format.locate( '@' )
        forEach (i in 0..<marker_i) builder.print( format[i] )
        if (marker) marker.print( value, builder )
        else        builder.print( value )
        forEach (i in marker_i+1..<format.count) builder.print( format[i] )
      endIf
endClass


class TextFormatMarker
  PROPERTIES
    as_integer    : Logical
    insert_commas : Logical

  METHODS
    method init( marker:String )
      if (marker.contains("I")) as_integer = true; marker.=replacing("I","")
      if (marker.contains(",")) insert_commas = true; marker.=replacing(",","")

    method print( value:Variant, builder:String )
      if (value.is_number)
        builder.print( value->Int )

        if (insert_commas)
          use modified = StringPool
            forEach (ch at i in builder)
              local nth = (builder.count - i) - 1
              modified.print ch
              if (nth > 0 and nth % 3 == 0) modified.print ','
            endForEach
            builder.clear
            builder.print( modified )
          endUse
        endIf

        if (not as_integer and value.is_real)
          use fraction = StringPool
            fraction.print value
            fraction.remove_first
            builder.print fraction
          endUse
        endIf

      else
        builder.print( value )
      endIf

endClass
