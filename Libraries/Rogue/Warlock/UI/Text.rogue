library UI
uses Warlock

augment UI::Text
  PROPERTIES
    app_data_key  : VariantEntry
    cur_value     : Variant

    format        : String
    # Value is inserted at '@' placeholder. '@' can be '@(<marker-format>)'.

    marker_format : MarkerFormat

  METHODS
    method init( app_data_key )
      value = String()
      on_update_app_data

    method init( app_data_id:GlobalID )
      # e.g. <AppData.health>
      init( Warlock::AppDataValue(app_data_id) )

    method init( format, app_data_key:VariantEntry )
      .parse_format
      init( app_data_key )

    method init( format, app_data_id:GlobalID )
      # e.g. <AppData.health>
      .parse_format
      init( app_data_id )

    method app_data_needs_update->Logical
      if (app_data_key)
        local new_value = app_data_key->Variant
        return (new_value != cur_value)
      endIf
      return false

    method on_begin_layout_internal [insert]
      on_update_app_data

    method on_update [override]
      if (app_data_needs_update)
        on_update_app_data
        request_layout
      endIf
      prior.on_update

    method on_update_app_data
      if (app_data_key)
        cur_value = app_data_key->Variant
        value.clear
        if (format)
          if local marker_i = format.locate( '@' )
            forEach (i in 0..<marker_i) value.print( format[i] )
            if (marker_format) marker_format.print( cur_value, value )
            else               value.print( cur_value )
            forEach (i in marker_i+1..<format.count) value.print( format[i] )
          endIf
        else
          value.print( cur_value )
        endIf
      endIf

    method .parse_format
      if local format_i1 = format.locate( "@(" )
        if local format_i2 = format.locate( ")", format_i1+2 )
          marker_format = MarkerFormat( format.from(format_i1+2,format_i2-1) )
          format = format.leftmost( format_i1 ) + "@" + format.from( format_i2+1 )
        endIf
      endIf

endAugment

class MarkerFormat
  PROPERTIES
    as_integer    : Logical
    insert_commas : Logical

  METHODS
    method init( marker_format:String )
      if (marker_format.contains("I")) as_integer = true; marker_format.=replacing("I","")
      if (marker_format.contains(",")) insert_commas = true; marker_format.=replacing(",","")

    method print( value:Variant, builder:String )
      if (value.is_number)
        builder.print( value->Int )

        if (insert_commas)
          use modified = StringPool
            forEach (ch at i in builder)
              local nth = (builder.count - i) - 1
              modified.print ch
              if (nth > 0 and nth % 3 == 0) modified.print ','
            endForEach
            builder.clear
            builder.print( modified )
          endUse
        endIf

        if (not as_integer and value.is_real)
          use fraction = StringPool
            fraction.print value
            fraction.remove_first
            builder.print fraction
          endUse
        endIf

      else
        builder.print( value )
      endIf

endClass
