library UI
uses Warlock

augment UI::Text
  PROPERTIES
    app_data_key : AppDataKey

  METHODS
    method init( app_data_key )
      value = String()
      on_update_app_data

    method init( app_data_id:GlobalID )
      # e.g. <AppData.health>
      init( AppDataKey(app_data_id) )

    method app_data_needs_update->Logical
      if (app_data_key)
        local new_value = AppData[ app_data_key ] || ""
        return (new_value != value)
      endIf
      return false

    method on_begin_layout_internal [insert]
      on_update_app_data

    method on_update [override]
      if (app_data_needs_update)
        on_update_app_data
        request_layout
      endIf
      prior.on_update

    method on_update_app_data
      if (app_data_key)
        value.clear
        value.print( AppData[app_data_key] )
      endIf
endAugment
