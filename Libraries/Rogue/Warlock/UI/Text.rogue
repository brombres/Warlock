library UI
uses Warlock

augment UI::Text
  PROPERTIES
    app_data_key : VariantEntry
    cur_value    : Variant
    format       : String  # Value is inserted at '$' placeholder.

  METHODS
    method init( app_data_key )
      value = String()
      on_update_app_data

    method init( app_data_id:GlobalID )
      # e.g. <AppData.health>
      init( Warlock::AppDataValue(app_data_id) )

    method init( format, app_data_key:VariantEntry )
      init( app_data_key )

    method init( format, app_data_id:GlobalID )
      # e.g. <AppData.health>
      init( app_data_id )

    method app_data_needs_update->Logical
      if (app_data_key)
        local new_value = app_data_key->Variant
        return (new_value != cur_value)
      endIf
      return false

    method on_begin_layout_internal [insert]
      on_update_app_data

    method on_update [override]
      if (app_data_needs_update)
        on_update_app_data
        request_layout
      endIf
      prior.on_update

    method on_update_app_data
      if (app_data_key)
        cur_value = app_data_key->Variant
        value.clear
        if (format)
          contingent
            if local marker_i = format.locate( "$(" )
              if (marker_i + 3 < format.count)
                if (format[marker_i+3] == ')')
                  forEach (i in 0..<marker_i) value.print( format[i] )
                  which (format[marker_i+2])
                    case 'I': value.print( cur_value->Int )
                    others:   value.print( cur_value )
                  endWhich
                  forEach (i in marker_i+3..<format.count) value.print( format[i] )

                  escapeContingent
                endIf
              endIf
            endIf

            if local marker_i = format.locate( '$' )
              forEach (i in 0..<marker_i) value.print( format[i] )
              value.print( cur_value )
              forEach (i in marker_i+1..<format.count) value.print( format[i] )
            endIf
          endContingent

        else
          value.print( cur_value )
        endIf
      endIf

endAugment
