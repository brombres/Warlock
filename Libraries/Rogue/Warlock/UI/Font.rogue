library UI

uses Warlock

augment UI::Font
  GLOBAL PROPERTIES
    fonts = [String:Font]

  GLOBAL METHODS
    method create( asset_name:String, &snap, &snug )->Font
      if local font = fonts[asset_name]
        local result = font.cloned
        result.reset
        result.snap = snap
        if (snug) result.spacing_adjustment = -1
        return result
      else
        return new<<Font>>.[ init_instance(asset_name, &=snap, &=snug) ]
      endIf

  PROPERTIES
    asset_name         : String
    asset              : AssetInfo
    internal_height    : Int
    offset             : XY  # as a fraction of height
    fixed_width        : Int
    ascii_characters   : FontCharacter[]
    character_lookup   : [Character:FontCharacter]

    color              = Color.WHITE : Color
    opacity            = 1.0
    @width_scale       = 1.0  # applied when height is modified
    scale              = XY( width_scale, 1.0 )

    error              : String
    spacing_adjustment = 0
    snap               : Logical
    monospace          : Logical
    monospace_width    : Int

    render_mode        : RenderMode
    is_loaded          : Logical
    is_used            : Logical

  METHODS
    method init_instance( asset_name, snap=false, &snug )
      fonts[asset_name] = this

      ascii_characters = Dim<<FontCharacter>>(128)
      character_lookup = [Character:FontCharacter]

      asset = AssetManager.find_font( asset_name )
      if (asset)
        internal_height = asset.font_height
        fixed_width     = asset.font_width
        monospace_width = asset.font_monospace

        local offset  = asset.font_offset
        local advance = asset.font_advance
        local kerning = asset.font_kerning

        forEach (unicode at i in asset.font_characters)
          local font_ch = FontCharacter( asset, i, unicode, offset?[i], advance?[i], kerning?[unicode] )
          if (unicode < 128) ascii_characters[unicode] = font_ch
          character_lookup[unicode] = font_ch
        endForEach
      else
        error = "No such font: " + asset_name
        println error
      endIf

      if (snug) spacing_adjustment = -1

    method init_clone( existing:Font ) [insert]
      asset_name         = existing.asset_name
      asset              = existing.asset
      internal_height    = existing.internal_height
      scale              = existing.scale
      offset             = existing.offset
      fixed_width        = existing.fixed_width
      ascii_characters   = existing.ascii_characters
      character_lookup   = existing.character_lookup
      color              = existing.color
      opacity            = existing.opacity
      error              = existing.error
      spacing_adjustment = 0
      snap               = existing.snap
      width_scale        = existing.width_scale

    method reset
      scale              = XY(width_scale,1)
      offset             = XY.zero
      anchor             = Anchor.CENTER
      color              = Color.WHITE
      opacity            = 1.0
      spacing_adjustment = 0
      snap               = false

    method character( unicode:Character )->FontCharacter
      if (error) return null
      if (unicode <= 127) return ascii_characters[ unicode ]
      return character_lookup[ unicode ]

    method draw( text:Text )
      local bounds = text.display_bounds
      local (font_scale,text_size) = text.scaling_mode.scale_text( this, text.value, bounds )
      if (text_size?)
        bounds = Box( Box(text_size).positioned_within( bounds, text.content_alignment ).position, text_size )

        temporarily this.scale=font_scale, anchor=Anchor.TOP_LEFT
          temporarily opacity = this.opacity * text.opacity
            if local style = text.text_style
              style.draw( text, bounds )
            else
              draw( text.value, bounds.position )
            endIf
          endTemporarily
        endTemporarily
      endIf

    method draw( text:String, bounds:Box, anchor=Anchor.CENTER:Anchor,
        scaling_mode=ScalingModeXY(ScalingMode.NONE,ScalingMode.NONE):ScalingModeXY,
        opacity=1.0:Real, style=null:TextStyle )
      local (font_scale,text_size) = scaling_mode.scale_text( this, text, bounds )
      if (text_size?)
        bounds = Box( Box(text_size).positioned_within( bounds, anchor ).position, text_size )

        temporarily this.scale=font_scale, this.anchor=Anchor.TOP_LEFT
          temporarily this.opacity = this.opacity * opacity
            if (style) style.draw( this, text, bounds )
            else       draw( text, bounds.position )
          endTemporarily
        endTemporarily
      endIf


    method draw( text:String, position:XY  )
      load
      position = position - Box(measure(text)).at( anchor ).yv + XY(0,offset.y*internal_height*scale.y)

      if (text.contains('\n'))
        local h = internal_height * scale.y * line_spacing
        use buffer = StringPool
          forEach (ch in text)
            if (ch == '\n')
              draw_line( buffer, position )
              buffer.clear
              position += XY( 0, h )
            else
              buffer.print( ch )
            endIf
          endForEach
          if (buffer.count) draw_line( buffer, position )
        endUse
      else
        draw_line( text, position )
      endIf

    method draw_line( text:String, position:XY  )
      load
      local cursor = (position - Box(measure(text)).at( anchor ).xv) + XY(offset.x*internal_height*scale.x,0)
      if (snap) cursor = cursor.floor
      local prev_ch : FontCharacter
      forEach (ch in text)
        local font_ch = character( ch )
        if (font_ch)
          local image = font_ch.image
          image.size = font_ch.size * scale
          image.color = color
          image.render_mode = render_mode
          if (prev_ch and prev_ch.kerning)
            local kern = prev_ch.kerning[ font_ch.unicode ]
            if (kern) cursor += XY( kern*scale.x, 0 )
          endIf
          image.position = cursor + font_ch.offset * scale
          image.opacity = opacity
          image.draw
          cursor += (font_ch.advance + XY(spacing_adjustment,0)) * scale
          prev_ch = font_ch
        endIf
      endForEach

    method height->Real
      return internal_height * scale.y

    method load
      if (is_loaded) return
      is_loaded = true

      forEach (font_ch in character_lookup)
        font_ch.image.load
      endForEach

    method measure( ch:Character )->XY [replace]
      local h = internal_height * scale.y
      if (fixed_width)
        local w = (fixed_width + spacing_adjustment) * scale.x
        which (ch)
          case '\n': return XY(0,h)
          case '\t': return XY(w,h)
          others
            if (ch < 32) return XY.zero
            else         return XY(w,h)
        endWhich
      else
        which (ch)
          case '\n': return XY(0,h)
          case '\t': return XY((character(' ').advance.x+spacing_adjustment)*scale.x*2,h)
          others
            if (ch < 32) return XY.zero
            else         return XY((character(ch).advance.x+spacing_adjustment)*scale.x,h)
        endWhich
      endIf

    method measure( text:String, i1=null:Int?, count=null:Int? )->XY
      if (error) return XY.zero

      if (count and count.value == 0) return XY( 0, 0 )

      local line_height = internal_height * scale.y
      if (snap) line_height = line_height.floor

      local max_w = 0.0
      local w = 0.0
      local h = 0.0
      local cur_h = 0.0
      local max_i2 = text.count - 1
      if (i1) i1 = i1.value.clamped(0,max_i2)
      else    i1 = 0

      local i2 : Int?
      if (count) i2 = i1.value + (count.value - 1)

      if (i2) i2 = i2.value.clamped(i1.value,max_i2)
      else    i2 = max_i2

      if (fixed_width)
        forEach (index in i1.value..i2.value)
          local unicode = text[index]
          cur_h = line_height
          if (unicode == '\n')
            w = 0.0
            h += cur_h * line_spacing
            cur_h = 0.0
          else
            w += fixed_width + spacing_adjustment
            max_w .= or_larger( w )
          endIf
        endForEach
      else
        local prev_ch : FontCharacter
        forEach (index in i1.value..i2.value)
          local unicode = text[index]
          cur_h = line_height
          if (unicode == '\n')
            w = 0.0
            h += cur_h * line_spacing
            cur_h = 0.0
            prev_ch = null
          else
            local ch = character( unicode )
            if (ch)
              if (prev_ch and prev_ch.kerning)
                local kern = prev_ch.kerning[ ch.unicode ]
                if (kern) w += kern
              endIf
              w += ch.advance.x + spacing_adjustment
              max_w .= or_larger( w )
              prev_ch = ch
            endIf
          endIf
        endForEach
      endIf

      h += cur_h

      return XY( max_w*scale.x, h )

    method set_height( new_height:Real )
      @scale = XY( new_height / internal_height ) * XY( width_scale, 1.0 )

    method set_is_used( @is_used )

    method set_width_scale( new_factor:Real )
      if local old_factor = @width_scale
        @scale = XY( (@scale.x/old_factor) * new_factor, @scale.y )
      else
        @scale = XY( new_factor, @scale.y )
      endIf

    method unload
      if (not is_loaded) return
      is_loaded = false
      (forEach in character_lookup).image?.unload

    method unload_unused
      if (not is_used) unload

endAugment

class FontCharacter
  PROPERTIES
    unicode    : Character
    image      : Image

    size       : XY
    offset     : XY  # Added to cursor during draw
    advance    : XY  # Added to cursor after drawing
    kerning    : [Character:Int]

  METHODS
    method init( asset:AssetInfo, image_index:Int, unicode:Character, offset:Int, advance:Int, kerning )
      image = TextureImage( asset, image_index )
      init( unicode, image.size )
      if (offset)  this.offset  = XY( offset, 0 )
      if (advance) this.advance = XY( advance, 0 )

    method init( unicode, size )
      advance = size.xv

    method set_image( @image )
      if (image) image.anchor = Anchor.TOP_LEFT
endClass

