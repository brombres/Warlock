library Warlock

augment UI::UI
  METHODS
    method font->Font [replace]
      if (@font) return @font
      if (default_font) return default_font
      return SystemFont

endAugment

augment UI::Event
  METHODS
    method dispatch [propagated,append]
      if (not (this isType Event))
        temporarily Window = window
          window.dispatch( this )
        endTemporarily
      endIf
endAugment

