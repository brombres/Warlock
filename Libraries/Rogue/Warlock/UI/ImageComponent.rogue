library Warlock

class ImageComponent : Component
  PROPERTIES
    image             : Image
    dropshadow_color  = Color( 0x66000000 )
    dropshadow_offset : XY   # proportional to smallest dimension of Display.magnitude

  METHODS
    method init( image, &aspect_fit )
      prior.init
      if (aspect_fit) this.aspect_fit

    method init( asset_name:String )
      local asset = AssetManager.find_image( asset_name )
      if (asset.image_patch_count) init( PatchImage(asset_name) )
      else                         init( Image(asset_name) )

    method aspect_fill
      aspect_fill( image.nominal_size )

    method aspect_fill_height
      aspect_fill_height( image.nominal_size )

    method aspect_fill_width
      aspect_fill_width( image.nominal_size )

    method aspect_fit
      aspect_fit( image.nominal_size )

    method aspect_fit_height
      aspect_fit_height( image.nominal_size )

    method aspect_fit_width
      aspect_fit_width( image.nominal_size )

    method .draw_entity [override]
      if (opacity)
        localize display_bounds

        temporarily image.opacity = opacity
          if (dropshadow_offset != XY(0,0))
            temporarily image.color = dropshadow_color
              image.draw( display_bounds + dropshadow_offset * Display.magnitude )
            endTemporarily
          endIf

          image.draw( display_bounds )
        endTemporarily
      endIf
endClass
