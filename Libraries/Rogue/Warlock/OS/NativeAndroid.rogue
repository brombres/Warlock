library Warlock

class NativeAndroid : Native [essential singleton]
  NATIVE
    nativeHeader
    @|#include <SDL3/SDL_system.h>
     |#include <jni.h>

    nativeCode
    @|extern "C" JNIEXPORT void JNICALL
     |Java_com_perilousquest_warlock_MainActivity_sendMessage(
     |  JNIEnv* env, jclass cls, jstring json_arg )
     |{
     |  RogueString* json = 0;
     |
     |  if (json_arg)
     |  {
     |    const char* json_utf8 = env->GetStringUTFChars( json_arg, 0 );
     |    json = RogueString_create( json_utf8 );
     |    env->ReleaseStringUTFChars( json_arg, json_utf8 );
     |  }
     |
     |  ROGUE_RETAIN( json );
     |
     |  RogueWarlockNativeAndroid__receive_message__RogueString(
     |    ROGUE_SINGLETON(RogueWarlockNativeAndroid),
     |    json
     |  );
     |
     |  ROGUE_RELEASE( json );
     |}

  METHODS
    method init_object
      Native = this

    method receive_message( message:String )->String [essential]
      receive_message( JSON.parse(message,&error_log=Log) )

    method send_message( message:Variant ) [override]
      local arg_json = message->JSON

      native
      @|JNIEnv* env = (JNIEnv*)SDL_GetAndroidJNIEnv();
       |jclass  activityClass = 0;
       |jstring jArg    = 0;
       |jstring jResult = 0;
       |
       |for (;;)
       |{
       |  if ( !env ) break;
       |
       |  jobject activity = (jobject)SDL_GetAndroidActivity();
       |  if ( !activity ) break;
       |
       |  // Get the Activity class
       |  activityClass = env->GetObjectClass( activity );
       |  if ( !activityClass ) break;
       |
       |  // Find the method: String receiveMessage(String)
       |  jmethodID method_id = env->GetMethodID(
       |      activityClass,
       |      "receiveMessage",
       |      "(Ljava/lang/String;)V"
       |  );
       |  if ( !method_id ) break;
       |
       |  // Convert C UTF-8 -> Java String
       |  jArg = env->NewStringUTF( $arg_json->data->as_utf8 );
       |  if ( !jArg ) break;
       |
       |  // Call activity.receiveMessage(arg)
       |  env->CallVoidMethod( activity, method_id, jArg );
       |
       |  break;
       |}
       |
       |if (jResult) env->DeleteLocalRef( jResult );
       |if (jArg)    env->DeleteLocalRef( jArg );
       |if (activityClass) env->DeleteLocalRef( activityClass );

endClass
