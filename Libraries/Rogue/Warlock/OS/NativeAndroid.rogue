library Warlock

class NativeAndroid : Native [essential singleton]
  NATIVE
    nativeHeader
    @|#include <SDL3/SDL_system.h>
     |#include <jni.h>
     |#include <string.h>
     |#include <ctype.h>


    nativeCode
    @|extern "C" JNIEXPORT void JNICALL
     |Java_com_perilousquest_warlock_MainActivity_sendMessage(
     |  JNIEnv* env, jclass cls, jstring json_arg )
     |{
     |  RogueString* json = 0;
     |
     |  if (json_arg)
     |  {
     |    const char* json_utf8 = env->GetStringUTFChars( json_arg, 0 );
     |    json = RogueString_create( json_utf8 );
     |    env->ReleaseStringUTFChars( json_arg, json_utf8 );
     |  }
     |
     |  ROGUE_RETAIN( json );
     |
     |  RogueWarlockNativeAndroid__receive_message__RogueString(
     |    ROGUE_SINGLETON(RogueWarlockNativeAndroid),
     |    json
     |  );
     |
     |  ROGUE_RELEASE( json );
     |}

  METHODS
    method init_object
      Native = this

    method generate_uuid->String
      local result = String( "01234567-89AB-CDEF-0123-456789ABCDEF" ) # default result which will be overwritten on success

      native
      @|JNIEnv* env = (JNIEnv*)SDL_GetAndroidJNIEnv();
       |
       |for (;;)
       |{
       |  // Get the UUID class
       |  jclass uuidClass = env->FindClass( "java/util/UUID" );
       |  if (uuidClass == NULL) break;
       |
       |  // Get the static randomUUID() method
       |  jmethodID randomUUIDMethod = env->GetStaticMethodID( uuidClass, "randomUUID", "()Ljava/util/UUID;" );
       |  if (randomUUIDMethod == NULL) break;
       |
       |  // Call UUID.randomUUID()
       |  jobject uuidObject = env->CallStaticObjectMethod( uuidClass, randomUUIDMethod );
       |  if (uuidObject == NULL) break;
       |
       |  // Get the toString() method
       |  jmethodID toStringMethod = env->GetMethodID( uuidClass, "toString", "()Ljava/lang/String;" );
       |  if (toStringMethod == NULL) break;
       |
       |  // Call toString() on the UUID object
       |  jstring javaString = (jstring)env->CallObjectMethod( uuidObject, toStringMethod );
       |  if (javaString == NULL) break;
       |
       |  // Convert Java string to C string
       |  const char* utf8String = env->GetStringUTFChars( javaString, NULL );
       |  if (utf8String == NULL) break;
       |
       |  strcpy( $result->data->as_utf8, utf8String );
       |
       |  // Release the Java string
       |  env->ReleaseStringUTFChars( javaString, utf8String );
       |
       |  break;
       |}

     return result.to_uppercase

    method receive_message( message:String )->String [essential]
      receive_message( JSON.parse(message,&error_log=Log) )

    method send_message( message:Variant ) [override]
      local arg_json = message->JSON

      native
      @|JNIEnv* env = (JNIEnv*)SDL_GetAndroidJNIEnv();
       |jclass  activityClass = 0;
       |jstring jArg    = 0;
       |jstring jResult = 0;
       |
       |for (;;)
       |{
       |  if ( !env ) break;
       |
       |  jobject activity = (jobject)SDL_GetAndroidActivity();
       |  if ( !activity ) break;
       |
       |  // Get the Activity class
       |  activityClass = env->GetObjectClass( activity );
       |  if ( !activityClass ) break;
       |
       |  // Find the method: String receiveMessage(String)
       |  jmethodID method_id = env->GetMethodID(
       |      activityClass,
       |      "receiveMessage",
       |      "(Ljava/lang/String;)V"
       |  );
       |  if ( !method_id ) break;
       |
       |  // Convert C UTF-8 -> Java String
       |  jArg = env->NewStringUTF( $arg_json->data->as_utf8 );
       |  if ( !jArg ) break;
       |
       |  // Call activity.receiveMessage(arg)
       |  env->CallVoidMethod( activity, method_id, jArg );
       |
       |  break;
       |}
       |
       |if (jResult) env->DeleteLocalRef( jResult );
       |if (jArg)    env->DeleteLocalRef( jArg );
       |if (activityClass) env->DeleteLocalRef( activityClass );

endClass
