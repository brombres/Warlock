$include Warlock/OS/NativeAndroid [target("Android")]

class Native [singleton]
  PROPERTIES
    message_handlers          = [String:Function(Variant)]
    one_time_message_handlers = [String:Function(Variant)]

  METHODS
    method on_message( id:String, handler:Function(Variant), &once )
      if (once)
        one_time_message_handlers[id] = handler
      else
        message_handlers[id] = handler
      endIf

    method on_message( id:String, handler:Function, &once )
      if (once)
        one_time_message_handlers[id] = (args) => handler()
      else
        message_handlers[id] = (args) => handler()
      endIf

    method on_response( id:String, handler:Function(Variant) )
      on_message( id, handler, &once )

    method receive_message( message:Variant )
      if local handler = message_handlers[ message//id ]
        handler( message )
      else
        if local entry = one_time_message_handlers.find( message//id )
          one_time_message_handlers.remove( entry )
          entry.value( message )
        else
          Log.print   "No native message handler for "
          Log.println message//id
        endIf
      endIf

    method send_message( message:Variant )
      println "Native.send_message(Variant) is not defined for $."(System.os)

    method send_message( id:String, message:Variant, on_response:Function(Variant) )
      message//id = id

      if (on_response)
        local response_id = message//response_id || Variant("$.response"(id))
        message//response_id = response_id
        this.on_response( response_id, on_response )
      endIf

      send_message( message )

    method send_message( id:String )
      send_message( id, @{}, null )

    method send_message( id:String, message:Variant )
      send_message( id, message, null )

    method send_message( id:String, on_response:Function(Variant) )
      send_message( id, @{}, on_response )

endClass
