library Warlock

class WarlockController
  METHODS
    method configure
      AssetManager.load
      AudioManager.configure

      if (Warlock.windows.is_empty) create_default_window

    method create_default_window
      Window( Warlock.app_name, 1280, 720 )

    method tick
      begin_tick

      update_audio

      begin_update
      update
      end_update

      begin_draw
      draw
      end_draw

      end_tick

    method begin_tick
      OverlayLog.update
      begin_tick( forEach in Warlock.windows )

    method begin_tick( window:Window )
      window.begin_tick

    method update_audio
      AudioManager.update

    method begin_update

    method update
      if (Warlock.actions) Warlock.actions .= updated

      State = State.updated || State()
      Screen = Screen.updated || Screen()

    method end_update

    method begin_draw
      State.on_begin_render

    method draw
      handle_render( forEach in Warlock.windows )

    method end_draw
      State.on_end_render

    method handle_render( window:Window )
      Window = window
      begin_render( window )
      render( window )
      end_render( window )

    method begin_render( window:Window )
      window.begin_render

    method render( window:Window )
      window.render

    method end_render( window:Window )
      window.end_render

    method end_tick( window:Window )
      window.end_tick

    method end_tick
      ++Warlock.frames
      end_tick( forEach in Warlock.windows )

endClass
