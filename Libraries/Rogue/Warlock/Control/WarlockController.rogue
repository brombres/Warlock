library Warlock

class WarlockController
  PROPERTIES
    app_name     = "Warlock"  # redefine in extended WarlockController
    launch_state = State()    # redefine in extended WarlockController

  METHODS
    method configure
      AssetManager.load
      AudioManager.configure

      UI.display_density = () => Window.density

      if (Warlock.windows.is_empty) create_default_window( launch_state )
      restore_state
      handle_launch

    method create_default_window( initial_state:State )
      Window( app_name, 1280, 720, initial_state )

    method on_deep_link( url:String )
      noAction

    method handle_app_exit
      save_state
      on_app_exit

    method handle_app_pause
      # Only happens on iOS & Android
      save_state
      on_app_pause

    method handle_app_resume
      # Only happens on iOS & Android
      AudioManager.resume( &backgrounded )
      (forEach in Warlock.windows).handle_app_resume
      on_app_resume

    method handle_focus_gained( window:Window )
      on_focus_gained( window )

    method handle_focus_lost( window:Window )
      on_focus_lost( window )

    method handle_launch
      on_launch

    method load_state( file:File )->Variant
      return JSON.parse( String(file) )

    method on_app_exit
      noAction

    method on_app_pause
      # Only happens on iOS & Android
      noAction

    method on_app_resume
      # Only happens on iOS & Android
      noAction

    method on_dock_icon_clicked
      # Only happens on macOS
      noAction

    method on_focus_gained
      noAction

    method on_focus_gained( window:Window )
      on_focus_gained

    method on_focus_lost
      noAction

    method on_focus_lost( window:Window )
      on_focus_lost

    method on_launch
      noAction

    method on_restore_state
      # Restore game state from AppData
      noAction

    method on_save_state
      # Save game state to AppData
      noAction

    method restore_state
      local save_path = Warlock.application_data_folder/app_name/"SaveState.bin"
      if (Warlock.dev_mode)
        Log.println "Restoring $"(save_path)
      endIf
trace save_path
trace File(save_path).exists
      AppData.data = load_state( save_path ) || @{}
trace AppData.data
      AppData.data .= xorint_encoded  # internally converts Int->XorInt to hide vars from runtime memory scanners
      on_restore_state

    method save_state( state:Variant, file:File )
      file.save( state->JSON(&formatted) )

    method save_state
      on_save_state
      local folder = Warlock.application_data_folder / app_name
      folder.create_folder
      save_state( AppData.data, folder/"SaveState.bin" )

    method tick
      begin_tick

      forEach (window in Warlock.windows)
        tick( window )
      endForEach

      end_tick

    method begin_tick
      OverlayLog.update
      update_audio
      Framework.update
      Pointer.update
      if (Warlock.actions) Warlock.actions .= updated

    method update_audio
      AudioManager.update

    method tick( window:Window )
      window.begin_tick  # includes setting singleton 'Window = window'
      if (window.size != window.old_size)
        on_resize( window )
        window.old_size = window.size
      endIf

      begin_update
      update
      end_update

      begin_draw
      draw
      end_draw

      window.end_tick

    method on_resize
      noAction

    method on_resize( window:Window )
      on_resize

    method begin_update
      noAction

    method update
      Window.dispatch_update

    method end_update
      noAction

    method begin_draw
      Window.begin_render

    method draw
      Window.dispatch_draw

    method end_draw
      Window.end_render

    method end_tick
      ++Warlock.ticks


endClass
