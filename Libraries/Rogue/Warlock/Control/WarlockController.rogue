library Warlock

class WarlockController
  METHODS
    method configure
      AssetManager.load
      AudioManager.configure

      if (Warlock.windows.is_empty) create_default_window

    method create_default_window
      Window( Warlock.app_name, 1280, 720 )

    method tick
      on_tick_begin
      update
      render
      on_tick_end

    method on_tick_begin
      OverlayLog.update
      on_tick_begin( forEach in Warlock.windows )

    method update
      on_update_begin
      on_update
      on_update_end

    method on_update_begin

    method on_update
      if (Warlock.actions) Warlock.actions .= updated

      State = State.updated || State()
      Screen = Screen.updated || Screen()

    method on_update_end

    method render
      on_render_begin
      on_render
      on_render_end

    method on_render_begin
      State.on_render_begin

    method on_render
      render( forEach in Warlock.windows )

    method on_render_end
      State.on_render_end

    method on_tick_begin( window:Window )
      window.begin_tick

    method render( window:Window )
      on_render_begin( window )
      on_render( window )
      on_render_end( window )

    method on_render_begin( window:Window )
      window.begin_render

    method on_render( window:Window )
      window.render

    method on_render_end( window:Window )
      window.end_render

    method on_tick_end( window:Window )
      window.end_tick

    method on_tick_end
      ++Warlock.frames
      on_tick_end( forEach in Warlock.windows )

endClass
