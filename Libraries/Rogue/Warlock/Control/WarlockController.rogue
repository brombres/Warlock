library Warlock

class WarlockController
  PROPERTIES
    app_name     = "Warlock"  # redefine in extended WarlockController
    launch_state = State()    # redefine in extended WarlockController

  METHODS
    method configure
      AssetManager.load
      AudioManager.configure

      if (Warlock.windows.is_empty) create_default_window
      restore_state
      on_launch

    method create_default_window
      Window( app_name, 1280, 720, launch_state )

    method tick
      begin_tick

      forEach (window in Warlock.windows)
        tick( window )
      endForEach

      end_tick

    method begin_tick
      OverlayLog.update
      update_audio
      if (Warlock.actions) Warlock.actions .= updated

    method update_audio
      AudioManager.update

    method tick( window:Window )
      window.begin_tick  # includes setting singleton 'Window = window'

      begin_update
      update
      end_update

      begin_draw
      draw
      end_draw

      window.end_tick

    method begin_update
      noAction

    method update
      # Update the current window state and screen
      Window.state = Window.state.updated || State()
      Window.screen = Window.screen.updated || Screen()

    method end_update
      noAction

    method begin_draw
      Window.begin_render

    method draw
      Window.render

    method end_draw
      Window.end_render

    method end_tick
      ++Warlock.frames

    method handle_app_exit
      save_state
      on_app_exit

    method handle_app_pause
      # Only happens on iOS & Android
      save_state
      on_app_pause

    method handle_app_resume
      # Only happens on iOS & Android
      restore_state
      on_app_resume

    method handle_focus_gained( window:Window )
      on_focus_gained( window )

    method handle_focus_lost( window:Window )
      on_focus_lost( window )

    method load( file:File )->String
      return String( file )

    method on_app_exit
      noAction

    method on_app_pause
      # Only happens on iOS & Android
      noAction

    method on_app_resume
      # Only happens on iOS & Android
      noAction

    method on_dock_icon_clicked
      # Only happens on macOS
      noAction

    method on_focus_gained
      noAction

    method on_focus_gained( window:Window )
      on_focus_gained

    method on_focus_lost
      noAction

    method on_focus_lost( window:Window )
      on_focus_lost

    method on_launch
      noAction

    method on_restore_state
      # Restore game state from AppData
      noAction

    method on_save_state
      # Save game state to AppData
      noAction

    method restore_state
      AppData.data = JSON.parse(
        load( Warlock.application_data_folder/app_name/"SaveState.bin" )
      ) || @{}
      on_restore_state

    method save( data:String, file:File )
      file.save( data )

    method save_state
      on_save_state
      local folder = Warlock.application_data_folder / app_name
      folder.create_folder
      save( AppData.data->JSON, folder/"SaveState.bin" )


endClass
