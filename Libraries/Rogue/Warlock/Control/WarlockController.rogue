library Warlock

class WarlockController
  METHODS
    method configure
      AssetManager.load
      AudioManager.configure

      if (Warlock.windows.is_empty) create_default_window

    method create_default_window
      Window( Warlock.app_name, 1280, 720 )

    method tick
      begin_tick

      begin_update
      update
      end_update

      begin_render
      render
      end_render

      end_tick

    method begin_tick
      OverlayLog.update
      begin_tick( forEach in Warlock.windows )

    method begin_tick( window:Window )
      window.begin_tick

    method begin_update

    method update
      if (Warlock.actions) Warlock.actions .= updated

      State = State.updated || State()
      Screen = Screen.updated || Screen()

    method end_update

    method begin_render
      State.on_render_begin

    method render
      render( forEach in Warlock.windows )

    method end_render
      State.on_render_end

    method render( window:Window )
      begin_render( window )
      on_render( window )
      end_render( window )

    method begin_render( window:Window )
      window.begin_render

    method on_render( window:Window )
      window.render

    method end_render( window:Window )
      window.end_render

    method end_tick( window:Window )
      window.end_tick

    method end_tick
      ++Warlock.frames
      end_tick( forEach in Warlock.windows )

endClass
