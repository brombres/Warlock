library Warlock

class WarlockController
  METHODS
    method configure
      AssetManager.load
      AudioManager.configure

      if (Warlock.windows.is_empty) create_default_window

    method create_default_window
      Window( Warlock.app_name, 1280, 720, Warlock.launch_state )

    method tick
      begin_tick

      forEach (window in Warlock.windows)
        tick( window )
      endForEach

      end_tick

    method begin_tick
      OverlayLog.update
      update_audio
      if (Warlock.actions) Warlock.actions .= updated

    method update_audio
      AudioManager.update

    method tick( window:Window )
      window.begin_tick  # includes setting singleton 'Window = window'

      begin_update
      update
      end_update

      begin_draw
      draw
      end_draw

      window.end_tick

    method begin_update
      noAction

    method update
      # Update the current window state and screen
      Window.state = Window.state.updated || State()
      Window.screen = Window.screen.updated || Screen()

    method end_update
      noAction

    method begin_draw
      Window.begin_render

    method draw
      Window.render

    method end_draw
      Window.end_render

    method end_tick
      ++Warlock.frames

    method on_app_exit

    method on_app_pause
      # Only happens on iOS & Android

    method on_app_resume
      # Only happens on iOS & Android

    method on_dock_icon_clicked
      # Only happens on macOS

    method on_focus_gained

    method on_focus_gained( window:Window )
      on_focus_gained

    method on_focus_lost

    method on_focus_lost( window:Window )
      on_focus_lost

endClass
