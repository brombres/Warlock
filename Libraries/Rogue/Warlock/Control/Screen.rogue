library Warlock

class Screen : Rogue::State<<Screen,change_screen,exit_screen>>, WarlockState [singleton]
  PROPERTIES
    ui : WarlockUI

  METHODS
    method dispatch( e:KeyEvent )
      e.window.handle( e )
      if (@ui) @ui.handle( e )

    method dispatch( e:PointerEvent )
      e.window.handle( e )
      if (@ui) @ui.handle( e )

    method dispatch( e:ScrollEvent )
      e.window.handle( e )
      if (@ui) @ui.handle( e )

    method dispatch( e:TextEvent )
      e.window.handle( e )
      if (@ui) @ui.handle( e )

    method dispatch_draw( &fg )
      if (not fg)
        Display.draw
        if (@ui)
          @ui.draw
        endIf
      endIf

    method dispatch_update
      Display.update
      if (@ui)
        @ui.update( Display.bounds )
        @ui.request_redraw
      endIf

    method ui->UI
      if (@ui) return @ui
      ui = WarlockUI()
      return @ui

endClass
