library Warlock

class Screen : Rogue::ProgressState<<Screen,change_screen>>, WarlockState
  METHODS
    method change_environment( new_environment:Environment )
      Window.environment.change_environment( new_environment )

    method change_state( new_state:State )
      Window.state.change_state( new_state )

    method dispatch( e:KeyEvent )
      Window.environment.handle( e )

    method dispatch( e:MultitouchEvent )
      Window.environment.handle( e )

    method dispatch( e:PointerEvent )
      Window.environment.handle( e )

    method dispatch( e:ScrollEvent )
      Window.environment.handle( e )

    method dispatch( e:TextEvent )
      Window.environment.handle( e )

    method dispatch_find( id:GlobalID, arg=undefined:Variant, &up )->Variant
      if (up) return Window.state.find( id, arg )
      else    return Window.environment.find( id, arg )

    method dispatch_draw( &fg )
      Window.environment.draw( &=fg )

    method environment->Environment
      return Window.environment

    method exit_screen
      exit

    method state->State
      return Window.state

    method .get_top_level_state->Screen [override]
      return Window.screen

    method .set_top_level_state( screen:Screen ) [override]
      Window.screen = screen
endClass
