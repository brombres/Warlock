library Warlock

class Screen : Rogue::State<<Screen,change_screen,exit_screen>>, WarlockState [singleton]
  PROPERTIES
    ui_layer : Component

  METHODS
    method dispatch( e:KeyEvent )
      e.window.handle( e )

    method dispatch( e:PointerEvent )
      e.window.handle( e )

    method dispatch( e:ScrollEvent )
      e.window.handle( e )

    method dispatch( e:TextEvent )
      e.window.handle( e )

    method dispatch_draw( &fg )
      if (not fg)
        Display.draw
      endIf

    method dispatch_update
      Display.update

    method set_ui_layer( new_ui_layer:Component )
      local existing_ui = @ui_layer?
      @ui_layer = new_ui_layer
      Display.update_ui_layering

    method start [override]
      # Internal use
      Screen = this
      Display.update_ui_layering
      prior.start

    method ui_layer->Component
      if (@ui_layer) return @ui_layer
      ui_layer = Component()
      return @ui_layer

endClass
