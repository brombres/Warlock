library Warlock

class Screen : Rogue::State<<Screen,change_screen,exit_screen>>, WarlockState [singleton]
  METHODS
    method dispatch( e:KeyEvent )
      e.window.handle( e )

    method dispatch( e:PointerEvent )
      e.window.handle( e )

    method dispatch( e:ScrollEvent )
      e.window.handle( e )

    method dispatch( e:TextEvent )
      e.window.handle( e )

    method dispatch_draw( &fg )
      if (not fg)
        Display.draw
      endIf

    method dispatch_update
      Display.update

endClass
