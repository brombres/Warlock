library Warlock

class AssetLoadingState : State
  PROPERTIES
    pending_audio        = Sound[]
    pending_textures     = TextureInfo[]
    loaded_asset_count   : Int
    total_asset_count    : Int
    current_image_decode : ImageDecodeJob
    current_texture_info : TextureInfo
    current_bitmap       : Bitmap
    current_mipmap       : Bitmap
    mipmap_pixels        : Color[]
    is_loading_finished  : Logical
    update_timer         = Timer()

  METHODS
    method clear
      pending_audio.clear
      pending_textures.clear
      total_asset_count = 0

    method exclude( audio:Sound )
      if (not audio) return

      if local index = pending_audio.locate( audio )
        pending_audio.remove_at( index )
        --total_asset_count
      endIf

    method exclude( audio:Music[] )
      exclude( forEach in audio )

    method exclude( audio:Sound[] )
      exclude( forEach in audio )

    method exclude( audio:SoundVariants )
      exclude( forEach in audio )

    method exclude( font:Font )
      forEach (ch in font.character_lookup)
        exclude( ch.image )
      endForEach

    method exclude( image:Image )
      if (not image) return

      if local asset = image.asset
        if (asset.images)
          forEach (image_info in asset.images)
            local filepath = AssetManager.texture_filepaths[ image_info.texture_index ]
            if local index = pending_textures.locate( (info) => info.filepath == filepath )
              pending_textures.remove_at( index )
              --total_asset_count
            endIf
          endForEach
        endIf
      endIf

    method exclude( images:Image[] )
      exclude( forEach in images )

    method exclude( patch_image:PatchImage )
      exclude( forEach in patch_image.patches )

    method include( audio:Sound )
      if (not audio) return

      if (not pending_audio.locate(audio))
        pending_audio.add( audio )
        ++total_asset_count
      endIf

    method include( audio:Music[] )
      include( forEach in audio )

    method include( audio:Sound[] )
      include( forEach in audio )

    method include( audio:SoundVariants )
      include( forEach in audio )

    method include( font:Font )
      forEach (ch in font.character_lookup)
        include( ch.image )
      endForEach

    method include( image:Image )
      if (not image) return

      if local asset = image.asset
        if (asset.images)
          forEach (image_info in asset.images)
            local filepath = AssetManager.texture_filepaths[ image_info.texture_index ]
            if (not pending_textures.locate( (info) => info.filepath == filepath ))
              pending_textures.add( TextureInfo(filepath, &mipmaps=asset.image_mipmaps, &wrap=asset.texture_wrap) )
              ++total_asset_count
            endIf
          endForEach
        endIf
      endIf

    method include( images:Image[] )
      include( forEach in images )

    method include( patch_image:PatchImage )
      include( forEach in patch_image.patches )

    method loading_progress->Real
      return loaded_asset_count->Real / total_asset_count

    method on_start [critical]
      forEach (audio in AudioManager.all_audio)
        if (not audio.is_prepared) pending_audio.add( audio )
      endForEach

      forEach (texture_info in AssetManager.texture_info.to_list)
        if local filepath = Warlock.find_asset( texture_info.filepath )
          if (not AssetManager.textures[filepath])
            pending_textures.add( texture_info )
          endIf
        endIf
      endForEach

      total_asset_count = pending_audio.count + pending_textures.count

    method on_loading_finished
      exit

    method on_update [critical]
      if (not is_loading_finished)
        loop Window.delta_ticks
          if (not load_more)
            is_loading_finished = true
            on_loading_finished
            escapeLoop
          endIf
        endLoop
      endIf

    method load_more->Logical [critical]
      if (current_image_decode)
        if (current_image_decode.is_finished)
          @trace "FINISHED"
          current_image_decode = null
          ++loaded_asset_count
        endIf

      elseIf (current_mipmap)
        ++loaded_asset_count
        ++total_asset_count

        local w = current_mipmap.width
        local h = current_mipmap.height
        local first = true

        while (first) # or (w*h <= 512*512))
          first = false
          mipmap_pixels.add( current_mipmap.pixels )

          if (w > 1 or h > 1)
            if (w > 1) w :>>>:= 1
            if (h > 1) h :>>>:= 1
            current_mipmap.resize( w, h )
          else
            Texture( current_bitmap, mipmap_pixels, &wrap=current_texture_info.wrap )
            current_bitmap = null
            current_mipmap = null
            mipmap_pixels = null
            return true
          endIf
        endWhile

      elseIf (current_bitmap)
        current_mipmap = current_bitmap.cloned
        current_mipmap.swap_red_and_blue
        current_mipmap.premultiply_alpha
        current_mipmap.expand_to_power_of_2

        local w = current_mipmap.width
        local h = current_mipmap.height
        local total_pixel_count = 1  # count final 1x1
        while (w > 1 or h > 1)
          total_pixel_count += w * h
          if (w > 1) w :>>>:= 1
          if (h > 1) h :>>>:= 1
        endWhile

        mipmap_pixels = Color[]( total_pixel_count )

        ++loaded_asset_count
        ++total_asset_count

      elseIf (pending_textures.count)
        current_image_decode = ImageDecodeJob( pending_textures.remove_last )
        #{
        local info = pending_textures.remove_last
        if local filepath = Warlock.find_asset( info.filepath )
          current_texture_info = info
          local bytes = Byte[]( filepath )
          Async.decode_image_to_mipmapped_texture_data( info, bytes )
          current_bitmap = Bitmap( bytes )
        endIf
        ++loaded_asset_count
        }#

      elseIf (pending_audio.count)
        update_timer.restart
        while (pending_audio.count and update_timer.elapsed < 0.010)
          pending_audio.remove_last.load
          ++loaded_asset_count
        endWhile

      else
        loaded_asset_count = total_asset_count  # Ensuring but should already be true
        return false

      endIf

      return true
endClass
