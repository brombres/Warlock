library Warlock

class WarlockState [aspect]
  PROPERTIES
    actions : Action
    ui      : UI

  METHODS
    method dispatch( e:KeyEvent )
      noAction

    method dispatch( e:PointerEvent )
      noAction

    method dispatch( e:ScrollEvent )
      noAction

    method dispatch( e:TextEvent )
      noAction

    method dispatch_draw( &fg )
      noAction

    method dispatch_update
      noAction

    method draw( &fg )
      if (fg)
        dispatch_draw( &fg )
        on_draw_fg
        local cur = actions
        while (cur)
          cur.on_draw_fg
          cur .= concurrent_state
        endWhile
      else
        local cur = actions
        while (cur)
          cur.on_draw
          cur .= concurrent_state
        endWhile

        on_draw

        dispatch_draw( &!fg )

        on_draw_ui

        if (@ui) ui.draw
      endIf

    method handle( e:KeyEvent )
      contingent
        on_intercept( e )
        necessary (not e.is_consumed)

        if (@ui)
          @ui.handle( e )
          necessary (not e.is_consumed)
        endIf

        on( e )
        necessary (not e.is_consumed)

        dispatch( e )
        necessary (not e.is_consumed)

        on_unhandled( e )
      endContingent

    method handle( e:PointerEvent )
      contingent
        on_intercept( e )
        necessary (not e.is_consumed)

        if (@ui)
          @ui.handle( e )
          necessary (not e.is_consumed)
        endIf

        on( e )
        necessary (not e.is_consumed)

        dispatch( e )
        necessary (not e.is_consumed)

        on_unhandled( e )
      endContingent

    method handle( e:ScrollEvent )
      contingent
        on_intercept( e )
        necessary (not e.is_consumed)

        if (@ui)
          @ui.handle( e )
          necessary (not e.is_consumed)
        endIf

        on( e )
        necessary (not e.is_consumed)

        dispatch( e )
        necessary (not e.is_consumed)

        on_unhandled( e )
      endContingent

    method handle( e:TextEvent )
      contingent
        on_intercept( e )
        necessary (not e.is_consumed)

        if (@ui)
          @ui.handle( e )
          necessary (not e.is_consumed)
        endIf

        on( e )
        necessary (not e.is_consumed)

        dispatch( e )
        necessary (not e.is_consumed)

        on_unhandled( e )
      endContingent

    method on( e:KeyEvent )

    method on( e:PointerEvent )

    method on( e:ScrollEvent )

    method on( e:TextEvent )

    method on_draw

    method on_draw_fg

    method on_draw_ui

    method on_begin_render

    method on_end_render

    method on_intercept( e:KeyEvent )

    method on_intercept( e:PointerEvent )

    method on_intercept( e:ScrollEvent )

    method on_intercept( e:TextEvent )

    method on_unhandled( e:KeyEvent )

    method on_unhandled( e:PointerEvent )

    method on_unhandled( e:ScrollEvent )

    method on_unhandled( e:TextEvent )

    method ui->UI
      if (@ui) return @ui
      ui = UI()
      return @ui

    method update [override]
      actions = actions?.updated
      prior.update
      if (@ui) @ui.update( Display.bounds )
      dispatch_update

endClass
