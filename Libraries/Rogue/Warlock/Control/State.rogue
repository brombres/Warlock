library Warlock

class State : Rogue::ProgressState<<State,change_state,exit_state>>, WarlockState [singleton]
  PROPERTIES
    ui : WarlockUI

  METHODS
    method dispatch( e:KeyEvent )
      Screen.handle( e )
      if (@ui) @ui.handle( e )

    method dispatch( e:PointerEvent )
      Screen.handle( e )
      if (@ui) @ui.handle( e )

    method dispatch( e:ScrollEvent )
      Screen.handle( e )
      if (@ui) @ui.handle( e )

    method dispatch( e:TextEvent )
      Screen.handle( e )
      if (@ui) @ui.handle( e )

    method dispatch_draw( &fg )
      Screen.draw( &=fg )

      if (not fg)
        if (@ui)
          @ui.draw
        endIf
      endIf

    method ui->UI
      if (@ui) return @ui
      ui = WarlockUI()
      return @ui

    method update [override]
      prior.update
      if (@ui)
        @ui.update( Display.bounds )
        @ui.request_redraw
      endIf

endClass
