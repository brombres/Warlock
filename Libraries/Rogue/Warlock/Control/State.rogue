library Warlock

class State : Rogue::ProgressState<<State,change_state,exit_state>>, WarlockState [singleton]
  PROPERTIES
    ui_layer : Component

  METHODS
    method dispatch( e:KeyEvent )
      Screen.handle( e )

    method dispatch( e:PointerEvent )
      Screen.handle( e )

    method dispatch( e:ScrollEvent )
      Screen.handle( e )

    method dispatch( e:TextEvent )
      Screen.handle( e )

    method dispatch_draw( &fg )
      Screen.draw( &=fg )

      if (not fg)
        if (@ui_layer)
          @ui_layer.draw
        endIf
      endIf

    method set_ui_layer( new_ui_layer:Component )
      local existing_ui = @ui_layer?
      @ui_layer = new_ui_layer
      Display.update_ui_layering

    method start [override]
      # Internal use
      State = this
      Display.update_ui_layering
      prior.start

    method ui_layer->Component
      if (@ui_layer) return @ui_layer
      ui_layer = Component()
      return @ui_layer

endClass
