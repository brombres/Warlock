library Warlock

class State : Rogue::ProgressState<<State,change_state,exit_state>>, WarlockState [singleton]
  METHODS
    method dispatch( e:KeyEvent )
      Screen.handle( e )

    method dispatch( e:PointerEvent )
      Screen.handle( e )

    method dispatch( e:ScrollEvent )
      Screen.handle( e )

    method dispatch( e:TextEvent )
      Screen.handle( e )

    method dispatch_find( id:GlobalID, arg=undefined:Variant, &up )->Variant
      if (not up) return Screen.find( id, arg )

    method dispatch_draw( &fg )
      Screen.draw( &=fg )

      if (not fg)
        if (@ui)
          @ui.draw
        endIf
      endIf

endClass
