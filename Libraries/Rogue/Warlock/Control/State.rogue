library Warlock

class State : Rogue::ProgressState<<State,change_state,exit_state>>, WarlockState
  METHODS
    method change_screen( new_screen:Screen )
      Window.screen.change_screen( new_screen )

    method dispatch( e:KeyEvent )
      Window.screen.handle( e )

    method dispatch( e:MultitouchEvent )
      Window.screen.handle( e )

    method dispatch( e:PointerEvent )
      Window.screen.handle( e )

    method dispatch( e:ScrollEvent )
      Window.screen.handle( e )

    method dispatch( e:TextEvent )
      Window.screen.handle( e )

    method dispatch_find( id:GlobalID, arg=undefined:Variant, &up )->Variant
      if (not up) return Window.screen.find( id, arg )

    method dispatch_draw( &fg )
      Window.screen.draw( &=fg )

      if (not fg)
        if (@ui)
          @ui.draw
        endIf
      endIf

endClass
