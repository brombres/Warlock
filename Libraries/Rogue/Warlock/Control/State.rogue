library Warlock

class State : Rogue::ProgressState<<State,change_state,exit_state>>, WarlockState [singleton]
  PROPERTIES
    ui : Component

  METHODS
    method dispatch( e:KeyEvent )
      Screen.handle( e )

    method dispatch( e:PointerEvent )
      Screen.handle( e )

    method dispatch( e:ScrollEvent )
      Screen.handle( e )

    method dispatch( e:TextEvent )
      Screen.handle( e )

    method dispatch_draw( &fg )
      Screen.draw( &=fg )

      if (not fg)
        if (@ui)
          @ui.draw
        endIf
      endIf

    method set_ui( new_ui:Component )
      local existing_ui = @ui?
      @ui = new_ui
      Display.update_ui_layering

    method start [override]
      # Internal use
      State = this
      Display.update_ui_layering
      prior.start

    method ui->Component
      if (@ui) return @ui
      ui = Component()
      return @ui

endClass
