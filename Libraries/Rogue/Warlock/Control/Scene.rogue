library Warlock

class Scene : Rogue::ActiveState<<Scene>>, WarlockState<<State>>
  METHODS
    method change_scene( new_scene:Scene )
      change( new_scene )

    method change_screen( new_screen:Screen )
      Window.screen.change_state( new_screen )

    method change_state( new_state:State )
      Window.state.change_state( new_state )

    method dispatch( e:KeyEvent )
      e.window.handle( e )

    method dispatch( e:MultitouchEvent )
      e.window.handle( e )

    method dispatch( e:PointerEvent )
      e.window.handle( e )

    method dispatch( e:ScrollEvent )
      e.window.handle( e )

    method dispatch( e:TextEvent )
      e.window.handle( e )

    method dispatch_draw( &fg )
      if (not fg)
        Display.draw
      endIf

    method dispatch_find( id:GlobalID, arg=undefined:Variant, &up )->Variant
      if (up) return Window.screen.find( id, arg, &up )
      else    return Window.find( id, arg )

    method dispatch_update
      Display.update

    method exit_screen
      exit

    method mark_modified
      Window.is_scene_modified = true

    method screen->Screen
      return Window.screen

    method state->State
      return Window.state

    method .get_top_level_state->Scene [override]
      return Window.scene

    method .set_top_level_state( scene:Scene ) [override]
      Window.scene = scene
endClass
