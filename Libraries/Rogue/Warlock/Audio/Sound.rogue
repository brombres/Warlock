library Warlock

class Sound
  PROPERTIES
    filepath         : String
    is_prepared      : Logical
    is_configured    : Logical
    is_music         : Logical
    is_looping       : Logical
    is_concurrent    : Logical  # only has an effect for Music
    is_paused        : Logical
    is_suspended     : Logical
    configuration_id : Int  # must match AudioManager.configuraton_id or else reload()
    volume           = 1.0  # volume when sound first starts playing
    current_volume   : Real # dynamically adjusted volume from fades etc.
    native "ma_sound sound;"

    next_in_pool   : Sound
    rate_limit     : Timer # shared with pool, if present

  METHODS
    method init( filepath, pool_count=1:Int )
      if (pool_count > 1)
        next_in_pool = Sound( filepath, pool_count - 1 )
      endIf

    method init_object
      AudioManager.all_audio.add( this )
      @current_volume = 1.0

    method on_cleanup
      unload

    method concurrent
      is_concurrent = true

    method crossfade( duration=1.0:Real )
      # Only has an effect for Music
      noAction

    method duration->Real
      local seconds : Real
      if (is_prepared)
        native
        @|float seconds;
         |ma_sound_get_length_in_seconds( &$this->sound, &seconds );
         |$seconds = seconds;
      endIf
      return seconds

    method fade_in( duration=1.0:Real, after_delay=0.0:Real )
      AudioManager.actions |= fade_in_action( &=duration &=after_delay )

    method fade_in_action( duration=1.0:Real, after_delay=0.0:Real )->Action
      current_volume = 0
      local action : Action
      if (after_delay) action += Action.wait( after_delay )
      action += Action( () => this.play( &concurrent ) )
      action += Action( (p) => this.current_volume = volume * p, &=duration )
      return action

    method fade_out( duration=1.0:Real, &pause )
      AudioManager.actions |= fade_out_action( &=duration, &=pause )

    method fade_out_action( duration=1.0:Real, &pause, &suspend )->Action
      local initial_volume = current_volume
      local action = Action( (p) => this.current_volume = initial_volume * (1.0 - p), &=duration )
      if (pause)       action += Action( () => this.pause )
      elseIf (suspend) action += Action( () => this.suspend )
      else             action += Action( () => this.stop )
      return action

    method first_idle->Sound
      if (is_playing or not load)
        if (next_in_pool) return next_in_pool.first_idle
        else              return null
      else
        return this
      endIf

    method is_playing->Logical
      if (not is_prepared) return false
      local result : Logical
      native @|$result = (RogueLogical) ma_sound_is_playing( &$this->sound );
      return result

    method load->Logical
      return prepare

    method looping
      is_looping = true

    method once
      is_looping = false

    method pause
      is_paused = true
      if (is_prepared)
        native @|ma_sound_stop( &$this->sound );
      endIf

    method play
      play( &concurrent=is_concurrent )

    method play( &concurrent )
      # concurrent flag is ignored here but is utilized in Music override
      if (rate_limit)
        if (not rate_limit.is_expired) return
        rate_limit.restart
      endIf

      if (prepare)
        is_paused = false
        is_suspended = false
        if (is_playing)
          next_in_pool?.play( &=concurrent )
        else
          current_volume = volume
          native
          @|ma_sound_set_looping( &$this->sound, $is_looping );
           |if (ma_sound_start( &$this->sound ) != MA_SUCCESS)
           |{
           |  printf("*** FAILED TO START SOUND ***\n");
           |};
        endIf
      endIf

    method play_after_delay( seconds:Real )
      AudioManager.actions |= Action.wait( seconds ) + Action( () => this.play )

    method position->Real
      local seconds : Real
      if (is_prepared)
        native
        @|float seconds;
         |ma_sound_get_cursor_in_seconds( &$this->sound, &seconds );
         |$seconds = seconds;
      endIf
      return seconds

    method prepare->Logical
      if (configuration_id != AudioManager.configuration_id)
        configuration_id = AudioManager.configuration_id
        reload
      endIf
      if (is_configured) return is_prepared
      is_configured = true

      local manager = AudioManager
      if (not manager.configure) return false

      if local file = Warlock.find_audio_file( filepath )
        native
        @|ma_result result = ma_sound_init_from_file(
         |  &$manager->engine,
         |  $file.filepath->data->as_utf8,
         |  MA_SOUND_FLAG_NO_PITCH | MA_SOUND_FLAG_NO_SPATIALIZATION,
         |  NULL,
         |  NULL,
         |  &$this->sound
         |);
         |$is_prepared = (result == MA_SUCCESS);
         if (not is_prepared)
          println "Unable to decode audio file: " + filepath
        endIf
      else
        println "Audio file not found: " + filepath
      endIf

      return is_prepared

    method reload
      local _position = position
      local _volume = current_volume
      local _looping = is_looping
      unload
      load
      prepare
      position = _position
      current_volume = _volume
      is_looping = _looping

    method resume
      if (is_suspended)
        play
        is_suspended = false
      endIf

    method set_is_looping( setting:Logical )
      if (is_looping == setting) return
      @is_looping = setting
      if (is_playing) native @|ma_sound_set_looping( &$this->sound, $is_looping );

    method set_volume( @volume )
      if (is_prepared) current_volume = volume
      next_in_pool?.set_volume( volume )

    method set_position( seconds:Real )
      if (prepare)
        native
        @|ma_sound_seek_to_second( &$this->sound, (float)$seconds );
      endIf

    method set_current_volume( @current_volume )
      if (prepare)
        local p = .effective_volume
        native @|ma_sound_set_volume( &$this->sound, (float)$p );
      endIf

    method set_rate_limit( interval:Real? )
      # Set to 0.5 to limit sounds to play once every 0.5 seconds, etc.
      local timer : Timer
      if (interval.exists) timer = Timer( interval.value, &expired )
      local cur = this
      while (cur)
        cur.@rate_limit = timer
        cur .= next_in_pool
      endWhile

    method stop
      is_paused = false
      if (is_prepared)
        native @|ma_sound_stop( &$this->sound );
                |ma_sound_seek_to_pcm_frame( &$this->sound, 0 );
      endIf

    method suspend
      if (not is_paused)
        pause
        is_suspended = true
      endIf

    method to->String
      return filepath

    method unload
      if (is_prepared)
        # Stop while keeping in the active_music list
        pause
        is_paused = false

        is_prepared = false
        native @|ma_sound_uninit( &$this->sound );
                |memset( &$this->sound, 0, sizeof(ma_sound) );
      endIf
      is_configured = false

    method .effective_volume->Real
      return AudioManager.master_volume * AudioManager.sound_volume * current_volume

endClass

