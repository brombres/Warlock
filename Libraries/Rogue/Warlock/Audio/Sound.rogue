library Warlock

class Sound
  PROPERTIES
    filepath       : String
    is_initialized : Logical
    is_prepared    : Logical
    is_music       : Logical
    is_looping     : Logical
    is_concurrent  : Logical
    native "ma_sound sound;"

  METHODS
    method init( filepath )
      noAction

    method concurrent
      is_concurrent = true

    method is_playing->Logical
      if (not is_initialized) return false
      local result : Logical
      native @|$result = (RogueLogical) ma_sound_is_playing( &$this->sound );
      return result

    method load
      prepare

    method looping
      is_looping = true

    method on_cleanup
      if (is_initialized)
        is_initialized = false
        native @|ma_sound_uninit( &$this->sound );
      endIf
      is_prepared = false

    method once
      is_looping = false

    method set_is_looping( setting:Logical )
      if (is_looping == setting) return
      @is_looping = setting
      if (is_playing) native @|ma_sound_set_looping( &$this->sound, $is_looping );

    method pause
      if (is_initialized)
        native @|ma_sound_stop( &$this->sound );
      endIf

    method play
      if (prepare)
        native
        @|ma_sound_set_looping( &$this->sound, $is_looping );
         |ma_sound_start( &$this->sound );
      endIf

    method prepare->Logical
      if (is_prepared) return is_initialized
      is_prepared = true

      local manager = AudioManager
      if (not manager.configure) return false

      if local file = Warlock.find_audio_file( filepath )
        native
        @|ma_result result = ma_sound_init_from_file(
         |  &$manager->engine,
         |  $file.filepath->data->as_utf8,
         |  0,
         |  NULL,
         |  NULL,
         |  &$this->sound
         |);
         |$is_initialized = (result == MA_SUCCESS);
      else
        println "Audio file not found: " + filepath
      endIf

      return is_initialized

    method stop
      if (is_initialized)
        native @|ma_sound_stop( &$this->sound );
                |ma_sound_seek_to_pcm_frame( &$this->sound, 0 );
      endIf
endClass
