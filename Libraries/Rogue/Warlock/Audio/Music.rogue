library Warlock

class Music : Sound
  PROPERTIES
    is_music   = true
    is_looping = true

  METHODS
    method init( filepath, pool_count=1:Int )
      if (pool_count > 1)
        next_in_pool = Music( filepath, pool_count - 1 )
      endIf

    method crossfade( duration=1.0:Real )
      # Fades all other active music out and this music in over the specified duration
      local actions : Action
      forEach (music in AudioManager.active_music)
        actions |= Action( () => music.fade_out(duration,&concurrent) )
      endForEach
      actions |= Action( () => this.fade_in(duration,&concurrent) )
      AudioManager.actions += actions

    method pause [override]
      prior.pause
      AudioManager.active_music.remove( this )

    method play( concurrent:Logical ) [override]
      if (not AudioManager.configure) return

      if (AudioManager.active_music.contains(this))
        if (is_playing)
          next_in_pool?.play( &=concurrent )
        else
          prior.play( &=concurrent )
        endIf
      else
        if (not concurrent)
          (forEach in AudioManager.active_music step -1).stop
          AudioManager.active_music.clear
        endIf
        AudioManager.active_music.add( this )
        prior.play( &=concurrent )
      endIf

    method stop [override]
      prior.stop
      AudioManager.active_music.remove( this )

endClass
