library Warlock

class AudioManager [singleton]
  NATIVE
    nativeHeader @|#include "miniaudio.h"

  PROPERTIES
    actions      : Action

    active_music = Music[]

    is_configured  : Logical
    is_initialized : Logical
    native "ma_engine engine;"

  METHODS
    method on_cleanup
      if (is_initialized)
        is_initialized = false
        native @|ma_engine_uninit( &$this->engine );
      endIf

    method configure->Logical
      if (is_configured) return is_initialized
      is_configured = true

      local success : Logical

      native
      @|ma_result result = ma_engine_init(NULL, &$this->engine);
       |$success = (result == MA_SUCCESS);

      if (not success)
        println "Error initializing miniaudio"
        return false
      endIf

      is_initialized = true

    method fade_out_music( duration=1.0:Real, &concurrent )
      local fade_actions : Action
      forEach (music in AudioManager.active_music)
        fade_actions |= Action( () => music.fade_out(duration,concurrent) )
      endForEach
      actions += fade_actions

    method pause_music
      (forEach in AudioManager.active_music).pause

    method stop_music
      (forEach in AudioManager.active_music).stop

    method update
      if (actions) actions = actions.updated
endClass
