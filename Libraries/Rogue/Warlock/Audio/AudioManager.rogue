library Warlock

class AudioManager [singleton]
  PROPERTIES
    actions      : Action

    all_sounds   = Sound[]  # includes sounds and music
    active_music = Music[]  # actively playing or paused music only

    is_configured    : Logical # true if we have attempted to configure audio
    is_prepared      : Logical # true if audio is *successfully* configured
    is_suspended     : Logical
    configuration_id : Int

    native "ma_engine engine;"
    native "id audio_interruption_observer;"

  METHODS
    method clear
      (forEach in all_sounds).unload
      all_sounds.clear
      active_music.clear

    method on_cleanup
      unload

    method configure->Logical
      if (is_configured) return is_prepared
      is_configured = true

      local success = true

      if ($target("iOS"))
        native @|$success = (RogueLogical)[[AVAudioSession sharedInstance] setActive:YES error:nil];
      endIf

      if (success)
        native
        @|ma_result result = ma_engine_init(NULL, &$this->engine);
         |$success = (result == MA_SUCCESS);
      endIf

      if (not success)
        Log.println "[Error initializing MiniAudio]"
        if (configuration_id)
          # We were previously configured at some point. Try configuring again
          # the next time a sound is played etc.
          is_configured = false
          unload
        endIf
        return false
      endIf

      if ($target("iOS"))
        native
        @|$this->audio_interruption_observer =
         |[
         |  [NSNotificationCenter defaultCenter]
         |  addObserverForName:AVAudioSessionInterruptionNotification
         |  object:nil
         |  queue:nil
         |  usingBlock:^( NSNotification *note ) {
         |    Warlock_handle_ios_audio_interruption( note );
         |  }
         |];
      endIf

      is_prepared = true
      ++configuration_id
      resume_music

      return true

    method fade_out_music( duration=1.0:Real )
      local fade_actions : Action
      forEach (music in AudioManager.active_music)
        fade_actions |= music.fade_out_action( duration )
      endForEach
      actions += fade_actions

    method on_ios_audio_interruption( &beginning )
      if (beginning) suspend
      else           resume

    method reset
      stop_music
      actions = null

    method pause_music
      (forEach in AudioManager.active_music step -1).pause

    method reactivate
      if (is_prepared)
        if ($target("iOS"))
          native @|NSError* error = nil;
                  |[[AVAudioSession sharedInstance] setActive:YES error:&error];
                  |if (error)
                  |{
                  |  NSLog( @"Error reactivating AVAudioSession: %@\n", error );
                  |}
        endIf
      endIf

    method reconfigure
      if (is_prepared)
        reactivate
        native
        @|ma_device_stop( $this->engine.pDevice );
         |if (ma_device_start($this->engine.pDevice) != MA_SUCCESS)
         |{
            Log.println "[Failed to start MiniAudio device - reloading audio system]"
            unload
            reconfigure_auto_retry
        native
        @|}

      else
        configure

      endIf

    method reconfigure_auto_retry
      if (not configure)
        Log.println "[Reloading audio system (auto-retry)]"
        actions = Action.wait( 0.5 ) + Action( ()=> AudioManager.reconfigure_auto_retry ) + actions
      endIf

    method resume
      if (not is_suspended) return
      is_suspended = false

      reconfigure
      if (is_prepared)
        resume_music
      endIf

    method resume_music
      local actions : Action

      forEach (music in active_music step -1)
        if (music.is_suspended)
          actions |= music.fade_in_action( 0.5 )
        endIf
      endForEach

      # Enqueue on essential_actions in case the suspend fade-out actions are still executing
      Warlock.essential_actions += actions

    method stop_music
      (forEach in active_music step -1).stop

    method suspend
      if (is_suspended) return
      is_suspended = true

      local fade_actions : Action
      forEach (music in AudioManager.active_music)
        if (not music.is_paused)
          fade_actions |= music.fade_out_action( 0.50, &suspend )
        endIf
      endForEach
      Warlock.essential_actions += fade_actions

    method unload
      if (is_prepared)
        (forEach in all_sounds).unload

        if ($target("iOS"))
          native
          @|if ($this->audio_interruption_observer)
           |{
           |  [[NSNotificationCenter defaultCenter] removeObserver:$this->audio_interruption_observer];
           |  $this->audio_interruption_observer = nil;
           |}
        endIf
        is_prepared = false
        native @|ma_engine_uninit( &$this->engine );
      endIf
      is_configured = false
      native @|memset( &$this->engine, 0, sizeof(ma_engine) );

    method update
      if (actions) actions = actions.updated

  GLOBAL METHODS
    method handle_ios_audio_interruption( &beginning ) [api]
      AudioManager.on_ios_audio_interruption( &=beginning )

  NATIVE
    nativeHeader @|#include "miniaudio.h"
                  |
                  |#if ROGUE_TARGET_IOS
                  |  #import <AVFoundation/AVFoundation.h>
                  |#endif

    nativeHeader
    @|#if ROGUE_TARGET_IOS
     |  static void Warlock_handle_ios_audio_interruption( NSNotification* notification );
     |  void RogueWarlockAudioManager__handle_ios_audio_interruption__RogueLogical(RogueLogical);
     |#endif

    nativeHeader
    @|#if ROGUE_TARGET_IOS
     |  static void Warlock_handle_ios_audio_interruption( NSNotification* notification )
     |  {
     |    NSDictionary *info = notification.userInfo;
     |    AVAudioSessionInterruptionType type =
     |        (AVAudioSessionInterruptionType)
     |          [info[AVAudioSessionInterruptionTypeKey] unsignedIntegerValue];
     |    RogueWarlockAudioManager__handle_ios_audio_interruption__RogueLogical(
     |      (RogueLogical)(type == AVAudioSessionInterruptionTypeBegan)
     |    );
     |  }
     |#endif

endClass
