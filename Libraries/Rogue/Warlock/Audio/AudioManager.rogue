library Warlock

class AudioManager [singleton]
  PROPERTIES
    master_volume = 1.0  # multiplied by AudioManager.sound/music_volume and individual .volume
    sound_volume  = 1.0
    music_volume  = 1.0

    actions      : Action

    all_audio    = Sound[]  # includes sounds and music
    active_music = Music[]  # actively playing or paused music only

    @is_exclusive    = true    # true: other music suspended, false: BG music allowed
    is_configured    : Logical # true if we have attempted to configure audio
    is_prepared      : Logical # true if audio is *successfully* configured
    is_suspended     : Logical
    is_backgrounded  : Logical
    configuration_id : Int

    native @|ma_engine engine;
            |
            |#if defined(ROGUE_TARGET_IOS)
            |  id audio_interruption_observer;
            |#endif

  METHODS
    method clear
      (forEach in all_audio).unload
      all_audio.clear
      active_music.clear

    method on_cleanup
      unload

    method configure( &exclusive=null:Logical )->Logical
      if (exclusive)
        reconfigure( &=exclusive )
        return is_prepared
      endIf

      if (is_configured) return is_prepared
      is_configured = true

      local success = true

      if ($target("iOS"))
        success = .ios_set_audio_session_active
      endIf

      if (success)
        native
        @|//ma_context_config context_config = ma_context_config_init();
         |//if ($is_exclusive) context_config.coreaudio.sessionCategory = ma_ios_session_category_solo_ambient;
         |//else               context_config.coreaudio.sessionCategory = ma_ios_session_category_ambient;
         |//
         |//ma_context context;
         |//if (ma_context_init(NULL, 0, &context_config, &context) == MA_SUCCESS)
         |//{
         |//  ma_engine_config engine_config = ma_engine_config_init();
         |//  engine_config.pContext = &context;
         |//
         |//  ma_result result = ma_engine_init( &engine_config, &$this->engine);
         |//  $success = (result == MA_SUCCESS);
         |//}
         |ma_result result = ma_engine_init( NULL, &$this->engine);
         |$success = (result == MA_SUCCESS);

         if (success and $target("iOS"))
           success = .ios_set_audio_session_active  # reapply exclusivity after MiniAudio start
         endIf
      endIf

      if (not success)
        Log.println "[Error initializing MiniAudio]"
        if (configuration_id)
          # We were previously configured at some point. Try configuring again
          # the next time a sound is played etc.
          is_configured = false
          unload
        endIf
        return false
      endIf

      if ($target("iOS"))
        native
        @|$this->audio_interruption_observer =
         |[
         |  [NSNotificationCenter defaultCenter]
         |  addObserverForName:AVAudioSessionInterruptionNotification
         |  object:nil
         |  queue:nil
         |  usingBlock:^( NSNotification *note ) {
         |    Warlock_handle_ios_audio_interruption( note );
         |  }
         |];
      endIf

      is_prepared = true
      ++configuration_id
      resume_music

      return true

    method fade_out_music( duration=1.0:Real )
      local fade_actions : Action
      forEach (music in AudioManager.active_music)
        fade_actions |= music.fade_out_action( duration )
      endForEach
      actions += fade_actions

    method on_ios_audio_interruption( &beginning )
      if (beginning) suspend
      else           resume

    method reset
      stop_music
      actions = null

    method reactivate
      if (is_prepared)
        .ios_set_audio_session_active
      endIf

    method .ios_set_audio_session_active( &active=true )->Logical
      local success = true
      if ($target("iOS"))
        if (active)
          #.ios_set_audio_session_active( &!active )
          .ios_set_audio_session_exclusivity
        endIf

        native
        @|NSError* error = nil;
         |[[AVAudioSession sharedInstance] setActive:($active?YES:NO) error:&error];
         |if (error)
         |{
         |  $success = 0;
         |  NSLog( @"[Warlock] Error %sactivating AVAudioSession: %@\n", ($active?"":"de"), error );
         |}
      endIf
      return success

    method .ios_set_audio_session_exclusivity
      if ($target("iOS"))
        native
        @|NSError* error = nil;
         |AVAudioSession* session = [AVAudioSession sharedInstance];
         |if ($this->is_exclusive)
         |{
         |  [session setCategory:AVAudioSessionCategorySoloAmbient withOptions:0 error:&error];
         |}
         |else
         |{
         |  [session setCategory:AVAudioSessionCategoryAmbient withOptions:0 error:&error];
         |}
         |
         |if (error)
         |{
         |  NSLog( @"[Warlock] Error setting AVAudioSession category: %@\n", error );
         |}
      endIf

    method reconfigure( &exclusive=null:Logical? )
      if (exclusive)
        # Developer is setting exclusivity.
        if (exclusive.value != is_exclusive)
          @is_exclusive = exclusive.value
          if (System.is_mobile and is_prepared)
            suspend( &instant )
            unload
            auto_retry_reconfigure
          endIf
        endIf
        if (is_prepared) return
      endIf

      if (is_prepared)
        # Reconfiguring after suspension
        reactivate
        native
        @|ma_device_stop( $this->engine.pDevice );
         |if (ma_device_start($this->engine.pDevice) != MA_SUCCESS)
         |{
            Log.println "[Failed to start MiniAudio device - reloading audio system]"
            unload
            auto_retry_reconfigure
        native
        @|}

      else
        if (exclusive) @is_exclusive = exclusive.value
        configure

      endIf

    method auto_retry_reconfigure
      if (configure)
        if (is_backgrounded)
          is_backgrounded = false
          resume_music
        endIf
      else
        Log.println "[Reloading audio system (auto-retry)]"
        actions = Action.wait( 0.5 ) + Action( ()=> AudioManager.auto_retry_reconfigure ) + actions
      endIf

    method resume( &backgrounded )
      if (backgrounded)
        if (not is_backgrounded) return
        is_backgrounded = true
        this.reconfigure
      else
        if (not is_suspended) return
        is_suspended = false
      endIf

      if (is_prepared)
        resume_music( &=backgrounded )
      endIf

    method resume_music( &backgrounded )
      local actions : Action

      forEach (music in active_music step -1)
        if (backgrounded)
          if (music.is_backgrounded) music.play
        else
          if (music.is_suspended) music.play
        endIf
      endForEach

      # Enqueue on essential_actions in case the suspend fade-out actions are still executing
      Warlock.essential_actions += actions

    method set_is_exclusive( setting:Logical )
      if (is_exclusive != setting) reconfigure( &exclusive=setting )

    method set_music_volume( new_volume:Real, fade_duration=0.0:Real, &exclusive=null:Logical? )->Action
      if (fade_duration)
        local action = Action( (p) => this.music_volume = p.lerp(music_volume,new_volume), fade_duration )
        if (exclusive) action += Action( () => AudioManager.is_exclusive = exclusive.value )
        actions |= action
        return action
      else
        @music_volume = new_volume
        if (exclusive) AudioManager.reconfigure( &exclusive=exclusive.value )

        if (active_music)
          forEach (music in active_music)
            music.current_volume = music.current_volume  # reapply music volume
            if (not music.is_playing) music.play
          endForEach
        endIf

        return null
      endIf

    method stop_music
      (forEach in active_music step -1).stop

    method suspend( &instant, &backgrounded )
      if (backgrounded)
        if (is_backgrounded) return
        is_backgrounded = true
      else
        if (is_suspended) return
        is_suspended = true
      endIf

      local fade_actions : Action
      forEach (music in AudioManager.active_music)
        if (not music.is_paused)
          if (instant) music.suspend( &=backgrounded )
          else         fade_actions |= music.fade_out_action( 0.50, &suspend, &=backgrounded )
        endIf
      endForEach
      Warlock.essential_actions += fade_actions

    method unload
      if (is_prepared)
        (forEach in all_audio).unload

        if ($target("iOS"))
          native
          @|if ($this->audio_interruption_observer)
           |{
           |  [[NSNotificationCenter defaultCenter] removeObserver:$this->audio_interruption_observer];
           |  $this->audio_interruption_observer = nil;
           |}
        endIf
        is_prepared = false
        native @|ma_engine_uninit( &$this->engine );
      endIf
      is_configured = false
      native @|memset( &$this->engine, 0, sizeof(ma_engine) );

    method update
      if (actions) actions = actions.updated

  GLOBAL METHODS
    method handle_ios_audio_interruption( &beginning ) [api]
      AudioManager.on_ios_audio_interruption( &=beginning )

  NATIVE
    nativeHeader @|#include "miniaudio.h"
                  |
                  |#if ROGUE_TARGET_IOS
                  |  #import <AVFoundation/AVFoundation.h>
                  |#endif

    nativeHeader
    @|#if ROGUE_TARGET_IOS
     |  static void Warlock_handle_ios_audio_interruption( NSNotification* notification );
     |  void RogueWarlockAudioManager__handle_ios_audio_interruption__RogueLogical(RogueLogical);
     |#endif

    nativeHeader
    @|#if ROGUE_TARGET_IOS
     |  static void Warlock_handle_ios_audio_interruption( NSNotification* notification )
     |  {
     |    NSDictionary *info = notification.userInfo;
     |    AVAudioSessionInterruptionType type =
     |        (AVAudioSessionInterruptionType)
     |          [info[AVAudioSessionInterruptionTypeKey] unsignedIntegerValue];
     |    RogueWarlockAudioManager__handle_ios_audio_interruption__RogueLogical(
     |      (RogueLogical)(type == AVAudioSessionInterruptionTypeBegan)
     |    );
     |  }
     |#endif

endClass
