library Geometry

uses Graphics
uses Warlock

augment Quad
  METHODS
    method draw( color:Color, render_mode=RenderMode.ALPHA_COLOR:RenderMode, thickness=1.0:Int )
      Renderer.draw( this, color, render_mode )

    method draw( outline:Outline, render_mode=RenderMode.ALPHA_COLOR:RenderMode, thickness=1.0:Int )
      local color = outline.color
      Line( a, b ).draw( color, render_mode, thickness )
      Line( b, c ).draw( color, render_mode, thickness )
      Line( c, d ).draw( color, render_mode, thickness )
      Line( d, a ).draw( color, render_mode, thickness )

    method draw( color:Color, texture:Texture, render_mode=RenderMode.ALPHA_TEXTURE_COLOR_MULTIPLY:RenderMode )
      Renderer.draw( this, texture, color, render_mode )

endAugment

