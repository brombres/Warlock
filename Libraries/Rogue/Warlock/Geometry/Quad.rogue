library Geometry

uses Graphics
uses Warlock

augment Quad
  METHODS
    method draw( color:Color, render_mode=RenderMode.ALPHA_COLOR:RenderMode, thickness=1.0:Int, &outline )
      if (outline)
        Line( a, b ).draw( color, render_mode, thickness )
        Line( b, c ).draw( color, render_mode, thickness )
        Line( c, d ).draw( color, render_mode, thickness )
        Line( d, a ).draw( color, render_mode, thickness )
      else
        Triangle( a, b, c ).draw( color, render_mode )
        Triangle( a, c, d ).draw( color, render_mode )
      endIf

endAugment

