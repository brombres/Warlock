library Warlock

class Window : Display [singleton]
  PROPERTIES
    title       : String

    control_states          = ControlStates()
    control_states_modified : Logical

    old_size    : XY  # used to detect size changes in WarlockController.tick(Window)
    actions     : Action

  METHODS
    method init( title, width:Int, height:Int, state=State():State )
      Window = this

      define_control_states( state )

      pixel_size = XY(width,height)
      if (Framework.create_window(this))
        Warlock.add_window( this )
        Renderer.configure_window( this )
      endIf

    method add_overlay( overlay:State )
      overlays |= overlay

    method background->State
      control_states.update_active_list
      if local background = control_states//background
        return background
      else
        local result = State().[exit]
        control_states//background = result
        return result
      endIf

    method define_control_states( start_state:State )
      # The order that new blank states are added to the control_states[] table defines
      # the drawing order and corresponding UI event dispatch order of various control
      # state types. Augment-replace in your app to customize.
      control_states//background = null
      control_states//scene      = null
      control_states//screen     = null
      control_states//state      = start_state
      control_states//overlays   = null

    method begin_render [override]
      prior.begin_render
      forEach (state at index in control_states.active_list step -1)
        control_states.active_layer_index = index
        state.on_begin_render
      endForEach
      Renderer.on_begin_render( this )

    method begin_tick [override]
      Window = this
      Framework.update_window_size( this )
      prior.begin_tick

    method change_background( new_background:State )
      if local background = control_states//background
        control_states//background.change( new_background )
      else
        control_states//background = new_background
      endIf

    method change_overlay( new_overlay:State )
      if local overlays = control_states//overlays
        control_states//overlays.change( new_overlay )
      else
        control_states//overlays = new_overlay
      endIf

    method change_scene( new_scene:State )
      if local scene = control_states//scene
        control_states//scene.change( new_scene )
      else
        control_states//scene = new_scene
      endIf

    method change_screen( new_screen:State )
      if local screen = control_states//screen
        control_states//screen.change( new_screen )
      else
        control_states//screen = new_screen
      endIf

    method change_state( new_state:State )
      if local state = control_states//state
        control_states//state.change( new_state )
      else
        control_states//state = new_state
      endIf

    method close
      Warlock.windows.remove( this )
      Framework.close_window( this )

    method dispatch( e:KeyEvent, layer_index=null:Int? )
      localize control_states.active_list
      if (not layer_index) layer_index = active_list.count - 1

      if (layer_index.value >= 0)
        temporarily control_states.active_layer_index = layer_index.value
          local state = active_list[layer_index.value]
          state.handle( e )
        endTemporarily
      else
        handle( e )
      endIf

    method dispatch( e:MultitouchEvent, layer_index=null:Int? )
      localize control_states.active_list
      if (not layer_index) layer_index = active_list.count - 1

      if (layer_index.value >= 0)
        temporarily control_states.active_layer_index = layer_index.value
          local state = active_list[layer_index.value]
          state.handle( e )
        endTemporarily
      else
        handle( e )
      endIf

    method dispatch( e:PointerEvent, layer_index=null:Int? )
      localize control_states.active_list
      if (not layer_index) layer_index = active_list.count - 1

      if (layer_index.value >= 0)
        temporarily control_states.active_layer_index = layer_index.value
          local state = active_list[layer_index.value]
          state.handle( e )
        endTemporarily
      else
        handle( e )
      endIf

    method dispatch( e:ScrollEvent, layer_index=null:Int? )
      localize control_states.active_list
      if (not layer_index) layer_index = active_list.count - 1

      if (layer_index.value >= 0)
        temporarily control_states.active_layer_index = layer_index.value
          local state = active_list[layer_index.value]
          state.handle( e )
        endTemporarily
      else
        handle( e )
      endIf

    method dispatch( e:TextEvent, layer_index=null:Int? )
      localize control_states.active_list
      if (not layer_index) layer_index = active_list.count - 1

      if (layer_index.value >= 0)
        temporarily control_states.active_layer_index = layer_index.value
          local state = active_list[layer_index.value]
          state.handle( e )
        endTemporarily
      else
        handle( e )
      endIf

    method dispatch_draw
      draw_state

    method dispatch_update
      control_states.update_active_list
      control_states_modified = false

      forEach (layer_index of control_states.active_list step -1)
        update_state( layer_index )
      endForEach

      while (control_states_modified)
        # Some new control states may not have gotten their first update
        # during the update pass above. Make sure all states are started
        # before letting them handle other events.
        control_states_modified = false

        forEach (entry in control_states.entries)
          if local state = entry.value
            local started_state = state.started
            if (state is not started_state)
              entry.value = started_state
              control_states.mark_modified
            endIf
          endIf
        endForEach
      endWhile

      update

    method draw [override]
      @ui?.draw

      block cur = actions
        while (cur)
          cur.on_draw
          cur .= concurrent_state
        endWhile
      endBlock

    method draw_state( layer_index=null:Int? )
      localize control_states.active_list

      if (not layer_index) layer_index = active_list.count - 1

      if (layer_index.value >= 0)
        temporarily control_states.active_layer_index = layer_index.value
          local state = active_list[layer_index.value]
          state.draw
        endTemporarily
      else
        draw
      endIf

    method end_render [override]
      prior.end_render

      forEach (state at index in control_states.active_list step -1)
        control_states.active_layer_index = index
        state.on_end_render
      endForEach

      if (Warlock.windows.count and Warlock.windows.first is this) OverlayLog.draw
      Renderer.on_end_render( this )

    method handle( e:KeyEvent )
      @ui?.handle( e )

    method handle( e:MultitouchEvent )
      @ui?.handle( e )

    method handle( e:PointerEvent )
      @ui?.handle( e )

    method handle( e:ScrollEvent )
      @ui?.handle( e )

    method handle( e:TextEvent )
      @ui?.handle( e )

    method handle_app_resume
      Framework.handle_app_resume( this )
      Renderer.handle_app_resume( this )

    method native_id->Int
      noAction  # defined by extended Platform, e.g. SDL

    method overlays->State
      control_states.update_active_list
      if local overlays = control_states//overlays
        return overlays
      else
        local result = State().[exit]
        control_states//overlays = result
        return result
      endIf

    method remove_background( background:State )
      if local cur_background = control_states//background
        control_states//background = cur_background.removing( background )
      endIf

    method remove_overlay( overlay:State )
      if local cur_overlay = control_states//overlays
        control_states//overlays = cur_overlay.removing( overlay )
      endIf

    method remove_scene( scene:State )
      if local cur_scene = control_states//scene
        control_states//scene = cur_scene.removing( scene )
      endIf

    method remove_screen( screen:State )
      if local cur_screen = control_states//screen
        control_states//screen = cur_screen.removing( screen )
      endIf

    method remove_state( state:State )
      if local cur_state = control_states//state
        control_states//state = cur_state.removing( state )
      endIf

    method scene->State
      control_states.update_active_list
      if local scene = control_states//scene
        return scene
      else
        local result = State().[exit]
        control_states//scene = result
        return result
      endIf

    method screen->State
      control_states.update_active_list
      if local screen = control_states//screen
        return screen
      else
        local result = State().[exit]
        control_states//screen = result
        return result
      endIf

    method set_background( background:State )
      control_states//background = background

    method set_overlays( overlay:State )
      control_states//overlays = overlay

    method set_scene( scene:State )
      control_states//scene = scene

    method set_screen( screen:State )
      control_states//screen = screen

    method set_state( state:State )
      control_states//state = state

    method state->State
      control_states.update_active_list
      if local state = control_states//state
        return state
      else
        local result = State().[exit]
        control_states//state = result
        return result
      endIf

    method update [override]
      if (@ui)
        ui.update( bounds )
        ui.request_redraw
      endIf

      if (actions) actions = actions.updated

    method update_state( layer_index:Int )
      localize control_states.active_list

      temporarily control_states.active_layer_index = layer_index
        local state = control_states.active_layer
        local layer_id = control_states.active_layer_id
        local updated_state = state.updated
        if (updated_state is not state)
          control_states[layer_id] = updated_state
        endIf
      endTemporarily

endClass

augment UI::Event
  PROPERTIES
    window : Warlock::Window
endAugment
