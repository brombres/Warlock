library Warlock

class Window : Display [singleton]
  PROPERTIES
    title      : String
    ui_manager : UI

  METHODS
    method init( title, width:Int, height:Int )
      Window = this
      pixel_size = XY(width,height)
      if (Framework.create_window(this))
        Warlock.add_window( this )
        Renderer.configure_window( this )
      endIf

    method begin_render [override]
      prior.begin_render
      Renderer.on_begin_render( this )

    method begin_tick [override]
      Window = this
      Framework.update_window_size( this )
      prior.begin_tick

    method close
      Warlock.windows.remove( this )
      Framework.close_window( this )

    method draw [override]
      @ui_manager?.draw

    method end_render [override]
      prior.end_render
      if (Warlock.windows.count and Warlock.windows.first is this) OverlayLog.draw
      Renderer.on_end_render( this )

    method handle( e:KeyEvent )
      if (@ui_manager) @ui_manager.handle( e )

    method handle( e:PointerEvent )
      if (@ui_manager) @ui_manager.handle( e )

    method handle( e:ScrollEvent )
      if (@ui_manager) @ui_manager.handle( e )

    method handle( e:TextEvent )
      if (@ui_manager) @ui_manager.handle( e )

    method native_id->Int
      noAction  # defined by extended Platform, e.g. SDL

    method render
      State.draw( &!fg )
      State.draw( &fg )

    method set_ui( new_ui:Component ) [override]
      if (@ui) ui_manager.remove( @ui )
      @ui = new_ui
      ui_manager.insert( new_ui )

    method ui_manager->UI [override]
      if (@ui_manager) return @ui_manager
      ui_manager = UI()
      return ui_manager

    method update [override]
      if (@ui_manager)
        ui_manager.update( bounds )
        ui_manager.request_redraw
      endIf

    method update_ui_layering [override]
      if (@ui or Screen.@ui or State.@ui) ui_manager  # ensure created

      if (@ui_manager)
        contingent
          local cur = @ui_manager.first_child
          if (@ui)        necessary (@ui is cur);        cur = cur?.next
          if (Screen.@ui) necessary (Screen.@ui is cur); cur = cur?.next
          if (State.@ui)  necessary (State.@ui is cur);  cur = cur?.next
          necessary (cur is null)
        unsatisfied
          # Rebuild UI layering
          @ui_manager.clear
          if (@ui) @ui_manager.add( @ui )
          if (Screen.@ui) @ui_manager.add( Screen.@ui )
          if (State.@ui) @ui_manager.add( State.@ui )
        endContingent
      endIf
endClass

augment UI::Event
  PROPERTIES
    window : Warlock::Window
endAugment
