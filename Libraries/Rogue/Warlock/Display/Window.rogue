library Warlock

class Window : Display [singleton]
  PROPERTIES
    title       : String

    control_states     = ControlStates()
    active_layers      = State[]    # A flat copy of control_states used during event dispatch.
    active_layer_ids   = GlobalID[] # Used for reverse lookup from active layer index to control state.
    active_layer_index : Int        # The current control state index during an event dispatch.

    old_size    : XY  # used to detect size changes in WarlockController.tick(Window)
    actions     : Action

  METHODS
    method init( title, width:Int, height:Int, state=State():State )
      Window = this

      define_control_states( state )

      pixel_size = XY(width,height)
      if (Framework.create_window(this))
        Warlock.add_window( this )
        Renderer.configure_window( this )
      endIf

    method active_layers->State[]
      if (control_states.are_modified) .update_active_layers
      return @active_layers

    method define_control_states( start_state:State )
      # The order that new blank states are added to the control_states[] table defines
      # the drawing order and corresponding UI event dispatch order of various control
      # state types. Augment-replace in your app to customize.
      control_states//background = null
      control_states//scene      = null
      control_states//screen     = null
      control_states//overlays   = null
      control_states//state      = start_state

    method begin_render [override]
      prior.begin_render
      forEach (state at index in active_layers step -1)
        active_layer_index = index
        state.on_begin_render
      endForEach
      Renderer.on_begin_render( this )

    method begin_tick [override]
      Window = this
      Framework.update_window_size( this )
      prior.begin_tick

    method change_scene( new_scene:State )
      if local scene = control_states//scene
        control_states//scene.change( new_scene )
      else
        control_states//scene = new_scene
      endIf

    method change_screen( new_screen:State )
      if local screen = control_states//screen
        control_states//screen.change( new_screen )
      else
        control_states//screen = new_screen
      endIf

    method change_state( new_state:State )
      if local state = control_states//state
        control_states//state.change( new_state )
      else
        control_states//state = new_state
      endIf

    method close
      Warlock.windows.remove( this )
      Framework.close_window( this )

    method dispatch( e:KeyEvent, layer_index=null:Int? )
      localize active_layers
      if (not layer_index) layer_index = active_layers.count - 1

      if (layer_index.value >= 0)
        temporarily active_layer_index = layer_index.value
          local state = active_layers[layer_index.value]
          state.handle( e )
        endTemporarily
      else
        handle( e )
      endIf

    method dispatch( e:MultitouchEvent, layer_index=null:Int? )
      localize active_layers
      if (not layer_index) layer_index = active_layers.count - 1

      if (layer_index.value >= 0)
        temporarily active_layer_index = layer_index.value
          local state = active_layers[layer_index.value]
          state.handle( e )
        endTemporarily
      else
        handle( e )
      endIf

    method dispatch( e:PointerEvent, layer_index=null:Int? )
      localize active_layers
      if (not layer_index) layer_index = active_layers.count - 1

      if (layer_index.value >= 0)
        temporarily active_layer_index = layer_index.value
          local state = active_layers[layer_index.value]
          state.handle( e )
        endTemporarily
      else
        handle( e )
      endIf

    method dispatch( e:ScrollEvent, layer_index=null:Int? )
      localize active_layers
      if (not layer_index) layer_index = active_layers.count - 1

      if (layer_index.value >= 0)
        temporarily active_layer_index = layer_index.value
          local state = active_layers[layer_index.value]
          state.handle( e )
        endTemporarily
      else
        handle( e )
      endIf

    method dispatch( e:TextEvent, layer_index=null:Int? )
      localize active_layers
      if (not layer_index) layer_index = active_layers.count - 1

      if (layer_index.value >= 0)
        temporarily active_layer_index = layer_index.value
          local state = active_layers[layer_index.value]
          state.handle( e )
        endTemporarily
      else
        handle( e )
      endIf

    method dispatch_draw
      draw_state

    method dispatch_update
      update_state

    method draw [override]
      @ui?.draw

      block cur = actions
        while (cur)
          cur.on_draw
          cur .= concurrent_state
        endWhile
      endBlock

    method draw_state( layer_index=null:Int? )
      localize active_layers

      if (not layer_index) layer_index = active_layers.count - 1

      if (layer_index.value >= 0)
        temporarily active_layer_index = layer_index.value
          local state = active_layers[layer_index.value]
          state.draw
        endTemporarily
      else
        draw
      endIf

    method end_render [override]
      prior.end_render

      forEach (state at index in active_layers step -1)
        active_layer_index = index
        state.on_end_render
      endForEach

      if (Warlock.windows.count and Warlock.windows.first is this) OverlayLog.draw
      Renderer.on_end_render( this )

    method handle( e:KeyEvent )
      @ui?.handle( e )

    method handle( e:MultitouchEvent )
      @ui?.handle( e )

    method handle( e:PointerEvent )
      @ui?.handle( e )

    method handle( e:ScrollEvent )
      @ui?.handle( e )

    method handle( e:TextEvent )
      @ui?.handle( e )

    method handle_app_resume
      Framework.handle_app_resume( this )
      Renderer.handle_app_resume( this )

    method native_id->Int
      noAction  # defined by extended Platform, e.g. SDL

    method remove_scene( scene:State )
      if local cur_scene = control_states//scene
        control_states//scene = cur_scene.removing( scene )
      endIf

    method remove_screen( screen:State )
      if local cur_screen = control_states//screen
        control_states//screen = cur_screen.removing( screen )
      endIf

    method remove_state( state:State )
      if local cur_state = control_states//state
        control_states//state = cur_state.removing( state )
      endIf

    method scene->State
      .update_active_layers
      if local scene = control_states//scene
        return scene
      else
        local result = State()
        control_states//scene = result
        return result
      endIf

    method screen->State
      .update_active_layers
      if local screen = control_states//screen
        return screen
      else
        local result = State()
        control_states//screen = result
        return result
      endIf

    method set_scene( scene:State )
      control_states//scene = scene

    method set_screen( screen:State )
      control_states//screen = screen

    method set_state( state:State )
      control_states//state = state

    method state->State
      .update_active_layers
      if local state = control_states//state
        return state
      else
        local result = State()
        control_states//state = result
        return result
      endIf

    method update [override]
      if (@ui)
        ui.update( bounds )
        ui.request_redraw
      endIf

      if (actions) actions = actions.updated

    method update_state( layer_index=null:Int? )
      localize active_layers
      if (not layer_index) layer_index = active_layers.count - 1

      if (layer_index.value >= 0)
        temporarily active_layer_index = layer_index.value
          local state = active_layers[layer_index.value]
          local updated_state = state.updated
          if (updated_state is not state)
            control_states[active_layer_ids[layer_index.value]] = updated_state
          endIf
        endTemporarily
      else
        update
      endIf

    method .update_active_layers
      control_states.update_order( @active_layers, active_layer_ids )
endClass

augment UI::Event
  PROPERTIES
    window : Warlock::Window
endAugment
