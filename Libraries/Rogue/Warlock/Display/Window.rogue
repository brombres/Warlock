library Warlock

class Window : Display [singleton]
  PROPERTIES
    title          : String
    control_states = ControlStates()
    old_size       : XY  # used to detect size changes in WarlockController.tick(Window)
    actions        : Action

  METHODS
    method init( title, width:Int, height:Int, state=State():State )
      Window = this

      define_control_states( state )

      pixel_size = XY(width,height)
      if (Framework.create_window(this))
        Warlock.add_window( this )
        Renderer.configure_window( this )
      endIf

    method add_background( new_background:BackgroundState )
      background |= new_background

    method add_overlay( new_overlay:OverlayState )
      overlay |= new_overlay

    method add_scene( new_scene:SceneState )
      scene |= new_scene

    method add_screen( new_screen:ScreenState )
      screen |= new_screen

    method add_state( new_state:State )
      state |= new_state

    method background->BackgroundState
      return control_states//background->(as BackgroundState)

    method define_control_states( start_state:State )
      # The order that new blank states are added to the control_states[] table defines
      # the drawing order and corresponding UI event dispatch order of various control
      # state types. Augment-replace in your app to customize.
      control_states//background = null
      control_states//scene      = null
      control_states//screen     = null
      control_states//overlay    = null
      control_states//state      = start_state

    method begin_render [override]
      prior.begin_render
      forEach (entry in control_states.reverse_entries)
        if local state = entry.value
          state.on_begin_render
        endIf
      endForEach
      Renderer.on_begin_render( this )

    method begin_tick [override]
      Window = this
      Framework.update_window_size( this )
      prior.begin_tick

    method change_background( new_background:BackgroundState )
      if local background = control_states//background
        control_states//background.change( new_background )
      else
        control_states//background = new_background
      endIf

    method change_overlay( new_overlay:OverlayState )
      if local overlay = control_states//overlay
        control_states//overlay.change( new_overlay )
      else
        control_states//overlay = new_overlay
      endIf

    method change_scene( new_scene:SceneState )
      if local scene = control_states//scene
        control_states//scene.change( new_scene )
      else
        control_states//scene = new_scene
      endIf

    method change_screen( new_screen:ScreenState )
      if local screen = control_states//screen
        control_states//screen.change( new_screen )
      else
        control_states//screen = new_screen
      endIf

    method change_state( new_state:State )
      if local state = control_states//state
        control_states//state.change( new_state )
      else
        control_states//state = new_state
      endIf

    method close
      Warlock.windows.remove( this )
      Framework.close_window( this )

    method dispatch( e:KeyEvent, to_state=Window.control_states.top_layer:ControlState )
      if (to_state) to_state.handle( e )
      else          handle( e )

    method dispatch( e:MultitouchEvent, to_state=Window.control_states.top_layer:ControlState )
      if (to_state) to_state.handle( e )
      else          handle( e )

    method dispatch( e:PointerEvent, to_state=Window.control_states.top_layer:ControlState )
      if (to_state) to_state.handle( e )
      else          handle( e )

    method dispatch( e:ScrollEvent, to_state=Window.control_states.top_layer:ControlState )
      if (to_state) to_state.handle( e )
      else          handle( e )

    method dispatch( e:TextEvent, to_state=Window.control_states.top_layer:ControlState )
      if (to_state) to_state.handle( e )
      else          handle( e )

    method dispatch_draw
      draw_state( Window.control_states.top_layer )

    method dispatch_update
      control_states.modified = false
      control_states.update_display_order

      forEach (entry in control_states.reverse_entries)
        if local original_state = entry.value
          local updated_state = original_state.updated
          if (entry.value is original_state)  # if not then the head state was changed during update; leave it
            updated_state = ControlState.ordered( updated_state )
            if (updated_state is not original_state)
              entry.value = updated_state
              control_states.modified = true
            endIf
          endIf
        endIf
      endForEach

      while (control_states.modified)
        # Some new control states may not have gotten their first update
        # during the update pass above. Make sure all states are started
        # before letting them handle other events.
        control_states.modified = false
        control_states.update_display_order

        forEach (entry in control_states.entries)
          if local original_state = entry.value
            local started_state = original_state.started
            if (entry.value is original_state)
              if (original_state is not started_state)
                entry.value = started_state
                control_states.modified = true
              endIf
            endIf
          endIf
        endForEach
      endWhile

      update

    method draw [override]
      @ui?.draw

      block cur = actions
        while (cur)
          cur.on_draw
          cur .= concurrent_state
        endWhile
      endBlock

    method draw_state( state:ControlState )
      if (state) state.draw
      else       draw

    method end_render [override]
      prior.end_render

      forEach (entry in control_states.reverse_entries)
        if local state = entry.value
          state.on_end_render
        endIf
      endForEach

      if (Warlock.windows.count and Warlock.windows.first is this) OverlayLog.draw
      Renderer.on_end_render( this )

    method handle( e:KeyEvent )
      @ui?.handle( e )

    method handle( e:MultitouchEvent )
      @ui?.handle( e )

    method handle( e:PointerEvent )
      @ui?.handle( e )

    method handle( e:ScrollEvent )
      @ui?.handle( e )

    method handle( e:TextEvent )
      @ui?.handle( e )

    method handle_app_resume
      Framework.handle_app_resume( this )
      Renderer.handle_app_resume( this )

    method native_id->Int
      noAction  # defined by extended Platform, e.g. SDL

    method overlay->OverlayState
      return control_states//overlay->(as OverlayState)

    method remove_background( background:BackgroundState )
      if local cur_background = control_states//background
        control_states//background = cur_background.removing( background )
      endIf

    method remove_overlay( overlay:OverlayState )
      if local cur_overlay = control_states//overlay
        control_states//overlay = cur_overlay.removing( overlay )
      endIf

    method remove_scene( scene:SceneState )
      if local cur_scene = control_states//scene
        control_states//scene = cur_scene.removing( scene )
      endIf

    method remove_screen( screen:ScreenState )
      if local cur_screen = control_states//screen
        control_states//screen = cur_screen.removing( screen )
      endIf

    method remove_state( state:State )
      if local cur_state = control_states//state
        control_states//state = cur_state.removing( state )
      endIf

    method safe_area->Box [override]
      if (System.is_ios) return iOS.safe_area
      return bounds

    method scene->SceneState
      return control_states//scene->(as SceneState)

    method screen->ScreenState
      return control_states//screen->(as ScreenState)

    method set_background( background:BackgroundState )
      control_states//background = background

    method set_overlay( overlay:OverlayState )
      control_states//overlay = overlay

    method set_scene( scene:SceneState )
      control_states//scene = scene

    method set_screen( screen:ScreenState )
      control_states//screen = screen

    method set_state( state:State )
      control_states//state = state

    method state->State
      return control_states//state->(as State)

    method update [override]
      if (@ui)
        ui.update( bounds )
        ui.request_redraw
      endIf

      if (actions) actions = actions.updated

endClass

augment UI::Event
  PROPERTIES
    window = Window : Warlock::Window
endAugment
