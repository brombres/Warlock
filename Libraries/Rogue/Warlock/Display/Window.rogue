library Warlock

class Window : Display [singleton]
  PROPERTIES
    title       : String

    scene       = Scene()
    screen      = Screen()
    state       : State

    is_scene_modified  : Logical
    is_screen_modified : Logical
    is_state_modified  : Logical

    old_size    : XY  # used to detect size changes in WarlockController.tick(Window)
    actions     : Action

  METHODS
    method init( title, width:Int, height:Int, state=State() )
      Window = this
      pixel_size = XY(width,height)
      if (Framework.create_window(this))
        Warlock.add_window( this )
        Renderer.configure_window( this )
      endIf

    method begin_render [override]
      prior.begin_render
      state.on_begin_render
      screen.on_begin_render
      scene.on_begin_render
      Renderer.on_begin_render( this )

    method begin_tick [override]
      Window = this
      Framework.update_window_size( this )
      prior.begin_tick

    method change_scene( new_scene:Scene )
      scene.change_scene( new_scene )

    method change_screen( new_screen:Screen )
      screen.change_screen( new_screen )

    method change_state( new_state:State )
      state.change( new_state )

    method close
      Warlock.windows.remove( this )
      Framework.close_window( this )

    method draw [override]
      @ui?.draw

      block cur = actions
        while (cur)
          cur.on_draw
          cur .= concurrent_state
        endWhile
      endBlock


    method end_render [override]
      prior.end_render

      state.on_end_render
      screen.on_end_render

      if (Warlock.windows.count and Warlock.windows.first is this) OverlayLog.draw
      Renderer.on_end_render( this )

    method handle( e:KeyEvent )
      if (@ui) @ui.handle( e )

    method handle( e:MultitouchEvent )
      if (@ui) @ui.handle( e )

    method handle( e:PointerEvent )
      if (@ui) @ui.handle( e )

    method handle( e:ScrollEvent )
      if (@ui) @ui.handle( e )

    method handle( e:TextEvent )
      if (@ui) @ui.handle( e )


    method handle_app_resume
      Framework.handle_app_resume( this )
      Renderer.handle_app_resume( this )

    method native_id->Int
      noAction  # defined by extended Platform, e.g. SDL

    method remove_scene( scene:Scene )
      @scene = scene.removing( scene )

    method remove_screen( screen:Screen )
      @screen = screen.removing( screen )

    method remove_state( state:State )
      @state = state.removing( state )

    method render
      state.draw( &!fg )
      state.draw( &fg )

    method scene->Scene
      if (is_scene_modified)
        is_scene_modified = false
        @scene = WarlockState<<Scene>>.reordered( @scene )
      endIf
      return @scene

    method screen->Screen
      if (is_screen_modified)
        is_screen_modified = false
        @screen = WarlockState<<Screen>>.reordered( @screen )
      endIf
      return @screen

    method set_scene( @scene )
      is_scene_modified = true

    method set_screen( @screen )
      is_screen_modified = true

    method set_state( @state )
      is_state_modified = true

    method state->State
      if (is_state_modified)
        is_state_modified = false
        @state = WarlockState<<State>>.reordered( @state )
      endIf
      return @state

    method update [override]
      if (@ui)
        ui.update( bounds )
        ui.request_redraw
      endIf

endClass

augment UI::Event
  PROPERTIES
    window : Warlock::Window
endAugment
