library Warlock

class Window : Display [singleton]
  PROPERTIES
    title      : String
    ui : UI

  METHODS
    method init( title, width:Int, height:Int )
      Window = this
      pixel_size = XY(width,height)
      if (Framework.create_window(this))
        Warlock.add_window( this )
        Renderer.configure_window( this )
      endIf

    method begin_render [override]
      prior.begin_render
      Renderer.on_begin_render( this )

    method begin_tick [override]
      Window = this
      Framework.update_window_size( this )
      prior.begin_tick

    method close
      Warlock.windows.remove( this )
      Framework.close_window( this )

    method draw [override]
      @ui?.draw

    method end_render [override]
      prior.end_render
      if (Warlock.windows.count and Warlock.windows.first is this) OverlayLog.draw
      Renderer.on_end_render( this )

    method handle( e:KeyEvent )
      if (@ui) @ui.handle( e )

    method handle( e:PointerEvent )
      if (@ui) @ui.handle( e )

    method handle( e:ScrollEvent )
      if (@ui) @ui.handle( e )

    method handle( e:TextEvent )
      if (@ui) @ui.handle( e )

    method native_id->Int
      noAction  # defined by extended Platform, e.g. SDL

    method render
      State.draw( &!fg )
      State.draw( &fg )

    method set_ui_layer( new_ui_layer:Component ) [override]
      if (@ui_layer) ui.remove( @ui_layer )
      @ui_layer = new_ui_layer
      ui.insert( new_ui_layer )

    method ui->UI [override]
      if (@ui) return @ui
      ui = UI()
      return ui

    method update [override]
      if (@ui)
        ui.update( bounds )
        ui.request_redraw
      endIf

    method update_ui_layering [override]
      if (@ui_layer or Screen.@ui_layer or State.@ui_layer) ui  # ensure created

      if (@ui)
        contingent
          local cur = @ui.first_child
          if (@ui_layer)        necessary (@ui_layer is cur);        cur = cur?.next
          if (Screen.@ui_layer) necessary (Screen.@ui_layer is cur); cur = cur?.next
          if (State.@ui_layer)  necessary (State.@ui_layer is cur);  cur = cur?.next
          necessary (cur is null)
        unsatisfied
          # Rebuild UI layering
          @ui.clear
          if (@ui_layer) @ui.add( @ui_layer )
          if (Screen.@ui_layer) @ui.add( Screen.@ui_layer )
          if (State.@ui_layer) @ui.add( State.@ui_layer )
        endContingent
      endIf
endClass

augment UI::Event
  PROPERTIES
    window : Warlock::Window
endAugment
