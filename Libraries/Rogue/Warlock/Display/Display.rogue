library Warlock

$include Warlock/Display/RenderTarget
$include Warlock/Display/IDManager
$include Warlock/Display/Window

uses Control/UpdateTimer

class Display [singleton]
  AUTO_ID

  PROPERTIES
    dt                : Real # Interval since last update, in seconds.
    delta_ticks       : Int  # 60ths of a second since last update
    update_timer      = UpdateTimer()

    #{
    dt_updater        = Action( Action.INDEFINITE ) subclass
                          METHODS
                            method on_update
                              Display.dt = dt
                        endSubclass
    }#

    pixel_size        : XY   # True size in pixels.
    size              : XY   # Scaled size.
    scale_to_fit_size : XY?
    fixed_size        : XY?
    density = 1.0 # May be 2 or 3 (etc.) for Retina and other HD displays.

    projection_mode = ProjectionMode2DX : ProjectionMode

    perspective_center : XY
    # The proportional "origin" for 2D+ perspective and the vanishing point for
    # polygons parallel to the camera axis.  Automatically reset to (0.5,0.5)
    # at the beginning of every draw.

    clear_color         = Color.BLACK : Color
    should_clear_color  : Logical

    transform_stack       : TransformStackState  # 'use Display.transform_stack / ... / endUse'
    view_projection       : Matrix   # projection * view
    world_transform       : Matrix   # view * object
    projection_transform  : Matrix
    view_transform        : Matrix
    transform             : Matrix   # object transform
    transforms            = Matrix[] # object transform stack
    view_projection_modified = true
    world_transform_modified = true
    rotation              : Quaternion
    rotation_stack        = Quaternion[]

    clip                  : Box?
    clip_stack            = Box?[]

  GLOBAL METHODS
    method on_singleton_change( old_display:Display, new_display:Display, &before )
      if (before) Renderer.flush
      else        Renderer.display_id = new_display.id

  METHODS
    method on_cleanup
      IDManager.return_id( this )

  METHODS
    method at( p:XY )->XY
      return p * size

    method begin_render
      Display = this
      reset

    method bounds->Box
      return Box( size )

    method center->XY
      return size/2

    method clear
      should_clear_color = true

    method clear( clear_color )
      should_clear_color = true

    method clear_clip
      clip_stack.clear
      clip = null

    method draw
      noAction

    method end_render
      Display = this

    method height->Real
      return size.y

    method pop_clip( n=1:Int )
      #if (n >= 1 and n >= clip_stack.count)
      #  clip_stack.discard_last( n - 1 )
      #  clip = clip_stack.remove_last
      #endIf
Log.println "1 pop_clip"
      clip = clip_stack.remove_last
Log.println "2 pop_clip: " + clip

    method push_rotation( q:Quaternion )
      if (rotation_stack.count)
        rotation_stack.add( rotation_stack.last * q )
      else
        rotation_stack.add( q )
      endIf
      set_rotation( rotation_stack.last, &preserve_stack )

    method push_transform( m:Matrix )
      if (transforms.count)
        transforms.add( transforms.last * m )
      else
        transforms.add( m )
      endIf
      set_transform( transforms.last, &preserve_stack )

    method pop_rotation( n=1:Int32 )
      forEach (1..n.or_smaller(rotation_stack.count))
        rotation_stack.remove_last
      endForEach
      if (rotation_stack.count) set_rotation( rotation_stack.last, &preserve_stack )
      else                      set_rotation( Quaternion(), &preserve_stack )

    method pop_transform( n=1:Int32 )
      forEach (1..n.or_smaller(transforms.count))
        transforms.remove_last
      endForEach
      if (transforms.count) set_transform( transforms.last, &preserve_stack )
      else                  set_transform( Matrix.identity, &preserve_stack )

    method push_clip( new_clip:Box? )
      clip_stack.add( clip )

      if (new_clip)
        if (clip)
          new_clip = clip.value & new_clip.value
          if (not new_clip)
            # No interesection, but don't use 'null' as that means "no clip".
            new_clip = Box(0,0,0,0)
          endIf
        endIf
      endIf

Log.println "1 set to " + new_clip
      clip = new_clip
Log.println "2 set to " + new_clip

    method render
      Display = this

    method reset
      #dt_updater.updated
      (dt,delta_ticks) = update_timer.update

      perspective_center = XY(0.5,0.5)
      view_transform   = Matrix.identity
      transform = Matrix.identity
      transforms.clear
      rotation = Quaternion()
      rotation_stack.clear
      should_clear_color = false
      update_size
      clear_clip

    method safe_area->Box
      return bounds

    method scale_to_fit( scale_to_fit_size )
      if (scale_to_fit_size) @fixed_size = null
      update_size

    method set_clip( new_clip:Box? )
      if (clip != new_clip)
        Renderer.flush

        if (new_clip)
          local world_transform = world_transform
          local scale = (pixel_size / size).x
          local pos  = (world_transform*new_clip.value.position).xy * scale
          local size = (world_transform*new_clip.value.size).xy * scale
          new_clip = Box( pos, size ).floor
        endIf

        @clip = new_clip
      endIf

    method set_fixed_size( @fixed_size )
      if (fixed_size) @scale_to_fit_size = null
      update_size

    method set_perspective_center( new_center:XY )
      if (perspective_center != new_center)
        @perspective_center = new_center
        projection_mode.update
      endIf

    method set_projection_mode( new_mode:ProjectionMode )
      if (projection_mode != new_mode)
        @projection_mode = new_mode
        projection_mode.update
      endIf

    method set_rotation( new_rotation:Matrix, &preserve_stack )
      if (not preserve_stack) rotation_stack.clear
      if (rotation != new_rotation)
        <Display.modify_object_transform>.signal
        @rotation = new_rotation
      endIf

    method set_transform( new_transform:Matrix, &preserve_stack )
      if (not preserve_stack) transforms.clear
      if (transform != new_transform)
        <Display.modify_object_transform>.signal
        @transform = new_transform
        world_transform_modified = true
      endIf

    method set_pixel_size( new_pixel_size:XY )
      if (pixel_size != new_pixel_size)
        @pixel_size = new_pixel_size
        update_size
      endIf

    method set_projection_transform( new_transform:Matrix )
      if (projection_transform != new_transform)
        <Display.modify_view_projection>.signal
        @projection_transform = new_transform
        view_projection_modified = true
      endIf

    method set_size( new_size:XY )
      if (size == new_size) return

      Renderer.flush
      @size = new_size
      projection_mode.update

    method set_ui( ui:WarlockUI )
      noAction

    method set_view_transform( new_transform:Matrix )
      if (view_transform != new_transform)
        <Display.modify_view_projection>.signal
        @view_transform = new_transform
        view_projection_modified = true
        world_transform_modified = true
      endIf

    method ui->UI
      return null

    method update
      noAction

    method update_size
      Renderer.flush
      if local fit_size = scale_to_fit_size
        local scale = (fit_size / pixel_size).min
        @size = (pixel_size * scale).floor
      elseIf local sz = fixed_size
        @size = sz
      else
        @size = pixel_size
      endIf
      projection_mode.update

    method view_projection->Matrix
      # projection * view
      if (view_projection_modified)
        view_projection = projection_transform * view_transform
        view_projection_modified = false
      endIf
      return @view_projection

    method world_transform->Matrix
      # view * object
      if (world_transform_modified)
        world_transform = view_transform * transform
        world_transform_modified = false
      endIf
      return @world_transform


    method width->Real
      return size.x

endClass

class TransformStackState( original_transform_count:Int, original_rotation_count:Int ) [compound]
  METHODS
    method on_use->this [mutating]
      original_transform_count = Display.transforms.count
      original_rotation_count = Display.rotation_stack.count
      return this

    method on_end_use( state:TransformStackState )
      local n = Display.transforms.count - state.original_transform_count
      if (n) Display.pop_transform( n )

      n = Display.rotation_stack.count - state.original_rotation_count
      if (n) Display.pop_rotation( n )
endClass
