library Warlock

class RenderTarget : Display
  PROPERTIES
    previous_display : Display
    image            : RenderTargetImage
    power_of_2       : Logical
    round_down       : Logical

  METHODS
    method init( pixel_size, power_of_2=false, round_down=false )
      # Creates an offscreen render target.
      #
      # Rounds the width and height either up (default) or down (&round_down)
      # to the nearest power of 2.
      #
      # Some use cases such as drawing a 2D shadow layer do not need a 1:1
      # pixel match with the main display and can round down their size to
      # conserve memory.
      #
      # The initial pixel_size sets the logical resolution of the offscreen
      # buffer but can be changed after initialization.
      noAction

    method init( width:Int, height:Int, &power_of_2, &round_down )
      # Creates an offscreen render target.
      #
      # Rounds the width and height either up (default) or down (&round_down)
      # to the nearest power of 2.
      #
      # Some use cases such as drawing a 2D shadow layer do not need a 1:1
      # pixel match with the main display and can round down their size to
      # conserve memory.
      init( XY(width,height), &=power_of_2, &=round_down )

    method image->RenderTargetImage
      prepare
      return @image

    method prepare
      if (@image) return
      image = RenderTargetImage( pixel_size.x, pixel_size.y, &=power_of_2, &=round_down )
      pixel_size = @image.texture.size  # may have been adjusted
      Renderer.configure_render_target( this )

    method begin_render [override]
      prepare
      previous_display = Display
      Display = this
      reset

      Renderer.on_render_begin( this )
      prior.render

    method end_render [override]
      Renderer.on_render_end( this )
      Display = previous_display

    method on_use->RenderTarget
      begin_render
      return this

    method on_end_use( render_target:RenderTarget )
      end_render

    method update_size( texture_size:XY )
      if (texture_size == pixel_size) return
      pixel_size = texture_size
      if (not @image) return

      local needs_config = image.update_size( texture_size.x, texture_size.y, &=power_of_2, &=round_down )
      pixel_size = @image.texture.size  # may have been adjusted
      if (needs_config) Renderer.configure_render_target( this )

endClass
