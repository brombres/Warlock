library Warlock

class OverlayLog : BufferedPrintWriter<<output_buffer>> [essential singleton]
  PROPERTIES
    font  = SystemFont.cloned : SystemFont
    lines = String[]
    timer = Timer(6.0)  # time until lines removed
    max_lines = 20 : Int?
    continue_last_line : Logical  # previous flush ended without a newline

  METHODS
    method init
      Global.output = this

    method clear
      lines.clear

    method draw
      if (not lines.count) return
      #if (not lines.count and not Plasmacore.show_fps) return

      #Display.push_clip( null )

      local max = Display.height / font.height
      if (max_lines.exists and max_lines.value < max) max = max_lines.value
      while (lines.count > max) lines.remove_first

      font.scale = Display.density
      local y = Display.safe_area.position.y

      temporarily font.color=Color.WHITE, font.anchor=Anchor.TOP_LEFT, font.opacity=timer.remaining.clamped(0,1.0)
        forEach (line in lines)
          font.draw( line, XY(0,y) )
          y += font.height
        endForEach

        #if (Plasmacore.show_fps)
        #  font.draw( "fps:$" (Plasmacore.fps), XY(0,0) )
        #  y += font.height
        #endIf
      endTemporarily

      #Display.pop_clip

    method flush( buffer:String )
      if (buffer.count == 0) return # flush operation

      timer.restart
      Console.write( buffer )  # echo the message to the console

      # BufferedPrintWriter flushes early once the buffer exceeds 1024 characters,
      # so a flush may end mid-line. Always go through LineReader (which yields
      # fresh copies - 'buffer' itself is cleared below) and splice a partial
      # trailing line together with the start of the next flush.
      local ends_with_newline = (buffer.last == '\n')
      forEach (line in LineReader(buffer))
        if (continue_last_line and lines.count)
          lines.last.print( line )
          continue_last_line = false
        else
          lines.add( line )
        endIf
      endForEach
      continue_last_line = not ends_with_newline
      buffer.clear

    method update
      if (timer.is_expired) lines.clear

endClass

