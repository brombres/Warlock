library Entity

uses Warlock

augment Entity::Entity2D
  PROPERTIES
    position : XY

  METHODS
    method draw
      draw( position )

    method draw( position:XY )
      if (attributes.hidden) return
      use Display.transform_stack
        .begin_draw

        .push_transform( position )

        .handle_draw( &!fg )
        .handle_draw( &fg )
      endUse

    method draw( bounds:Box )
      if (attributes.hidden) return
      use Display.transform_stack
        .begin_draw
        Display.push_transform(
          Matrix.translate( XYZ(bounds.position,z) ) *
          Matrix.scale( bounds.size/nominal_size )
        )
        .handle_draw( &!fg )
        .handle_draw( &fg )
      endUse

    method .push_transform( position:XY )
      if (rotation.is_identity)
        Display.push_transform(
          Matrix.transform(
            XYZ(position,z),
            anchor,
            size,
            nominal_size,
            scale_z
          )
        )
      else
        Display.push_rotation( rotation )
        Display.push_transform(
          Matrix.transform(
            XYZ(position,z),
            anchor,
            size,
            nominal_size,
            scale_z,
            rotation
          )
        )
      endIf

    method .pop_transform
      if (rotation.is_identity)
        Display.pop_transform
      else
        Display.pop_transform
        Display.pop_rotation
      endIf
endAugment
