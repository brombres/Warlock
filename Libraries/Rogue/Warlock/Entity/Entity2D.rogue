library Entity

uses Warlock

augment Entity::Entity2D
  PROPERTIES
    position       : XY
    display_bounds : Box  # internal use; changes with every draw call

  METHODS
    method draw
      draw( position )

    method draw( position:XY )
      if (attributes.invisible) return
      use Display.transform_stack
        .begin_draw

        .push_transform( position )

        .handle_draw( &!over )
        .handle_draw( &over )
      endUse

    method draw( display_bounds )
      if (attributes.invisible) return

      .begin_draw
      .handle_draw( &!over )
      .handle_draw( &over )

      #{
      local scale = bounds.size / natural_size
      temporarily this.scale = scale
        use Display.transform_stack
          .begin_draw
          Display.push_transform(
            Matrix.translate( XYZ(bounds.position,z) ) *
            Matrix.scale( scale )
          )
          .handle_draw( &!over )
          .handle_draw( &over )
        endUse
      endTemporarily
      }#

    method .push_transform( position:XY )
      if (rotation.is_identity)
        Display.push_transform(
          Matrix.transform(
            XYZ(position,z),
            anchor,
            size,
            natural_size,
            scale_z
          )
        )
      else
        Display.push_rotation( rotation )
        Display.push_transform(
          Matrix.transform(
            XYZ(position,z),
            anchor,
            size,
            natural_size,
            scale_z,
            rotation
          )
        )
      endIf

      display_bounds = Box( natural_size )

    method .pop_transform
      if (rotation.is_identity)
        Display.pop_transform
      else
        Display.pop_transform
        Display.pop_rotation
      endIf
endAugment
