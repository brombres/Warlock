library Warlock

nativeHeader @|#include "WarlockInterface.h"

$include Warlock/Macros

$include Warlock/Data/AppData
$include Warlock/Data/AssetInfo
$include Warlock/Data/AssetManager
$include Warlock/Display/Canvas
$include Warlock/Display/Display
$include Warlock/Display/IDManager
$include Warlock/Display/Window
$include Warlock/Framework/Framework
$include Warlock/Control/Screen
$include Warlock/Control/State
$include Warlock/Control/WarlockState
$include Warlock/Entity/Entity
$include Warlock/Geometry
$include Warlock/Geometry/Box
$include Warlock/Geometry/Line
$include Warlock/Geometry/Quad
$include Warlock/Geometry/Triangle
$include Warlock/Graphics/Bitmap
$include Warlock/Graphics/BitmapIO
$include Warlock/Graphics/BlendMode
$include Warlock/Graphics/Drawable2D
$include Warlock/Graphics/Font
$include Warlock/Graphics/Image/ColorFillImage
$include Warlock/Graphics/Image/Image
$include Warlock/Graphics/Image/ImageInfo
$include Warlock/Graphics/Image/PatchImage
$include Warlock/Graphics/Image/RenderTargetImage
$include Warlock/Graphics/Image/TextureImage
$include Warlock/Graphics/Image/TextureMeshImage
$include Warlock/Graphics/Mesh
$include Warlock/Graphics/PrimitiveType
$include Warlock/Graphics/ProjectionMode
$include Warlock/Graphics/RenderMode
$include Warlock/Graphics/RenderTargetTexture
$include Warlock/Graphics/Renderer
$include Warlock/Graphics/RendererBatch
$include Warlock/Graphics/Shader
$include Warlock/Graphics/Spine
$include Warlock/Graphics/SystemFont
$include Warlock/Graphics/Texture
$include Warlock/Graphics/Vertex
$include Warlock/UI
$include Warlock/Utility/Log
$include Warlock/Utility/OverlayLog

uses Control/State [export]
uses Entity        [export]
uses Geometry      [export]
uses Graphics      [export]
uses Math/Matrix   [export]
uses UI            [export]
uses Utility/Timer [export]

class Warlock [essential singleton]
  GLOBAL METHODS
    method configure [api]
      Warlock.on_configure

    method handle_event->Logical [api]
      local keep_running = Framework.handle_native_event

      if (not keep_running)
        use list = Warlock.windows.working_copy
          (forEach in list).close
        endUse
      endIf

      return keep_running


    method update->Logical [api]
      OverlayLog.update
      Warlock.render
      ++Warlock.frames

      return true  # keep running

  PROPERTIES
    configured     : Logical
    windows        = Window[]
    textures       = [File:Texture]
    frames         : Int

  METHODS
    method init
      OverlayLog
      Log.println "Initializing Warlock"
      <Display.transform_modified>.on_signal( () => Renderer.flush )

    method add_window( window:Window )
      windows.add( window )

    method find_asset( name:String )->File?
      local filepath = native("WarlockInterface_find_asset($name)")->String
      if (filepath) return File( filepath )
      else          return null

    method find_data_file( file:File )->File?
      if (not file.filepath.begins_with("Assets/Data/"))
        if (file.filepath.begins_with("Data/")) file = "Assets"/file
        else                                    file = "Assets/Data"/file
      endIf

      return find_asset( file.filepath )

    method find_window( id=null:Int?, native_id=null:Int? )->Window
      if local native_id = native_id
        forEach (window in windows)
          if (window.native_id == native_id) return window
        endForEach
      endIf

      if local id = id
        forEach (window in windows)
          if (window.id == id) return window
        endForEach
      endIf

      return null

    method load_asset_bytes( filepath:String )->Byte[]
      if (filepath) return Byte[]( File(filepath) )
      else          return null

    method on_configure
      AssetManager.load

      if (windows.is_empty)
        Window( "Warlock", 1280, 720 )
      endIf

    method render
      (forEach in windows).begin_render

      State = State.updated || State()
      Screen = Screen.updated || Screen()

      State.on_render_begin
      (forEach in windows).render

      State.on_render_end
      (forEach in windows).end_render

endClass
