library Warlock

nativeHeader @|#include "WarlockInterface.h"

$include Warlock/Macros

$include Warlock/Audio
$include Warlock/Data
$include Warlock/Display
$include Warlock/Framework/Framework
$include Warlock/Control
$include Warlock/Entity/Entity
$include Warlock/Geometry
$include Warlock/Graphics
$include Warlock/GUI
$include Warlock/Platform
$include Warlock/Utility

uses Control/State [export]
uses Entity        [export]
uses Geometry      [export]
uses Graphics      [export]
uses Math/Matrix   [export]
uses GUI           [export]
uses Utility/Timer [export]

class Warlock [essential singleton]
  GLOBAL METHODS
    method configure [api]
      Warlock.controller.configure

    method handle_dock_icon_click [api]
      Warlock.controller.on_dock_icon_clicked

    method handle_event->Logical [api]
      local keep_running = Framework.handle_native_event

      if (not keep_running)
        use list = Warlock.windows.working_copy
          (forEach in list).close
        endUse
      endIf

      return keep_running

    method tick->Logical [api]
      if (not Warlock.is_suspended)
        Warlock.controller.tick
      endIf
      return true  # keep running

  PROPERTIES
    windows      = Window[]
    textures     = [File:Texture]
    ticks        : Int
    actions      : Action
    controller   = WarlockController()
    is_suspended : Logical

  METHODS
    method init
      OverlayLog
      Log.println "Initializing Warlock"
      <Display.modify_view_projection>.on_signal( () => Renderer.flush )
      <Display.modify_object_transform>.on_signal( () => Renderer.apply_object_transform )

    method add_window( window:Window )
      windows.add( window )

    method application_data_folder->File
      if (System.is_apple)
        return Apple.application_data_folder
      else
        println "TODO: defined Warlock.application_data_folder() for $"(System.os)
        return File( "~" )
      endIf

    method cache_folder->File
      if (System.is_apple)
        return Apple.cache_folder
      else
        println "TODO: defined Warlock.cache_folder() for $"(System.os)
        return File( "~" )
      endIf

    method user_data_folder->File
      if (System.is_apple)
        return Apple.user_data_folder
      else
        println "TODO: defined Warlock.user_data_folder() for $"(System.os)
        return File( "~" )
      endIf

    method find_asset( name:String )->File?
      local filepath = native("WarlockInterface_find_asset($name)")->String
      if (filepath) return File( filepath )
      else          return null

    method find_audio_file( file:File )->File?
      if (not file.filepath.begins_with("Assets/Audio/"))
        if (file.filepath.begins_with("Audio/")) file = "Assets"/file
        else                                     file = "Assets/Audio"/file
      endIf

      return find_asset( file.filepath )

    method find_data_file( file:File )->File?
      if (not file.filepath.begins_with("Assets/Data/"))
        if (file.filepath.begins_with("Data/")) file = "Assets"/file
        else                                    file = "Assets/Data"/file
      endIf

      return find_asset( file.filepath )

    method find_window( id=null:Int?, native_id=null:Int? )->Window
      if local native_id = native_id
        forEach (window in windows)
          if (window.native_id == native_id) return window
        endForEach
      endIf

      if local id = id
        forEach (window in windows)
          if (window.id == id) return window
        endForEach
      endIf

      return null

    method load_asset_bytes( filepath:String )->Byte[]
      if (filepath) return Byte[]( File(filepath) )
      else          return null

    method on_configure
      controller.configure

endClass
