library Warlock

class AppData [singleton]
  PROPERTIES
    data = @{}

  METHODS
    method disconnect_on_change( key:String )
      data.disconnect_on_change( key )

    method disconnect_on_change( path:GlobalID )
      data.disconnect_on_change( path )

    method entry( path:GlobalID )->VariantEntry
      # E.g. <AppData.a.b> or <a.b>
      return AppDataValue( path )

    method entry( path:String )->VariantEntry
      # E.g. "<AppData.a.b>", "<a.b>", or "a.b"
      if (path.begins_with("<AppData."))
        return data.entry( "<" + path.after_first("<AppData.") )
      elseIf (path.begins_with("AppData."))
        return data.entry( "<" + path.after_first("AppData.") + ">" )
      elseIf (not path.begins_with("<"))
        return data.entry( "<" + path + ">" )
      else
        return data.entry( path )
      endIf

    method get( key:GlobalID )->Variant
      return entry( key )->Variant

    method get( key:String )->Variant
      if (key.begins_with('<') or key.contains('.'))
        return entry( key )->Variant
      else
        return data[key]
      endIf

    method load( json:String )
      data = JSON( json ).parse_table || @{}

    method on_change( key:String, signal:SignalID )
      data.on_change( key, signal )

    method on_change( key:String, global_id:GlobalID )
      data.on_change( key, global_id )

    method on_change( path:GlobalID, signal:SignalID )
      data.on_change( path, signal )

    method on_change( path:GlobalID, global_id:GlobalID )
      data.on_change( path, global_id )

    method set( key:GlobalID, value:Variant )
      entry( key ).set( value )

    method set( key:String, value:Variant )
      if (key.begins_with('<') or key.contains('.'))
        entry( key ).set( value )
      else
        data[key] = value
      endIf

    method to->String
      return data->String

    method to->Variant
      return data

endClass

routine AppDataValue( path:GlobalID )->VariantEntry
  if (path.name.begins_with("<AppData."))
    return AppData.data.entry( "<" + path.name.after_first("<AppData.") )
  else
    return AppData.data.entry( path )
  endIf
endRoutine

augment Rogue::GlobalID
  METHODS
    method to->VariantEntryID
      return AppDataValue( this ).id
endAugment

