library Warlock

class AppData [singleton]
  PROPERTIES
    data = @{}

  METHODS
    method disconnect_on_change( key:String )
      data.disconnect_on_change( key )

    method disconnect_on_change( path:GlobalID )
      data.disconnect_on_change( path )

    method get( key:String )->Variant
      return data[key]

    method load( json:String )
      data = JSON( json ).parse_table || @{}

    method on_change( key:String, signal:SignalID )
      data.on_change( key, signal )

    method on_change( key:String, global_id:GlobalID )
      data.on_change( key, global_id )

    method on_change( path:GlobalID, signal:SignalID )
      data.on_change( path, signal )

    method on_change( path:GlobalID, global_id:GlobalID )
      data.on_change( path, global_id )

    method set( key:String, value:Variant )
      data[key] = value

    method to->String
      return data->String

    method to->Variant
      return data

endClass

routine AppDataValue( path:GlobalID )->VariantEntry
  if (path.name.begins_with("<AppData."))
    return AppData.data.entry( "<" + path.name.after_first("<AppData.") )
  else
    return AppData.data.entry( path )
  endIf
endRoutine

