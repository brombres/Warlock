library Warlock

class AssetManager [singleton]
  PROPERTIES
    scanner           : Scanner
    texture_filepaths = String[]
    texture_info      = [String:TextureInfo]
    textures          = [File:WeakReference<<Texture>>]
    assets            = [String:AssetInfo]
    is_loaded         : Logical
    asset_manifest    = [String:String]

  METHODS
    method init
      load

    method asset_listing( pattern:FilePattern )->String[]
      local results = String[]
      forEach (entry in asset_manifest.entries)
        if (entry.key.matches_pattern(pattern)) results.add( entry.value )
      endForEach
      return results

    method load
      if (is_loaded) return
      is_loaded = true

      block
        local assets_parent = ""

        local manifest_filepath = "Assets/AssetManifest.txt"

        # On Android we need to load AssetManifest.txt first for Warlock.find_asset() to work.
        local file : File?
        if ($target("Android"))
          file = File( manifest_filepath )
        else
          if ($target("ObjC"))
            native
            @|NSString* ns_name = Rogue_string_to_ns_string( $manifest_filepath );
             |NSString* ns_filepath = [[NSBundle mainBundle] pathForResource:ns_name ofType:nil];
             |if (ns_filepath)
             |{
                file = File( native("Rogue_ns_string_to_string(ns_filepath)")->String )
                assets_parent = file.value.parent.folder
            native
            @|}
          endIf
        endIf

        if (file)
          forEach (asset_name in LineReader(file.value))
            local asset_filepath = assets_parent / asset_name
            asset_manifest[asset_name] = asset_filepath
          endForEach
        else
          @trace "Cannot load asset manifest"
        endIf
      endBlock

      if local file = Warlock.find_asset( "Assets/AssetConfig.txt" )
        Log.println "Loading AssetConfig.txt"
        scanner = Scanner( file )
        .load_texture_filepaths
        assets.clear
        while (.load_another_asset)
          noAction
        endWhile
        Log.println "# asset".pluralized(assets.count)
      else
        println "[ERROR] Assets/AssetConfig.txt is missing."
      endIf

      #forEach (asset in assets)
      #  if (asset.image_count)
      #    forEach (image_info in asset.images)
      #      local filepath = texture_filepaths[image_info.texture_index]
      #      if (not texture_info.contains(filepath))
      #        texture_info[filepath] = TextureInfo( filepath, asset.image_mipmaps, asset.texture_wrap )
      #      endIf
      #    endForEach
      #  endIf
      #endForEach

    method find_bitmap( name:String )->Bitmap
      if local asset = find_image( name )
        return asset.images[0].bitmap
      else
        local message = ''[Warlock] No such bitmap "$".''(name)
        Log.println message
        return Bitmap( 1, 1, Color.WHITE ).[ error=message ]
      endIf

    method find_font( name:String )->AssetInfo
      load
      use work_name = StringPool
        if (not name.begins_with("Assets/"))
          work_name.print "Assets/"
          if (not name.begins_with("Graphics/"))
            work_name.print "Graphics/"
          endIf
        endIf
        work_name.print name

        return find_asset( work_name )
      endUse

    method find_image( name:String )->AssetInfo
      load
      use work_name = StringPool
        if (not name.begins_with("Assets/"))
          work_name.print "Assets/"
          if (not name.begins_with("Graphics/"))
            work_name.print "Graphics/"
          endIf
        endIf
        work_name.print name

        return find_asset( work_name )
      endUse

    method find_asset( name:String )->AssetInfo
      load
      use candidates = WorkList<<AssetInfo>>
        forEach (asset in assets.values)
          if (asset.filepath.begins_with(name)) candidates.add( asset )
        endForEach

        if (candidates.count)
          # Pick the candidate with the shortest filepath, e.g. "Alpha" matches
          # "Alpha.png" before "AlphaBravo.png".
          local min_length = candidates.first.filepath.count
          min_length .= or_smaller( (forEach in candidates from 1).filepath.count )
          forEach (candidate in candidates)
            if (candidate.filepath.count == min_length) return candidate
          endForEach
        endIf

        return null
      endUse

    method get( name:String )->AssetInfo
      load
      return assets[name]

    method .consume_id( identifier:String )->Logical
      if (not scanner.consume_identifier(identifier)) return false
      .consume_ws
      return true

    method .consume_ws( &eols )
      loop
        if (scanner.consume_whitespace) nextIteration
        if (eols and scanner.consume_eols) nextIteration
        if (scanner.consume('#'))
          scanner.read_line
          nextIteration
        endIf
        return
      endLoop

    method .load_texture_filepaths
      texture_filepaths.clear
      texture_info.clear
      .consume_ws( &eols )
      if (not .consume_id("textures")) return
      local n = scanner.scan_int
      loop (n)
        .consume_ws( &eols )
        local w = scanner.scan_int
        .consume_ws
        local h = scanner.scan_int
        local mipmaps = true
        .consume_ws
        if (.consume_id("mipmaps")) mipmaps = .scan_logical
        local wrap = true
        .consume_ws
        if (.consume_id("wrap")) wrap = .scan_logical
        local filepath = scanner.read_line
        texture_filepaths.add( filepath )
        texture_info[filepath] = TextureInfo( texture_filepaths.last, XY(w,h), &=mipmaps, &=wrap )
      endLoop

    method .load_another_asset->Logical
      .consume_ws( &eols )
      if (not scanner.has_another) return false

      local asset = AssetInfo( scanner.scan_string )

      .consume_ws
      local id = scanner.scan_identifier
      if (id == "image")
        if (not .load_image(asset)) return false
      elseIf (id == "font")
        if (not .load_font(asset)) return false
      else
        println "Unknown asset type in AssetConfig.txt: " + id
        return false
      endIf

      if (not .load_frames(asset)) return false

      assets[asset.filepath] = asset
      return true

    method .load_font( asset:AssetInfo )->Logical
      asset.type = <Font>
      .consume_ws
      asset.font_height = scanner.scan_int
      .consume_ws
      if (.consume_id("variable")) asset.font_width = 0
      else                         asset.font_width = scanner.scan_int
      .consume_ws
      asset.font_characters = scanner.scan_string
      .consume_ws( &eols )
      if (.consume_id("offset"))  asset.font_offset  = .scan_json( scanner ).map_list<<Int>>
      if (.consume_id("advance")) asset.font_advance = .scan_json( scanner ).map_list<<Int>>
      if (.consume_id("kerning"))
        asset.font_kerning = .scan_json( scanner ).map_table<<[Character:[Character:Int]]>>(
          (key,value,table) => table[key] = value.map_table<<[Character:Int]>>
        )
      endIf
      if (.consume_id("monospace"))
        .consume_ws( &eols )
        asset.font_monospace = scanner.scan_int
      endIf
      return true

    method .scan_json( scanner )->Variant
      .consume_ws
      use buffer = StringPool
        scanner.read_line( buffer )
        local result = JSON.parse( buffer )
        .consume_ws( &eols )
        return result
      endUse

    method .load_frames( asset:AssetInfo )->Logical
      local n = asset.image_count
      if (not n) return true

      ensure <<asset.images>>
      loop n
        .consume_ws( &eols )
        local i = scanner.scan_int
        .consume_ws
        local x = scanner.scan_int
        .consume_ws
        local y = scanner.scan_int
        .consume_ws
        local w = scanner.scan_int
        .consume_ws
        local h = scanner.scan_int
        .consume_ws( &eols )
        asset.images.add( ImageInfo(i, Box(x,y,w,h), &wrap=asset.texture_wrap) )
      endLoop

      return true

    method .scan_logical->Logical
      .consume_ws
      if (.consume_id("true")) return true
      .consume_id( "false" )
      return false

    method .load_image( asset:AssetInfo )->Logical
      asset.type = <Image>
      .consume_ws
      asset.image_size.x = scanner.scan_int
      .consume_ws
      asset.image_size.y = scanner.scan_int
      .consume_ws
      if (.consume_id("patch"))
        asset.image_patch_count = scanner.scan_int
        .consume_ws
        asset.image_patch_split.x = scanner.scan_int
        .consume_ws
        asset.image_patch_split.y = scanner.scan_int
        .consume_ws
      endIf
      if (.consume_id("frames")) asset.frame_count = scanner.scan_int
      .consume_ws
      if (.consume_id("mipmaps"))
        .consume_ws
        if (.consume_id("true"))      asset.image_mipmaps = true
        elseIf (.consume_id("false")) asset.image_mipmaps = false
        else                          asset.image_mipmaps = false
      endIf
      .consume_ws
      if (.consume_id("wrap"))
        .consume_ws
        if (.consume_id("true")) asset.texture_wrap = true
      endIf
      .consume_ws( &eols )
      return true

endClass

class TextureInfo( filepath:String, size:XY, mipmaps:Logical, wrap:Logical ) [compound]
endClass
