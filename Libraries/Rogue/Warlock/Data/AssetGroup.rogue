library Warlock

class AssetGroup
  PROPERTIES
    load_on_demand : Logical
    # If true, assets will not be automatically loaded for this group.

  METHODS
    method load( loader:AssetLoadingState ) [critical]
      if (load_on_demand) return

      local properties = this.type_info.properties
      forEach (p in properties)
        local type = p->TypeID
        if (type.instance_of(<<AssetGroup>>))
          loader.include( p.get_value( this )->AssetGroup )
        elseIf (type.instance_of(<<Sound>>))
          loader.include( p.get_value( this )->Sound )
        elseIf (type.instance_of(<<Music[]>>))
          loader.include( p.get_value( this )->Music[] )
        elseIf (type.instance_of(<<Sound[]>>))
          loader.include( p.get_value( this )->Sound[] )
        elseIf (type.instance_of(<<SoundVariants>>))
          loader.include( p.get_value( this )->SoundVariants )
        elseIf (type.instance_of(<<Font>>))
          loader.include( p.get_value( this )->Font )
        elseIf (type.instance_of(<<Image>>))
          loader.include( p.get_value( this )->Image )
        elseIf (type.instance_of(<<Image[]>>))
          loader.include( p.get_value( this )->Image[] )
        elseIf (type.instance_of(<<PatchImage>>))
          loader.include( p.get_value( this )->PatchImage )
        endIf
      endForEach

    method set_is_used( setting:Logical )
      if (load_on_demand and setting) return

      local properties = this.type_info.properties
      forEach (p in properties)
        local type = p->TypeID
        if (type.instance_of(<<AssetGroup>>))
          (p.get_value( this )->AssetGroup).set_is_used( setting )
        elseIf (type.instance_of(<<Sound>>))
          (p.get_value( this )->Sound).set_is_used( setting )
        elseIf (type.instance_of(<<Music[]>>))
          (p.get_value( this )->Music[]).set_is_used( setting )
        elseIf (type.instance_of(<<Sound[]>>))
          (p.get_value( this )->Sound[]).set_is_used( setting )
        elseIf (type.instance_of(<<SoundVariants>>))
          (p.get_value( this )->SoundVariants).set_is_used( setting )
        elseIf (type.instance_of(<<Font>>))
          (p.get_value( this )->Font).set_is_used( setting )
        elseIf (type.instance_of(<<Image>>))
          (p.get_value( this )->Image).set_is_used( setting )
        elseIf (type.instance_of(<<Image[]>>))
          (p.get_value( this )->Image[]).set_is_used( setting )
        elseIf (type.instance_of(<<PatchImage>>))
          (p.get_value( this )->PatchImage).set_is_used( setting )
        endIf
      endForEach

    method unload [critical]
      local properties = this.type_info.properties
      forEach (p in properties)
        local type = p->TypeID
        if (type.instance_of(<<AssetGroup>>))
          (p.get_value( this )->AssetGroup).unload
        elseIf (type.instance_of(<<Sound>>))
          (p.get_value( this )->Sound).unload
        elseIf (type.instance_of(<<Music[]>>))
          (p.get_value( this )->Music[]).unload
        elseIf (type.instance_of(<<Sound[]>>))
          (p.get_value( this )->Sound[]).unload
        elseIf (type.instance_of(<<SoundVariants>>))
          (p.get_value( this )->SoundVariants).unload
        elseIf (type.instance_of(<<Font>>))
          (p.get_value( this )->Font).unload
        elseIf (type.instance_of(<<Image>>))
          (p.get_value( this )->Image).unload
        elseIf (type.instance_of(<<Image[]>>))
          (p.get_value( this )->Image[]).unload
        elseIf (type.instance_of(<<PatchImage>>))
          (p.get_value( this )->PatchImage).unload
        endIf
      endForEach

    method unload_unused [critical]
      local properties = this.type_info.properties
      forEach (p in properties)
        local type = p->TypeID
        if (type.instance_of(<<AssetGroup>>))
          (p.get_value( this )->AssetGroup).unload_unused
        elseIf (type.instance_of(<<Sound>>))
          (p.get_value( this )->Sound).unload_unused
        elseIf (type.instance_of(<<Music[]>>))
          (p.get_value( this )->Music[]).unload_unused
        elseIf (type.instance_of(<<Sound[]>>))
          (p.get_value( this )->Sound[]).unload_unused
        elseIf (type.instance_of(<<SoundVariants>>))
          (p.get_value( this )->SoundVariants).unload_unused
        elseIf (type.instance_of(<<Font>>))
          (p.get_value( this )->Font).unload_unused
        elseIf (type.instance_of(<<Image>>))
          (p.get_value( this )->Image).unload_unused
        elseIf (type.instance_of(<<Image[]>>))
          (p.get_value( this )->Image[]).unload_unused
        elseIf (type.instance_of(<<PatchImage>>))
          (p.get_value( this )->PatchImage).unload_unused
        endIf
      endForEach

endClass
