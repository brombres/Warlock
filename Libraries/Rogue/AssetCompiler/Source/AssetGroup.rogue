library AssetCompiler

class AssetGroup
  PROPERTIES
    id          : Int       # positive integer
    assets      = Asset[]
    filename    : String    # Base filename of texture atlas pages.
    page_info   = @[]
    pages       : AtlasPage[]
    attributes  : AttributeList
    is_modified : Logical
    atlas_padding     = 8
    dynamic_size      : XY  # XY(0,0) = unspecified

  GLOBAL METHODS
    method parse_dynamic_size_attribute( attributes:AttributeList )->XY
      # Returns the dynamic size specified by the first matching attribute:
      #   'SIZE' or 'xSIZE' (e.g. '1024' or 'x1024') -> XY(SIZE,SIZE)
      #   'WxH'             (e.g. '1024x768')        -> XY(W,H)
      # Returns XY(0,0) ("unspecified") if there is no such attribute or if
      # 'fixed_size' is specified.
      if (attributes is null) return XY.zero
      forEach (attribute in attributes)
        if (attribute.name == "fixed_size") return XY.zero
        local size = parse_dynamic_size( attribute.name )
        if (size) return size
      endForEach
      return XY.zero

    method parse_dynamic_size( name:String )->XY
      # Parses 'SIZE', 'xSIZE', or 'WxH'. Returns XY(0,0) if 'name' is not in
      # one of those forms.
      local text = name
      if (text.count >= 2 and text[0] == 'x') text = text.from(1)

      local parts = text.split( 'x' )
      if (parts.count == 0 or parts.count > 2) return XY.zero
      forEach (part in parts)
        if (part.count == 0) return XY.zero
        forEach (ch in part)
          if (ch < '0' or ch > '9') return XY.zero
        endForEach
      endForEach

      local w = parts[0]->Int
      local h = which{ parts.count==2:parts[1]->Int || w }
      return XY( w, h )

  METHODS
    method configure_id
      if (not id) id = GroupIDManager.next_id

      use file_letter = StringPool
        .base26( id-1, file_letter )
        filename = "TextureAtlas-$"(file_letter)
      endUse

    method add( asset:Asset )
      assets.add( asset )

    method check_for_changes( info:Variant )
      contingent
        necessary (info//attributes.count == attributes?.count)
        if (attributes)
          forEach (key in info//attributes.keys)
            local attr = attributes.find( key )
            necessary (attr)
            necessary (attribute_variant(attr) == info//attributes[key])
          endForEach
        endIf
      unsatisfied
        is_modified = true
      endContingent

    method process
      which (assets.first.type)
        case <Image>, <Font>
          pages = ImagePacker( this ).[atlas_padding=atlas_padding].pack( assets )
          (forEach in assets).update_placement_info

        case <Sound>, <Music>
          # Make sure the build's Audio folder exists even if it was deleted
          # out from under a previous build.
          (AssetCompiler.assets_folder/"Audio").create_folder
          forEach (asset in assets)
            local output_file = audio_output_file( asset )
            if (File(asset.filepath).is_different_than(output_file))
              File( asset.filepath ).copy_to( output_file, &verbose )
            endIf
          endForEach

        case <Binary>
          local output_folder = AssetCompiler.assets_folder.parent.filepath
          forEach (asset in assets)

            local output_filepath = asset.filepath
            if (not output_filepath.begins_with("Assets/Data/"))
              output_filepath .= after_first( '/' )
              output_filepath .= after_first( '/' )
              output_filepath = "Assets/Data" / output_filepath
            endIf
            output_filepath = output_folder/output_filepath

            if (File(asset.filepath).is_different_than(File(output_filepath)))
              File( asset.filepath ).copy_to( File(output_filepath), &verbose )
            endIf
          endForEach
      endWhich

    method has_modified_assets->Logical
      if (assets.is_empty) return false
      if (is_modified) return true

      if ((forEach in assets).is_modified) return true

      which (assets.first.type)
        case <Image>, <Font>
          if (page_info.is_empty) return true
          if ((forEach in assets).placement_info.is_empty) return true

          localize newest_timestamp
          forEach (info in page_info)
            local filepath = info//build_filepath->String
            local file = File(filepath)
            if (not file.exists or file.timestamp < newest_timestamp) return true
          endForEach

        case <Sound>, <Music>
          forEach (asset in assets)
            if (File(asset.filepath).is_different_than(audio_output_file(asset)))
              return true
            endIf
          endForEach

        case <Binary>
          local output_folder = AssetCompiler.assets_folder.parent.filepath
          forEach (asset in assets)
            local output_filepath = output_folder/asset.filepath
            if (File(asset.filepath).is_different_than(File(output_filepath)))
              return true
            endIf
          endForEach
      endWhich

      return false

    method audio_output_file( asset:Asset )->File
      # Maps an audio asset's source filepath to its destination in the current
      # build's Assets/Audio folder.
      local output_filepath = asset.filepath
      if (not output_filepath.begins_with("Assets/Audio/"))
        output_filepath .= after_first( '/' )
        output_filepath .= after_first( '/' )
        output_filepath = "Assets/Audio" / output_filepath
      endIf
      return File( AssetCompiler.assets_folder.parent.filepath / output_filepath )

    method newest_timestamp->Timestamp
      local newest_timestamp = assets.first.timestamp
      newest_timestamp .= or_newer( (forEach in assets from 1).timestamp )
      return newest_timestamp

    method hash->Int
      local result = assets.count
      result ~= ((forEach in assets).filepath.hashcode)
      return result

    method set_id( @id )
      GroupIDManager.mark_id_used( id )

    method set_attributes( @attributes )
      if local attr = attributes.find( "atlas_padding" )
        atlas_padding = attr.value->Int
      endIf
      local dyn = AssetGroup.parse_dynamic_size_attribute( attributes )
      if (dyn) dynamic_size = dyn

    method to->String
      return assets->String

    method to->Variant
      local result = @{ id, hash, filename, attributes:{}, assets:[], pages:[] }

      if (attributes)
        local attribute_table = result//attributes
        forEach (attribute in attributes)
          attribute_table[attribute.name] = attribute_variant( attribute )
        endForEach
      endIf

      local asset_filepaths = result//assets
      forEach (asset in assets)
        asset_filepaths.add( asset.filepath )
      endForEach

      local page_info = result//pages
      if (pages)
        forEach (page in pages)
          page_info.add(
            @{
               asset_filepath:page.filepath,
               build_filepath:page.build_filepath,
               size:page.size,
               mipmaps:page.uses_mipmaps,
               wrap:page.uses_texture_wrap,
               dynamic_size:dynamic_size
             }
          )
        endForEach
      else
        page_info.add( forEach in this.page_info )
      endIf

      return result

    method attribute_variant( attribute:Attribute )->Variant
      # A valueless attribute (e.g. 'x1024' or 'mipmaps') is recorded as 'true'.
      if (attribute.value) return Variant( attribute.value.value )
      else                 return Variant( true )

    method .base26( n:Int, builder:String )
      if (n >= 26) .base26( n/26, builder )
      builder.print( ('A' + (n % 26))->Character )

endClass
