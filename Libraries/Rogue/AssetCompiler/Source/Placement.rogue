library AssetCompiler

uses Codec/CRC32

class Placement
  PROPERTIES
    build_folder   : String
    atlas_filepath : String
    position       : XY
    size           : XY
    padding_left   : Int
    padding_top    : Int
    padding_right  : Int
    padding_bottom : Int

    bitmap         : Bitmap
    asset          : Asset
    source_bounds  : Box

    crc32            : Int32?

  METHODS
    method init( asset, source_bounds )
      bitmap = Bitmap( asset.bitmap, source_bounds )

      size = source_bounds.size

    method has_equivalent_bitmap( other:Placement, packer:ImagePacker )->Logical
      if (size != other.size) return false
      local this_padding = which{ asset.image_padding || packer.atlas_padding }
      local other_padding = which{ other.asset.image_padding || packer.atlas_padding }
      if (this_padding != other_padding) return false

      if (not crc32)       crc32 = CRC32( bitmap.pixels.to_unsafe_bytes )->Int32
      if (not other.crc32) other.crc32 = CRC32( other.bitmap.pixels.to_unsafe_bytes )->Int32

      if (crc32 != other.crc32) return false
      return bitmap == other.bitmap

    method draw_to( page:Bitmap )
      local work_bitmap = bitmap
      if (padding_left or padding_right or padding_top or padding_bottom)
        work_bitmap = Bitmap( padding_left+size.x+padding_right, padding_top+size.y+padding_bottom, Color.YELLOW )
        bitmap.blit( work_bitmap, XY(padding_left,padding_top) )

        # Extrude edges into atlas_padding area
        if (padding_left)
          local left_edge = Box( padding_left, padding_top, 1, size.y )
          forEach (dx in 0..<padding_left)
            work_bitmap.blit( left_edge, work_bitmap, dx, padding_top )
          endForEach
        endIf

        if (padding_right)
          local x = padding_left + size.x
          local right_edge = Box( x-1, padding_top, 1, size.y )
          forEach (dx in 0..<padding_right)
            work_bitmap.blit( right_edge, work_bitmap, x+dx, padding_top )
          endForEach
        endIf

        if (padding_top)
          local top_edge = Box( 0, padding_top, padding_left+size.x+padding_right, 1 )
          forEach (dy in 0..<padding_top)
            work_bitmap.blit( top_edge, work_bitmap, 0, dy )
          endForEach
        endIf

        if (padding_bottom)
          local y = padding_top + size.y
          local bottom_edge = Box( 0, y-1, padding_left+size.x+padding_right, 1 )
          forEach (dy in 0..<padding_bottom)
            work_bitmap.blit( bottom_edge, work_bitmap, 0, y+dy )
          endForEach
        endIf

      endIf
      work_bitmap.blit( page, position-XY(padding_left,padding_top) )

    method to->String
      return source_bounds
      #return Box( position, size )

endClass
